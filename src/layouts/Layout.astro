---
// Layout.astro - Plantilla base con marcado semántico, accesible y metadatos SEO
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
}

const {
  title = "DECA Light · Coordinación documental de expediciones para almacenes hortofrutícolas",
  description = "DECA Light está en desarrollo para ayudar a almacenes y comercializadoras hortofrutícolas a coordinar la información de sus expediciones y simplificar tareas administrativas.",
  canonicalURL,
  image = "/og-image.svg"
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Metadatos Open Graph (Social Sharing) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="DECA Light" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DECA Light · Coordinación documental de expediciones" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Detección síncrona de JavaScript para mejora progresiva (No-JS fallback) -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <!-- Enlace accesible de salto para lectores de pantalla y navegación por teclado -->
    <a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>

    <!-- Cabecera y navegación -->
    <Header />

    <!-- Contenido principal -->
    <main id="contenido-principal">
      <slot />
    </main>

    <!-- Pie de página -->
    <Footer />

    <!-- Script ligero de revelado progresivo (No-JS safe, WCAG prefers-reduced-motion safe) -->
    <script is:inline>
      (function () {
        if (typeof window === 'undefined') return;
        var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          return;
        }

        // Activamos las transiciones de revelado únicamente cuando JS y el Observer están disponibles
        document.documentElement.classList.add('reveal-ready');

        function initReveal() {
          var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px'
          });

          var elements = document.querySelectorAll('[data-reveal]');
          elements.forEach(function (el) {
            observer.observe(el);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveal);
        } else {
          initReveal();
        }
      })();
    </script>
  </body>
</html>
