---
// FaqEditorial.astro — Columna editorial de Preguntas frecuentes
---

<aside class="faq-editorial-col" data-reveal="editorial">
  <div class="editorial-header">
    <div class="eyebrow-wrap">
      <span class="eyebrow-line" aria-hidden="true"></span>
      <span class="eyebrow-text">PREGUNTAS FRECUENTES</span>
    </div>

    <h2 id="faq-heading" class="faq-heading">
      Preguntas frecuentes.
    </h2>
  </div>
</aside>

<style>
  .faq-editorial-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 100%;
  }

  @media (min-width: 1024px) {
    .faq-editorial-col {
      position: sticky;
      top: 6.5rem;
    }
  }

  .editorial-header {
    display: flex;
    flex-direction: column;
  }

  .eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }

  .eyebrow-line {
    width: 1.5rem;
    height: 2px;
    background-color: var(--palette-deca-800);
    border-radius: 9999px;
  }

  .eyebrow-text {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--palette-deca-800);
  }

  .faq-heading {
    font-size: clamp(1.875rem, 3.2vw, 2.625rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-primary, var(--palette-slate-900));
    margin: 0;
  }
</style>
