---
// HowItWorksBeneficios.astro — Atajos de teclado bajo «Cómo funciona» (v3-premium)
---

<footer class="hiw-shortcuts" aria-label="Atajos de teclado">
  <p class="hiw-shortcuts-row">
    <span class="shortcut-pair">
      <kbd class="shortcut-kbd">G</kbd>
      <span class="shortcut-label">asignar camión</span>
    </span>
    <span class="shortcut-sep" aria-hidden="true">·</span>
    <span class="shortcut-pair">
      <kbd class="shortcut-kbd">E</kbd>
      <span class="shortcut-label">emitir</span>
    </span>
    <span class="shortcut-sep" aria-hidden="true">·</span>
    <span class="shortcut-note">Todo se puede hacer con el teclado</span>
  </p>
</footer>

<style>
  .hiw-shortcuts {
    margin-top: 56px;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .hiw-shortcuts-row {
    margin: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem 0.9rem;
    font-size: 15px;
    color: #475569;
  }

  .shortcut-pair {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .shortcut-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    color: #0F172A;
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-bottom-width: 3px;
    border-radius: 8px;
  }

  .shortcut-label {
    font-size: 15px;
    color: #475569;
  }

  .shortcut-note {
    font-size: 15px;
    color: #475569;
  }

  .shortcut-sep {
    color: #CBD5E1;
  }
</style>
