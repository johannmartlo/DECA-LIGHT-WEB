---
// ProblemBanner.astro — extraído de Problem.astro
---

<!-- ==============================================
     BANNER INFERIOR DE CONCLUSIÓN / QUOTE EDITORIAL
     ============================================== -->
<div class="statement-banner-wrap group" data-purpose="statement-quote-banner" data-reveal="card">
  <div class="statement-banner">
    <!-- Barra Verde Esmeralda con Barrido Lóbrego / Shimmer (Desktop Izquierda, Móvil Arriba) -->
    <div class="accent-glow-bar" aria-hidden="true"></div>

    <!-- Parte Izquierda: Cita Editorial Destacada -->
    <div class="quote-content">
      <span class="quote-symbol" aria-hidden="true">“</span>
      <p class="quote-phrase">
        ‘La información existe, pero llega en momentos diferentes y obliga a hacer más trabajo del necesario.’
      </p>
    </div>

    <!-- Separador Vertical Sutil (Desktop) -->
    <div class="quote-divider" aria-hidden="true"></div>

    <!-- Parte Derecha: Mensaje de Coordinación con Icono -->
    <div class="coord-proposal">
      <div class="coord-icon-box" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
      </div>
      <p class="coord-text">
        Una coordinación documental más clara para las expediciones hortofrutícolas.
      </p>
    </div>
  </div>
</div>

<style>
  .statement-banner-wrap {
      margin-top: 3rem;
      cursor: default;
      width: 100%;
      max-width: 100%;
    }
  @media (min-width: 1024px) {
    .statement-banner-wrap {
          margin-top: 3.5rem;
        }
  }
  .statement-banner {
      position: relative;
      background-color: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--palette-slate-200);
      border-radius: 1rem;
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
                  box-shadow 0.35s ease,
                  border-color 0.3s ease;
    }
  @media (min-width: 768px) {
    .statement-banner {
          flex-direction: row;
          align-items: stretch;
        }
  }
  .statement-banner:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 36px -6px rgba(15, 23, 42, 0.08);
      border-color: rgba(0, 104, 71, 0.25);
    }
  .accent-glow-bar {
      position: relative;
      width: 100%;
      height: 0.4rem;
      background-color: var(--palette-deca-700);
      flex-shrink: 0;
      overflow: hidden;
    }
  @media (min-width: 768px) {
    .accent-glow-bar {
          width: 0.5rem;
          height: auto;
        }
  }
  .accent-glow-bar::after {
      content: "";
      position: absolute;
      top: -100%;
      left: 0;
      width: 100%;
      height: 60%;
      background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.7), transparent);
      animation: barGlowSweep 3.2s infinite ease-in-out;
    }
  .quote-content {
      flex: 1;
      padding: 1.25rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
  @media (min-width: 640px) {
    .quote-content {
          padding: 1.5rem;
          gap: 1rem;
        }
  }
  @media (min-width: 1024px) {
    .quote-content {
          padding: 2rem 2.25rem;
        }
  }
  .quote-symbol {
      color: var(--palette-deca-700);
      font-size: 2.25rem;
      font-family: Georgia, Cambria, "Times New Roman", Times, serif;
      line-height: 1;
      user-select: none;
      align-self: flex-start;
      margin-top: 0.15rem;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  @media (min-width: 1024px) {
    .quote-symbol {
          font-size: 3.25rem;
        }
  }
  .statement-banner:hover .quote-symbol {
      transform: scale(1.15) rotate(-3deg);
    }
  .quote-phrase {
      margin: 0;
      color: var(--palette-slate-900);
      font-weight: 700;
      font-size: 0.9375rem;
      line-height: 1.45;
      letter-spacing: -0.015em;
      transition: color 0.25s ease;
      word-break: break-word;
    }
  @media (min-width: 640px) {
    .quote-phrase {
          font-size: 1.125rem;
        }
  }
  @media (min-width: 1024px) {
    .quote-phrase {
          font-size: 1.25rem;
        }
  }
  .statement-banner:hover .quote-phrase {
      color: #022c22;
    }
  .quote-divider {
      display: none;
      width: 1px;
      background-color: var(--palette-slate-200);
      align-self: stretch;
      margin-block: 1.25rem;
    }
  @media (min-width: 768px) {
    .quote-divider {
          display: block;
        }
  }
  .coord-proposal {
      width: 100%;
      background-color: rgba(248, 250, 252, 0.65);
      padding: 1.25rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      border-top: 1px solid var(--palette-slate-100);
      transition: background-color 0.3s ease;
    }
  @media (min-width: 640px) {
    .coord-proposal {
          padding: 1.5rem;
          gap: 1rem;
        }
  }
  @media (min-width: 768px) {
    .coord-proposal {
          width: 38%;
          border-top: none;
        }
  }
  @media (min-width: 1024px) {
    .coord-proposal {
          padding: 2rem;
        }
  }
  .statement-banner:hover .coord-proposal {
      background-color: rgba(236, 253, 245, 0.35);
    }
  .coord-icon-box {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.625rem;
      background-color: var(--palette-emerald-50);
      border: 1px solid var(--palette-emerald-100);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--palette-deca-700);
      flex-shrink: 0;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                  background-color 0.25s ease;
    }
  @media (min-width: 640px) {
    .coord-icon-box {
          width: 2.75rem;
          height: 2.75rem;
          border-radius: 0.75rem;
        }
  }
  .statement-banner:hover .coord-icon-box {
      transform: scale(1.1) rotate(4deg);
      background-color: var(--palette-emerald-100);
    }
  .coord-text {
      margin: 0;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--palette-slate-700);
      line-height: 1.45;
    }
  @media (min-width: 640px) {
    .coord-text {
          font-size: 0.875rem;
        }
  }
  @media (prefers-reduced-motion: reduce) {
    .eyebrow-line,
        .friction-card,
        .icon-circle,
        .albaran-card,
        .albaran-card::after,
        .pallet-container,
        .animated-connector-path,
        .floating-badge-pending,
        .badge-pending-pill,
        .skel-loader,
        .truck-container,
        .fan-sheet,
        .alert-exclamation-dot,
        .alert-box-card,
        .statement-banner,
        .accent-glow-bar::after,
        .quote-symbol,
        .coord-icon-box {
          animation: none !important;
          transition: none !important;
          transform: none !important;
        }
  }

  @keyframes barGlowSweep {
      0% { top: -60%; }
      50%, 100% { top: 160%; }
    }
</style>
