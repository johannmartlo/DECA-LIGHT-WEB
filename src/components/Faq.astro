---
// src/components/Faq.astro - Sección «Preguntas frecuentes» de DECA Light
import FaqEditorial from './FaqEditorial.astro';
import FaqAcordeon from './FaqAcordeon.astro';
---

<section id="preguntas" class="faq-section" aria-labelledby="faq-heading">
  <div id="faq" class="anchor-target" aria-hidden="true"></div>
  <div id="preguntas-frecuentes" class="anchor-target" aria-hidden="true"></div>

  <div class="container faq-container">
    <div class="faq-main-grid">
      <FaqEditorial />
      <FaqAcordeon />
    </div>
  </div>
</section>

<noscript>
  <style>
    .accordion-content {
      grid-template-rows: 1fr !important;
    }
    .accordion-inner {
      opacity: 1 !important;
      transform: none !important;
      overflow: visible !important;
    }
    .accordion-chevron {
      display: none !important;
    }
  </style>
</noscript>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordion = document.getElementById('faq-accordion');
    if (!accordion) return;

    const items = accordion.querySelectorAll<HTMLElement>('.accordion-item');

    items.forEach((item) => {
      const toggleBtn = item.querySelector<HTMLButtonElement>('.faq-toggle');
      if (!toggleBtn) return;

      toggleBtn.addEventListener('click', () => {
        const isOpen = item.getAttribute('data-open') === 'true';

        items.forEach((other) => {
          if (other !== item) {
            other.setAttribute('data-open', 'false');
            const otherBtn = other.querySelector<HTMLButtonElement>('.faq-toggle');
            if (otherBtn) {
              otherBtn.setAttribute('aria-expanded', 'false');
            }
          }
        });

        const nextState = !isOpen;
        item.setAttribute('data-open', nextState ? 'true' : 'false');
        toggleBtn.setAttribute('aria-expanded', nextState ? 'true' : 'false');
      });
    });
  });
</script>

<style>
  .faq-section {
    position: relative;
    width: 100%;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
    background-color: var(--palette-slate-50);
    border-bottom: 1px solid var(--color-border-subtle, var(--palette-slate-200));
    scroll-margin-top: 5rem;
  }

  @media (min-width: 1024px) {
    .faq-section {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }

  .anchor-target {
    position: absolute;
    top: -80px;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .faq-container {
    position: relative;
    z-index: 1;
  }

  .faq-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .faq-main-grid {
      grid-template-columns: 5fr 7fr;
      gap: 2.5rem;
    }
  }
</style>
