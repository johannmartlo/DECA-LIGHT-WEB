---
// src/components/Faq.astro - Sección «Preguntas frecuentes» de DECA Light (Tramo 6, v3-premium)
import FaqEditorial from './FaqEditorial.astro';
import FaqAcordeon from './FaqAcordeon.astro';
---

<section id="preguntas" aria-labelledby="faq-heading">
  <div id="faq" class="anchor-target" aria-hidden="true"></div>
  <div id="preguntas-frecuentes" class="anchor-target" aria-hidden="true"></div>

  <div class="w fq">
    <FaqEditorial />
    <FaqAcordeon />
  </div>
</section>

<style>
  #preguntas {
    position: relative;
    padding: 140px 24px;
    background: #FFFFFF;
    font-family: var(--font-sans);
    color: #0F172A;
  }

  .w {
    max-width: 1200px;
    margin: 0 auto;
  }

  .fq {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 96px;
    align-items: start;
  }

  .anchor-target {
    position: absolute;
    top: -80px;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    #preguntas {
      padding: 88px 16px;
    }

    .fq {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
