---
// src/components/Faq.astro - Sección «Preguntas frecuentes» de DECA Light
// Reconstrucción visual de alta fidelidad basada en Google Stitch y la referencia aprobada
---

<section id="faq" class="faq-section" aria-labelledby="faq-heading">
  <!-- Anclas de navegación compatibles -->
  <div id="preguntas-frecuentes" class="anchor-target" aria-hidden="true"></div>

  <!-- Trama sutil decorativa de fondo -->
  <div class="bg-pattern-dots" aria-hidden="true"></div>

  <div class="faq-container">
    <!-- Grid Principal: Columna Visual Izquierda + Acordeón Derecho -->
    <div class="faq-main-grid">
      <!-- ==============================================
           COLUMNA IZQUIERDA: EDITORIAL Y MOCKUP ESQUEMÁTICO
           ============================================== -->
      <aside class="faq-editorial-col" data-reveal="editorial">
        <!-- Encabezado Editorial -->
        <div class="editorial-header">
          <div class="eyebrow-wrap">
            <span class="eyebrow-line" aria-hidden="true"></span>
            <span class="eyebrow-text">PREGUNTAS FRECUENTES</span>
          </div>

          <h2 id="faq-heading" class="faq-heading">
            Resolvemos tus dudas<br />
            antes de dar el<br />
            siguiente paso.
          </h2>

          <p class="faq-description">
            Conoce qué propone DECA Light, para qué tipo de operativa está pensado y cómo valorar si encaja con tu empresa.
          </p>
        </div>

        <!-- Ilustración Esquemática Conceptual del Flujo Documental -->
        <div class="mockup-wrapper" aria-label="Esquema ilustrativo del flujo documental de expedición">
          <div class="mockup-container group-mockup">
            <!-- Barra Superior: Estado Ilustrativo y Chip Shimmer -->
            <div class="mockup-top-bar">
              <div class="beacon-wrap">
                <span class="beacon-indicator" aria-hidden="true">
                  <span class="beacon-ping"></span>
                  <span class="beacon-core"></span>
                </span>
                <span class="beacon-text">FLUJO DOCUMENTAL ACTIVO</span>
              </div>

              <span class="shimmer-badge">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shimmer-check" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Estructura preparada</span>
              </span>
            </div>

            <!-- Abanico Documental Superpuesto -->
            <div class="fanned-docs-stage" aria-hidden="true">
              <!-- Hoja Trasera Derecha: CMR Internacional -->
              <div class="doc-sheet sheet-cmr">
                <div class="sheet-header">
                  <span class="sheet-name">CMR Internacional</span>
                  <span class="sheet-code">e-CMR #441</span>
                </div>
                <div class="sheet-lines">
                  <div class="sheet-bar bar-85"></div>
                  <div class="sheet-bar bar-65"></div>
                  <div class="sheet-bar bar-75"></div>
                </div>
                <div class="sheet-footer">
                  <span>Tránsito Int.</span>
                  <span class="sheet-status-green">Validado</span>
                </div>
              </div>

              <!-- Hoja Intermedia Izquierda: Carta de Porte -->
              <div class="doc-sheet sheet-cp">
                <div class="sheet-header">
                  <span class="sheet-name">Carta de porte nacional</span>
                  <span class="sheet-code">CP-902</span>
                </div>
                <div class="sheet-lines">
                  <div class="sheet-bar bar-100"></div>
                  <div class="sheet-bar bar-80"></div>
                  <div class="sheet-bar bar-60"></div>
                </div>
                <div class="sheet-footer">
                  <span>Porteador asignado</span>
                  <span class="sheet-status-dark">OK</span>
                </div>
              </div>

              <!-- Hoja Frontal: Albarán Hortofrutícola -->
              <div class="doc-sheet sheet-albaran">
                <div class="sheet-header">
                  <span class="sheet-name-brand">Albarán EXP-2026-1047</span>
                  <span class="sheet-badge-horto">Hortofrutícola</span>
                </div>
                <div class="sheet-meta-rows">
                  <div class="meta-row">
                    <span>Origen:</span>
                    <span class="meta-val">Muelle Carga 02</span>
                  </div>
                  <div class="meta-row">
                    <span>Destino:</span>
                    <span class="meta-val-bold">Mercamadrid</span>
                  </div>
                  <div class="meta-row">
                    <span>Carga:</span>
                    <span class="meta-val-green">Tomate Rama • 120 cajas</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Ficha Central: Expedición Consolidada -->
            <div class="consolidated-card">
              <div class="consolidated-head">
                <span class="consolidated-label">Expedición consolidada:</span>
                <span class="consolidated-id">EXP-2026-1047</span>
              </div>

              <div class="consolidated-grid">
                <div class="info-block">
                  <span class="info-label">Origen &amp; Destino</span>
                  <p class="info-val">Muelle 02 → Mercamadrid</p>
                </div>
                <div class="info-block">
                  <span class="info-label">Desglose de carga</span>
                  <p class="info-val">Tomate Rama (120 caj.)</p>
                </div>
              </div>

              <div class="consolidated-foot">
                <div class="date-chip">
                  <span class="dot-green-tiny" aria-hidden="true"></span>
                  <span>Fecha: 15/10/2026</span>
                </div>
                <span class="tag-linked">
                  ✓ Documentación vinculada
                </span>
              </div>
            </div>

            <!-- Chip Inferior de Valor Unificado -->
            <div class="unification-banner">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="banner-icon-green" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>Coordinación y visualización unificada de la documentación de expedición</span>
            </div>
          </div>
        </div>
      </aside>

      <!-- ==============================================
           COLUMNA DERECHA: ACORDEÓN CON LAS 8 PREGUNTAS
           ============================================== -->
      <div class="faq-accordion-col" role="region" aria-label="Lista de preguntas frecuentes">
        <div class="accordion-list" id="faq-accordion" data-reveal="card">
          <!-- --------------------------------------------
               PREGUNTA 01 (Abierta por defecto)
               -------------------------------------------- -->
          <article class="accordion-item" data-open="true">
            <div class="accordion-accent-bar" aria-hidden="true"></div>
            <h3>
              <button
                type="button"
                id="faq-btn-1"
                class="faq-toggle"
                aria-expanded="true"
                aria-controls="faq-ans-1"
              >
                <div class="toggle-left">
                  <span class="faq-num">01</span>
                  <span class="faq-title">¿Qué es DECA Light?</span>
                </div>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="accordion-chevron" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </h3>
            <div
              id="faq-ans-1"
              class="accordion-content"
              role="region"
              aria-labelledby="faq-btn-1"
            >
              <div class="accordion-inner">
                <div class="answer-body">
                  DECA Light es una solución digital orientada a facilitar la coordinación de la documentación de transporte y la información asociada a las expediciones en empresas hortofrutícolas.
                </div>
              </div>
            </div>
          </article>

          <!-- --------------------------------------------
               PREGUNTA 02
               -------------------------------------------- -->
          <article class="accordion-item" data-open="false">
            <div class="accordion-accent-bar" aria-hidden="true"></div>
            <h3>
              <button
                type="button"
                id="faq-btn-2"
                class="faq-toggle"
                aria-expanded="false"
                aria-controls="faq-ans-2"
              >
                <div class="toggle-left">
                  <span class="faq-num">02</span>
                  <span class="faq-title">¿Qué problema busca resolver?</span>
                </div>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="accordion-chevron" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </h3>
            <div
              id="faq-ans-2"
              class="accordion-content"
              role="region"
              aria-labelledby="faq-btn-2"
            >
              <div class="accordion-inner">
                <div class="answer-body">
                  Busca ayudar a organizar la información documental de las expediciones y reducir la fricción derivada de gestionar datos y documentos procedentes de distintas fuentes y personas.
                </div>
              </div>
            </div>
          </article>

          <!-- --------------------------------------------
               PREGUNTA 03
               -------------------------------------------- -->
          <article class="accordion-item" data-open="false">
            <div class="accordion-accent-bar" aria-hidden="true"></div>
            <h3>
              <button
                type="button"
                id="faq-btn-3"
                class="faq-toggle"
                aria-expanded="false"
                aria-controls="faq-ans-3"
              >
                <div class="toggle-left">
                  <span class="faq-num">03</span>
                  <span class="faq-title">¿Para qué tipo de empresas está pensado?</span>
                </div>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="accordion-chevron" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </h3>
            <div
              id="faq-ans-3"
              class="accordion-content"
              role="region"
              aria-labelledby="faq-btn-3"
            >
              <div class="accordion-inner">
                <div class="answer-body">
                  Está orientado principalmente a almacenes y comercializadoras hortofrutícolas que coordinan expediciones de forma habitual y necesitan organizar la información relacionada con sus documentos de transporte.
                </div>
              </div>
            </div>
          </article>

          <!-- --------------------------------------------
               PREGUNTA 04
               -------------------------------------------- -->
          <article class="accordion-item" data-open="false">
            <div class="accordion-accent-bar" aria-hidden="true"></div>
            <h3>
              <button
                type="button"
                id="faq-btn-4"
                class="faq-toggle"
                aria-expanded="false"
                aria-controls="faq-ans-4"
              >
                <div class="toggle-left">
                  <span class="faq-num">04</span>
                  <span class="faq-title">¿Qué documentación contempla?</span>
                </div>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="accordion-chevron" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </h3>
            <div
              id="faq-ans-4"
              class="accordion-content"
              role="region"
              aria-labelledby="faq-btn-4"
            >
              <div class="accordion-inner">
                <div class="answer-body">
                  DECA Light trabaja con el informe de expediciones de tu ERP y con las cartas de porte en PDF, y prepara el documento de control (DeCA) de cada expedición, con su PDF y su código QR. Si quieres saber qué exige la norma, consulta nuestra <a href="/guia-deca">guía del DeCA</a>.
                </div>
              </div>
            </div>
          </article>

          <!-- --------------------------------------------
               PREGUNTA 05
               -------------------------------------------- -->
          <article class="accordion-item" data-open="false">
            <div class="accordion-accent-bar" aria-hidden="true"></div>
            <h3>
              <button
                type="button"
                id="faq-btn-5"
                class="faq-toggle"
                aria-expanded="false"
                aria-controls="faq-ans-5"
              >
                <div class="toggle-left">
                  <span class="faq-num">05</span>
                  <span class="faq-title">¿DECA Light sustituye a nuestro ERP?</span>
                </div>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="accordion-chevron" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </h3>
            <div
              id="faq-ans-5"
              class="accordion-content"
              role="region"
              aria-labelledby="faq-btn-5"
            >
              <div class="accordion-inner">
                <div class="answer-body">
                  DECA Light está concebido como una herramienta de apoyo a la coordinación documental, no como un sustituto general del ERP. El encaje con los sistemas y procesos existentes debe estudiarse para cada caso.
                </div>
              </div>
            </div>
          </article>

          <!-- --------------------------------------------
               PREGUNTA 06
               -------------------------------------------- -->
          <article class="accordion-item" data-open="false">
            <div class="accordion-accent-bar" aria-hidden="true"></div>
            <h3>
              <button
                type="button"
                id="faq-btn-6"
                class="faq-toggle"
                aria-expanded="false"
                aria-controls="faq-ans-6"
              >
                <div class="toggle-left">
                  <span class="faq-num">06</span>
                  <span class="faq-title">¿Cómo podemos saber si encaja con nuestra operativa?</span>
                </div>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="accordion-chevron" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </h3>
            <div
              id="faq-ans-6"
              class="accordion-content"
              role="region"
              aria-labelledby="faq-btn-6"
            >
              <div class="accordion-inner">
                <div class="answer-body">
                  El primer paso es conocer cómo gestionáis actualmente las expediciones, qué información utilizáis y dónde aparecen las principales dificultades. A partir de ahí te enseñamos en una demostración cómo encaja DECA Light con vuestra forma de trabajar.
                </div>
              </div>
            </div>
          </article>

          <!-- --------------------------------------------
               PREGUNTA 07
               -------------------------------------------- -->
          <article class="accordion-item" data-open="false">
            <div class="accordion-accent-bar" aria-hidden="true"></div>
            <h3>
              <button
                type="button"
                id="faq-btn-7"
                class="faq-toggle"
                aria-expanded="false"
                aria-controls="faq-ans-7"
              >
                <div class="toggle-left">
                  <span class="faq-num">07</span>
                  <span class="faq-title">¿Es necesario cambiar nuestro proceso de trabajo?</span>
                </div>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="accordion-chevron" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </h3>
            <div
              id="faq-ans-7"
              class="accordion-content"
              role="region"
              aria-labelledby="faq-btn-7"
            >
              <div class="accordion-inner">
                <div class="answer-body">
                  No. DECA Light se adapta a vuestra operativa: importa la información que ya tenéis y solo os pide lo que falta, normalmente la matrícula del camión. Hoy importa el informe de Hispatec; para otros ERP, consúltanos.
                </div>
              </div>
            </div>
          </article>

          <!-- --------------------------------------------
               PREGUNTA 08
               -------------------------------------------- -->
          <article class="accordion-item" data-open="false">
            <div class="accordion-accent-bar" aria-hidden="true"></div>
            <h3>
              <button
                type="button"
                id="faq-btn-8"
                class="faq-toggle"
                aria-expanded="false"
                aria-controls="faq-ans-8"
              >
                <div class="toggle-left">
                  <span class="faq-num">08</span>
                  <span class="faq-title">¿Cómo puedo ver DECA Light funcionando?</span>
                </div>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="accordion-chevron" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </h3>
            <div
              id="faq-ans-8"
              class="accordion-content"
              role="region"
              aria-labelledby="faq-btn-8"
            >
              <div class="accordion-inner">
                <div class="answer-body">
                  Solicita una demostración desde el formulario o escríbenos a contacto@decalight.es. Te enseñamos DECA Light con un caso como el tuyo y, si encaja, te acompañamos en la puesta en marcha.
                </div>
              </div>
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Fallback No-JS accesible: garantiza la lectura completa si JavaScript está deshabilitado -->
<noscript>
  <style>
    .accordion-content {
      grid-template-rows: 1fr !important;
    }
    .accordion-inner {
      opacity: 1 !important;
      transform: none !important;
      overflow: visible !important;
    }
    .accordion-chevron {
      display: none !important;
    }
  </style>
</noscript>

<!-- ==============================================
     INTERACCIÓN DEL ACORDEÓN ACCESIBLE
     ============================================== -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordion = document.getElementById('faq-accordion');
    if (!accordion) return;

    const items = accordion.querySelectorAll<HTMLElement>('.accordion-item');

    items.forEach((item) => {
      const toggleBtn = item.querySelector<HTMLButtonElement>('.faq-toggle');
      if (!toggleBtn) return;

      toggleBtn.addEventListener('click', () => {
        const isOpen = item.getAttribute('data-open') === 'true';

        // Cerrar todos los acordeones para mantener orden visual limpio
        items.forEach((other) => {
          if (other !== item) {
            other.setAttribute('data-open', 'false');
            const otherBtn = other.querySelector<HTMLButtonElement>('.faq-toggle');
            if (otherBtn) {
              otherBtn.setAttribute('aria-expanded', 'false');
            }
          }
        });

        // Alternar el acordeón pulsado
        const nextState = !isOpen;
        item.setAttribute('data-open', nextState ? 'true' : 'false');
        toggleBtn.setAttribute('aria-expanded', nextState ? 'true' : 'false');
      });
    });
  });
</script>

<style>
  /* ==========================================================================
     SECCIÓN 05: PREGUNTAS FRECUENTES (FAQ) - ESTILOS ENCAPSULADOS
     ========================================================================== */

  .faq-section {
    position: relative;
    width: 100%;
    max-width: 100vw;
    padding: 3.5rem 1.5rem 5rem;
    background-color: var(--palette-slate-50);
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .faq-section {
      padding: 3rem 1rem 4rem;
    }
  }

  .anchor-target {
    position: absolute;
    top: -80px;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* Trama geométrica sutil de puntos de fondo */
  .bg-pattern-dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: radial-gradient(var(--palette-deca-800) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.035;
  }

  .faq-container {
    position: relative;
    z-index: 1;
    max-width: 80rem; /* 1280px */
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  /* --------------------------------------------------------------------------
     ANIMACIONES DE ENTRADA ESCALONADA
     -------------------------------------------------------------------------- */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-stagger-1 {
    animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
  }
  .animate-stagger-2 {
    animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
  }
  .animate-stagger-3 {
    animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.28s both;
  }

  /* --------------------------------------------------------------------------
     GRID PRINCIPAL (5 COLS IZQ / 7 COLS DER)
     -------------------------------------------------------------------------- */
  .faq-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .faq-main-grid {
      grid-template-columns: 5fr 7fr;
      gap: 3.5rem;
    }
  }

  /* --------------------------------------------------------------------------
     COLUMNA IZQUIERDA: EDITORIAL
     -------------------------------------------------------------------------- */
  .faq-editorial-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 100%;
  }

  .editorial-header {
    display: flex;
    flex-direction: column;
  }

  .eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }

  .eyebrow-line {
    width: 1.5rem;
    height: 2px;
    background-color: var(--palette-deca-800);
    border-radius: 9999px;
  }

  .eyebrow-text {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--palette-deca-800);
  }

  .faq-heading {
    font-size: 2.125rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--palette-slate-900);
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .faq-heading {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .faq-heading {
      font-size: 2.625rem;
    }
  }

  .faq-description {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--palette-slate-600);
    max-width: 28rem;
  }

  /* --------------------------------------------------------------------------
     MOCKUP ESQUEMÁTICO ILUSTRATIVO
     -------------------------------------------------------------------------- */
  .mockup-wrapper {
    width: 100%;
    max-width: 29rem;
    padding-top: 0.5rem;
  }

  .mockup-container {
    position: relative;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 250, 252, 0.85) 100%);
    border: 1px solid var(--palette-slate-200);
    border-radius: 1.25rem;
    padding: 1.25rem;
    box-shadow: 0 10px 25px -3px rgba(15, 23, 42, 0.05), 0 4px 6px -4px rgba(15, 23, 42, 0.03);
    backdrop-filter: blur(8px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .mockup-container {
      padding: 1rem;
    }
  }

  .mockup-container:hover {
    border-color: var(--palette-emerald-200);
    box-shadow: 0 20px 35px -5px rgba(8, 84, 62, 0.08), 0 8px 16px -6px rgba(15, 23, 42, 0.04);
  }

  /* Barra Superior */
  .mockup-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
