---
// src/components/BenefitsStrip.astro - Bloque de cuatro beneficios de DECA Light
// Adaptación del diseño de Stitch en tarjetas con sombra sutil y elevación suave
---

<section class="benefits-strip-section" aria-label="Beneficios operativos clave de DECA Light">
  <div class="container benefits-container">
    <div class="benefits-grid" role="list">
      <!-- Beneficio 1: Organización documental -->
      <article class="benefit-card group" role="listitem" data-reveal="card" data-reveal-delay="1">
        <div class="benefit-icon-container" aria-hidden="true">
          <svg class="benefit-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <h3 class="benefit-title">Organización documental</h3>
        <p class="benefit-desc">
          Información documental de las expediciones organizada para facilitar su revisión.
        </p>
      </article>

      <!-- Beneficio 2: Almacén y transporte -->
      <article class="benefit-card group" role="listitem" data-reveal="card" data-reveal-delay="2">
        <div class="benefit-icon-container" aria-hidden="true">
          <svg class="benefit-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="14" height="13" rx="1"></rect>
            <polygon points="15 8 19 8 22 11 22 16 15 16 15 8"></polygon>
            <circle cx="5" cy="19" r="2.5"></circle>
            <circle cx="18" cy="19" r="2.5"></circle>
            <line x1="1" y1="9" x2="15" y2="9"></line>
          </svg>
        </div>
        <h3 class="benefit-title">Almacén y transporte</h3>
        <p class="benefit-desc">
          Coordinación de la información procedente de distintas personas y fuentes.
        </p>
      </article>

      <!-- Beneficio 3: Mayor control operativo -->
      <article class="benefit-card group" role="listitem" data-reveal="card" data-reveal-delay="3">
        <div class="benefit-icon-container" aria-hidden="true">
          <svg class="benefit-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 6v6h4.5"></path>
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M9 11l3 3L22 4" stroke-width="2"></path>
          </svg>
        </div>
        <h3 class="benefit-title">Mayor control operativo</h3>
        <p class="benefit-desc">
          Visibilidad de los datos pendientes de completar, siempre que esta capacidad esté disponible en la versión real.
        </p>
      </article>

      <!-- Beneficio 4: Preparada para su revisión -->
      <article class="benefit-card group" role="listitem" data-reveal="card" data-reveal-delay="4">
        <div class="benefit-icon-container" aria-hidden="true">
          <svg class="benefit-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <polyline points="9 12 11 14 15 10"></polyline>
          </svg>
        </div>
        <h3 class="benefit-title">Preparada para su revisión</h3>
        <p class="benefit-desc">
          Información documental organizada para facilitar la comprobación antes de continuar con la expedición.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .benefits-strip-section {
    position: relative;
    width: 100%;
    background-color: #FFFFFF;
    border-top: 1px solid var(--color-border-subtle, #E2E8F0);
    border-bottom: 1px solid var(--color-border-subtle, #E2E8F0);
    padding-top: clamp(3rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 5vw, 4rem);
  }

  .benefits-container {
    max-width: var(--container-max, 1340px);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  /* Tableta (768px a 1023px) */
  @media (min-width: 768px) and (max-width: 1023px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  /* Escritorio (>=1024px) */
  @media (min-width: 1024px) {
    .benefits-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  /* Tarjeta de beneficio */
  .benefit-card {
    background-color: #FFFFFF;
    border-radius: 1rem;
    padding: 1.5rem;
    border: 1px solid rgba(226, 232, 240, 0.85);
    box-shadow: 0 4px 20px -2px rgba(11, 37, 28, 0.04);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .benefit-card:hover {
      transform: translateY(-4px);
      border-color: rgba(16, 185, 129, 0.35);
      box-shadow: 0 16px 28px -6px rgba(0, 59, 42, 0.08), 0 4px 10px -2px rgba(0, 59, 42, 0.03);
    }

    .benefit-card:hover .benefit-icon-container {
      transform: scale(1.06);
      background-color: #D1FAE5;
      border-color: rgba(16, 185, 129, 0.4);
    }
  }

  /* Contenedor del icono */
  .benefit-icon-container {
    width: 48px;
    height: 48px;
    border-radius: 0.875rem;
    background-color: #ECFDF5;
    border: 1px solid rgba(16, 185, 129, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #08543E;
    margin-bottom: 1.25rem;
    transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
  }

  .benefit-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: #0F172A;
    line-height: 1.35;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .benefit-desc {
    font-size: 0.875rem;
    color: #475569;
    line-height: 1.55;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .benefit-card,
    .benefit-icon-container {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
