---
// FaqAcordeon.astro — Acordeón con las 12 preguntas frecuentes
const faqs = [
  {
    q: '¿Tengo que cambiar de ERP?',
    a: 'No. DECA Light trabaja con el informe de expediciones que ya sacas de tu ERP, o con tus cartas de porte.'
  },
  {
    q: '¿Y si mi ERP saca un informe distinto?',
    a: 'En la puesta en marcha lo dejamos funcionando con el informe de tu ERP.'
  },
  {
    q: '¿Qué recibe el conductor?',
    a: 'Su DeCA en PDF con un QR. Lo abre en el móvil, con el enlace que le pasa su empresa o leyendo el QR, sin registrarse.'
  },
  {
    q: '¿Se puede emitir un DeCA sin matrícula?',
    a: 'No. La carga se queda en «Falta matrícula» hasta que la pones.'
  },
  {
    q: 'Si cambia el camión después de emitir, ¿hay que hacer otro DeCA?',
    a: 'No. Se modifica el mismo con el motivo, y el QR que ya tiene el conductor sigue sirviendo. Solo hace falta uno nuevo si cambia la empresa transportista.'
  },
  {
    q: '¿Y si el mismo transportista manda un camión por la mañana y otro por la tarde?',
    a: 'Las cargas de la tarde llegan como pendientes y reciben su propia matrícula, sin tocar las de la mañana.'
  },
  {
    q: '¿Qué pasa si importo el mismo informe dos veces?',
    a: 'No se duplica nada. Una matrícula ya puesta no se pisa y un DeCA emitido no cambia.'
  },
  {
    q: '¿Quién de mi empresa puede usarlo?',
    a: 'Quien invites. Cada persona entra con su usuario y todo lo que hace queda registrado con su nombre.'
  },
  {
    q: '¿Dónde están mis datos?',
    a: 'En servidores de la Unión Europea, con copias de seguridad cifradas diarias. Cada empresa ve solo lo suyo.'
  },
  {
    q: '¿Hay que instalar algo?',
    a: 'No. Funciona en el navegador.'
  },
  {
    q: '¿Cuánto cuesta?',
    a: 'Depende de tu volumen de cargas. Te lo damos en la demostración. El primer mes es gratis.'
  },
  {
    q: '¿Qué pasa al terminar el mes gratis?',
    a: 'Decides tú. Si no sigues, no pagas nada.'
  }
];
---

<div class="faq-accordion-col" role="region" aria-label="Lista de preguntas frecuentes">
  <div class="accordion-list" id="faq-accordion" data-reveal="card">
    {faqs.map((item, idx) => {
      const num = String(idx + 1).padStart(2, '0');
      const isFirst = idx === 0;
      const btnId = `faq-btn-${idx + 1}`;
      const ansId = `faq-ans-${idx + 1}`;
      return (
        <article class="accordion-item" data-open={isFirst ? 'true' : 'false'}>
          <div class="accordion-accent-bar" aria-hidden="true"></div>
          <h3>
            <button
              type="button"
              id={btnId}
              class="faq-toggle"
              aria-expanded={isFirst ? 'true' : 'false'}
              aria-controls={ansId}
            >
              <span class="toggle-left">
                <span class="faq-num">{num}</span>
                <span class="faq-title">{item.q}</span>
              </span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="accordion-chevron" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
          </h3>
          <div
            id={ansId}
            class="accordion-content"
            role="region"
            aria-labelledby={btnId}
          >
            <div class="accordion-inner">
              <div class="answer-body">{item.a}</div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</div>

<style>
  .faq-accordion-col {
    width: 100%;
    max-width: 100%;
  }

  .accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .accordion-item {
    position: relative;
    background-color: var(--palette-white);
    border: 1px solid var(--palette-slate-200);
    border-radius: 0.875rem;
    overflow: hidden;
    transition: border-color 0.24s var(--ease-out), box-shadow 0.24s var(--ease-out);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
  }

  .accordion-item:hover {
    border-color: var(--palette-slate-300);
  }

  .accordion-accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background-color: var(--palette-deca-800);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .accordion-item[data-open="true"] {
    background-color: #FAFFFC;
    border-color: var(--palette-emerald-200);
    box-shadow: 0 4px 20px -2px rgba(8, 84, 62, 0.06);
  }

  .accordion-item[data-open="true"] .accordion-accent-bar {
    opacity: 1;
  }

  .faq-toggle {
    width: 100%;
    min-height: 52px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    gap: 1rem;
    font-family: inherit;
  }

  .faq-toggle:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--color-focus-ring);
  }

  .toggle-left {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .faq-num {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--palette-slate-600);
    background-color: var(--palette-slate-100);
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .accordion-item[data-open="true"] .faq-num {
    color: var(--palette-deca-800);
    background-color: var(--palette-deca-50);
  }

  .faq-title {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--palette-slate-900);
  }

  @media (min-width: 640px) {
    .faq-title {
      font-size: 1rem;
    }
  }

  .accordion-chevron {
    color: var(--palette-slate-500);
    flex-shrink: 0;
    transition: transform 0.3s var(--ease-out), color 0.2s ease;
  }

  .accordion-item[data-open="true"] .accordion-chevron {
    transform: rotate(180deg);
    color: var(--palette-deca-800);
  }

  .accordion-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms var(--ease-out);
  }

  .accordion-item[data-open="true"] .accordion-content {
    grid-template-rows: 1fr;
  }

  .accordion-inner {
    overflow: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 240ms var(--ease-out), transform 240ms var(--ease-out);
  }

  .accordion-item[data-open="true"] .accordion-inner {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 60ms;
  }

  :global(html:not(.js)) .accordion-content {
    grid-template-rows: 1fr !important;
  }

  :global(html:not(.js)) .accordion-inner {
    opacity: 1 !important;
    transform: none !important;
    overflow: visible !important;
  }

  :global(html:not(.js)) .accordion-chevron {
    display: none !important;
  }

  .answer-body {
    padding: 0.5rem 1.25rem 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--palette-slate-700);
    border-top: 1px solid rgba(241, 245, 249, 0.9);
  }

  @media (min-width: 640px) {
    .answer-body {
      padding-left: 4.125rem;
      padding-right: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-item,
    .accordion-content,
    .accordion-inner,
    .accordion-chevron {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
