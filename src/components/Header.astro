---
// Header.astro - Barra de navegación accesible para DECA Light (v3-premium)
---

<header class="site-header">
  <div class="container header-container">
    <div class="brand-group">
      <a href="/" class="brand-link" aria-label="DECA Light - Inicio">
        <img
          src="/deca-light-logo-claro.svg"
          alt="DECA Light"
          class="brand-logo"
          width="150"
          height="32"
        />
      </a>
    </div>

    <!-- Navegación principal (enlaces centrados en escritorio, desplegable en móvil) -->
    <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        <li><a href="/#como-funciona" class="nav-link">Cómo funciona</a></li>
        <li><a href="/#que-incluye" class="nav-link">Qué incluye</a></li>
        <li><a href="/#normativa" class="nav-link">Normativa</a></li>
        <li><a href="/#precios" class="nav-link">Precios</a></li>
        <li><a href="/#preguntas" class="nav-link">Preguntas</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/#demo" class="btn-header-cta">
        <span>Empezar el mes gratis</span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </a>

      <!-- Botón hamburguesa accesible en móvil -->
      <button
        type="button"
        id="menu-toggle"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="main-nav"
        aria-label="Abrir menú de navegación"
      >
        <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 72px;
    background-color: rgba(255, 255, 255, 0.72);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.7);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 0.75rem;
  }

  .brand-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    height: 30px;
    width: auto;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .btn-header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    height: 40px;
    padding-inline: 0.95rem;
    border-radius: 999px;
    background-color: #0F172A;
    color: #FFFFFF;
    font-size: 0.84375rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-header-cta:hover {
    background-color: #1E293B;
    text-decoration: none;
  }

  .cta-arrow {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-header-cta:hover .cta-arrow {
    transform: translateX(2px);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid #E2E8F0;
    border-radius: 999px;
    color: #0F172A;
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-toggle .icon-close {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .icon-menu {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  .main-nav {
    display: none;
  }

  .main-nav.is-open {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.9);
    padding: 1.25rem 1.25rem;
    box-shadow: 0 18px 40px -16px rgba(15, 23, 42, 0.14);
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    gap: 0.25rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.875rem;
    font-size: 0.9375rem; /* 15px */
    font-weight: 500;
    color: #475569;
    border-radius: 8px;
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover {
    color: #0F172A;
    background-color: rgba(241, 245, 249, 0.8);
    text-decoration: none;
  }

  @media (max-width: 440px) {
    .brand-logo {
      height: 25px;
    }

    .btn-header-cta {
      height: 38px;
      padding-inline: 0.7rem;
      font-size: 0.75rem;
    }

    .menu-toggle {
      width: 38px;
      height: 38px;
    }
  }

  /* Escritorio */
  @media (min-width: 900px) {
    .header-container {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .brand-group {
      justify-self: start;
    }

    .brand-logo {
      height: 32px;
    }

    .menu-toggle {
      display: none;
    }

    .main-nav {
      display: flex;
      align-items: center;
      justify-self: center;
      position: static;
      background: transparent;
      padding: 0;
      box-shadow: none;
      border-bottom: none;
    }

    .nav-list {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
    }

    .header-actions {
      justify-self: end;
    }

    .btn-header-cta {
      height: 46px;
      padding-inline: 1.35rem;
      font-size: 0.9375rem;
      gap: 0.45rem;
    }
  }
</style>

<script>
  // Control interactivo accesible del menú móvil (sin frameworks)
  const toggleBtn = document.getElementById('menu-toggle');
  const mainNav = document.getElementById('main-nav');

  if (toggleBtn && mainNav) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      toggleBtn.setAttribute('aria-label', isExpanded ? 'Abrir menú de navegación' : 'Cerrar menú de navegación');
      mainNav.classList.toggle('is-open');
    });

    // Cerrar al pulsar un enlace en móvil
    mainNav.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
        mainNav.classList.remove('is-open');
      });
    });

    // Cerrar con tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mainNav.classList.contains('is-open')) {
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
        mainNav.classList.remove('is-open');
        toggleBtn.focus();
      }
    });
  }
</script>
