---
// src/components/Hero.astro - Portada comercial con imagen de producto y modal de vídeo accesible
import HeroContenido from './HeroContenido.astro';
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="container hero-container">
    <HeroContenido />

    <div class="hero-media">
      <img
        src="/img/portada.webp"
        alt="Pantalla Día de DECA Light con cargas agrupadas por transportista y asignación de matrícula"
        width="2360"
        height="1600"
        fetchpriority="high"
        decoding="async"
        class="hero-image"
      />
    </div>
  </div>

  <!-- Modal accesible con el vídeo de demostración -->
  <dialog
    id="hero-video-modal"
    class="video-modal"
    aria-labelledby="video-modal-title"
  >
    <div class="video-modal-box">
      <div class="video-modal-header">
        <h2 id="video-modal-title" class="video-modal-title">Cómo funciona DECA Light</h2>
        <button
          type="button"
          id="close-video-modal"
          class="video-modal-close"
          aria-label="Cerrar vídeo"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="video-modal-body">
        <video
          id="hero-modal-video"
          class="modal-video-player"
          controls
          muted
          loop
          playsinline
          preload="none"
          poster="/video/demo-poster.jpg"
        >
          <source src="/video/demo.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </dialog>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.getElementById('open-video-modal') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('close-video-modal') as HTMLButtonElement | null;
    const modal = document.getElementById('hero-video-modal') as HTMLDialogElement | null;
    const video = document.getElementById('hero-modal-video') as HTMLVideoElement | null;

    if (!openBtn || !modal) return;

    const closeModal = () => {
      if (video && typeof video.pause === 'function') {
        video.pause();
      }
      if (modal.open) {
        modal.close();
      }
      openBtn.focus();
    };

    openBtn.addEventListener('click', () => {
      if (typeof modal.showModal === 'function') {
        modal.showModal();
      } else {
        modal.setAttribute('open', '');
      }
      closeBtn?.focus();
      const prefersReduced =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (video && !prefersReduced) {
        video.play().catch(() => {});
      }
    });

    closeBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    modal.addEventListener('close', () => {
      if (video && typeof video.pause === 'function') {
        video.pause();
      }
      openBtn.focus();
    });
  });
</script>

<style>
  .hero-section {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 5rem;
    background-color: var(--palette-white);
    background-image:
      radial-gradient(ellipse 680px 520px at 78% 46%, rgba(209, 250, 229, 0.38) 0%, rgba(240, 253, 244, 0.18) 55%, transparent 80%);
    border-bottom: 1px solid var(--color-border-subtle, var(--palette-slate-200));
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1.08fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-media {
    width: 100%;
    max-width: 600px;
    margin-left: auto;
  }

  .hero-image {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .hero-section {
      padding-top: 3.5rem;
      padding-bottom: 3.5rem;
    }

    .hero-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-media {
      margin: 0;
      width: 100%;
      max-width: 100%;
    }
  }

  /* Modal de vídeo */
  .video-modal {
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-border-subtle, var(--palette-slate-200));
    border-radius: 16px;
    background-color: var(--palette-white);
    color: var(--color-text-primary, var(--palette-slate-900));
    width: min(92vw, 920px);
    max-width: 920px;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.35);
  }

  .video-modal::backdrop {
    background-color: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(4px);
  }

  .video-modal-box {
    display: flex;
    flex-direction: column;
  }

  .video-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle, var(--palette-slate-200));
  }

  .video-modal-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
  }

  .video-modal-close {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md, 6px);
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text-secondary, var(--palette-slate-600));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .video-modal-close:hover {
    background-color: var(--color-bg-surface-subtle, var(--palette-slate-100));
    color: var(--color-text-primary, var(--palette-slate-900));
  }

  .video-modal-body {
    padding: 1rem;
    background-color: var(--palette-slate-900);
  }

  .modal-video-player {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
  }
</style>
