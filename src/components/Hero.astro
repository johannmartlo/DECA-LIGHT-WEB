---
// Hero.astro - Hero V2 «Flujo Convergente».
// Dos fuentes de información (almacén y transporte) convergen en DECA Light
// (capa de coordinación documental) y desembocan en documentación preparada para revisión.
// Dos SVG propios: composición convergente para >=640px y flujo vertical para móvil.
// Ambos son decorativos (aria-hidden); el contenido esencial se ofrece una sola vez en la lista accesible.
---

<section class="hero-section" aria-labelledby="hero-title">
  <!--
    Puerta de mejora progresiva para la entrada del Hero.
    Se ejecuta de forma síncrona antes de que se analice el contenido del Hero, por lo que no hay parpadeo.
    Sin JavaScript, sin soporte de animaciones CSS o con movimiento reducido, la clase no se añade
    y todo el contenido se muestra visible desde el primer render.
  -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var motionOk = window.matchMedia && window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
      var cssOk = window.CSS && CSS.supports && CSS.supports('animation-name', 'hero-enter');
      if (!motionOk || !cssOk) return;
      root.classList.add('hero-motion');
      // Red de seguridad: al retirar la clase el contenido vuelve a su estado visible por defecto,
      // idéntico al estado final de la animación, por lo que no produce saltos.
      window.setTimeout(function () { root.classList.remove('hero-motion'); }, 1500);
    })();
  </script>
  <div class="container hero-container">
    <div class="hero-content">
      <p class="section-kicker hero-reveal">Coordinación documental de expediciones</p>

      <h1 id="hero-title" class="hero-title hero-reveal">
        Coordina la documentación de tus expediciones sin esperas innecesarias.
      </h1>

      <p class="hero-description hero-reveal hero-reveal--step-1">
        DECA Light se está desarrollando para ayudar a los almacenes hortofrutícolas a organizar la documentación de las cargas y los datos del transporte, incluso cuando la información llega en momentos diferentes.
      </p>

      <div class="hero-actions hero-reveal hero-reveal--step-2">
        <a href="#piloto" class="btn btn-primary hero-btn">Me interesa el piloto</a>
        <a href="#como-funciona" class="btn btn-secondary hero-btn">Descubrir cómo funciona</a>
      </div>

      <p class="hero-note hero-reveal hero-reveal--step-2">
        Estamos contrastando el proceso con profesionales del sector antes de abrir una prueba operativa.
      </p>
    </div>

    <figure
      class="flow-figure hero-reveal hero-reveal--step-3"
      aria-label="Diagrama conceptual: la información del almacén y la del transporte convergen en DECA Light"
    >
      <!-- Alternativa accesible única (los dos SVG visuales están ocultos a lectores de pantalla) -->
      <ol class="visually-hidden">
        <li>Entrada 1: datos del almacén (carga y albarán).</li>
        <li>Entrada 2: datos del transporte (vehículo y matrícula), que pueden estar pendientes de confirmación.</li>
        <li>Ambas entradas convergen en DECA Light, una capa de coordinación documental.</li>
        <li>Resultado previsto: documentación preparada para revisión.</li>
      </ol>

      <!-- VARIANTE ESCRITORIO / TABLET (>=640px): convergencia en forma de embudo -->
      <svg
        class="flow-svg flow-svg--desktop"
        viewBox="0 0 520 408"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
      >
        <!-- Conectores base (estáticos) -->
        <path d="M120 104 C120 152 260 142 260 188" stroke="#64748B" stroke-width="1.75" stroke-linecap="round" />
        <path d="M400 104 C400 152 260 142 260 188" stroke="#92400E" stroke-width="1.75" stroke-linecap="round" stroke-dasharray="4 4" />
        <path d="M260 292 V334" stroke="#047857" stroke-width="1.75" stroke-linecap="round" />
        <path d="M254 328 L260 334 L266 328" stroke="#047857" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Pulsos animados superpuestos (>=640px) -->
        <path class="flow-pulse flow-pulse--warehouse" d="M120 104 C120 152 260 142 260 188" stroke="#2563EB" stroke-width="2.25" stroke-linecap="round" />
        <path class="flow-pulse flow-pulse--transport" d="M400 104 C400 152 260 142 260 188" stroke="#D97706" stroke-width="2.25" stroke-linecap="round" />
        <path class="flow-pulse flow-pulse--output" d="M260 292 V334" stroke="#059669" stroke-width="2.25" stroke-linecap="round" />
        <path class="flow-pulse flow-pulse--arrow" d="M254 328 L260 334 L266 328" stroke="#059669" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Entrada A: datos del almacén -->
        <rect x="0.75" y="12.75" width="238.5" height="90.5" rx="8" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="1.5" />
        <g transform="translate(14 46)" stroke="#475569" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3h11l5 5v17H6z" />
          <path d="M17 3v5h5" />
          <path d="M10 14h8M10 18h8M10 22h5" />
        </g>
        <text x="52" y="60" font-size="15" font-weight="700" fill="#0F172A">Datos del almacén</text>
        <text x="52" y="82" font-size="14" fill="#475569">Carga · Albarán</text>

        <!-- Entrada B: datos del transporte (posiblemente pendientes de confirmación) -->
        <rect x="280.75" y="12.75" width="238.5" height="90.5" rx="8" fill="#FFFBEB" stroke="#FCD34D" stroke-width="1.5" />
        <rect x="296" y="1" width="156" height="22" rx="11" fill="#FEF3C7" stroke="#FCD34D" />
        <text x="374" y="16" font-size="12.5" font-weight="600" fill="#92400E" text-anchor="middle">Puede estar pendiente</text>
        <g transform="translate(294 46)" stroke="#92400E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9h14v12H3z" />
          <path d="M17 13h5l3.5 4v4H17" />
          <circle cx="8" cy="22.5" r="2.5" fill="#FFFBEB" />
          <circle cx="21" cy="22.5" r="2.5" fill="#FFFBEB" />
        </g>
        <text x="332" y="60" font-size="15" font-weight="700" fill="#0F172A">Datos del transporte</text>
        <text x="332" y="82" font-size="14" fill="#475569">Vehículo · Matrícula</text>

        <!-- Resplandor radial verde sutil detrás del nodo central -->
        <defs>
          <radialGradient id="hero-node-glow-desktop" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#10B981" stop-opacity="0.22" />
            <stop offset="45%" stop-color="#047857" stop-opacity="0.10" />
            <stop offset="100%" stop-color="#047857" stop-opacity="0" />
          </radialGradient>
        </defs>
        <ellipse cx="260" cy="240" rx="195" ry="85" fill="url(#hero-node-glow-desktop)" />

        <!-- Nodo central: DECA Light -->
        <rect x="100" y="188" width="320" height="104" rx="10" fill="#047857" />
        <text x="260" y="236" font-size="20" font-weight="700" fill="#FFFFFF" text-anchor="middle">DECA Light</text>
        <text x="260" y="262" font-size="14" fill="#FFFFFF" text-anchor="middle">Capa de coordinación documental</text>
        <!-- Punto de convergencia -->
        <circle cx="260" cy="188" r="5.5" fill="#047857" stroke="#FFFFFF" stroke-width="2.5" />
        <circle class="flow-node-highlight" cx="260" cy="188" r="5.5" fill="#10B981" stroke="#FFFFFF" stroke-width="2.5" />

        <!-- Salida: resultado previsto -->
        <rect x="60.75" y="338.75" width="398.5" height="62.5" rx="8" fill="#FFFFFF" stroke="#64748B" stroke-width="1.5" stroke-dasharray="5 4" />
        <g transform="translate(80 356)" stroke="#047857" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3h11l5 5v17H6z" />
          <path d="M17 3v5h5" />
          <path d="M10 14h8M10 18h8M10 22h5" />
        </g>
        <text x="120" y="375" font-size="15.5" font-weight="600" fill="#0F172A">Documentación preparada para revisión</text>
      </svg>

      <!-- VARIANTE MÓVIL (<640px): flujo vertical. Los bloques se escalonan (almacén a la derecha, transporte a la izquierda)
           para que cada conector salga de su base y baje por un canal libre, sin atravesar ni rodear cajas.
           Ambos conectores se unen en un punto central sobre DECA Light y un único conector entra en el nodo. -->
      <svg
        class="flow-svg flow-svg--mobile"
        viewBox="0 0 280 432"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
      >
        <!-- Conectores: salida desde la base de cada bloque, codos simétricos hacia el punto de convergencia (140, 216) -->
        <path d="M262 80 V206 Q262 216 252 216 H140" stroke="#64748B" stroke-width="1.75" stroke-linecap="round" />
        <path d="M18 188 V206 Q18 216 28 216 H140" stroke="#92400E" stroke-width="1.75" stroke-linecap="round" stroke-dasharray="4 4" />
        <path d="M140 216 V250" stroke="#047857" stroke-width="1.75" stroke-linecap="round" />
        <path d="M140 318 V354" stroke="#047857" stroke-width="1.75" stroke-linecap="round" />
        <path d="M134 348 L140 354 L146 348" stroke="#047857" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Entrada A: datos del almacén -->
        <rect x="36.75" y="8.75" width="242.5" height="70.5" rx="8" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="1.5" />
        <g transform="translate(48 30)" stroke="#475569" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3h11l5 5v17H6z" />
          <path d="M17 3v5h5" />
          <path d="M10 14h8M10 18h8M10 22h5" />
        </g>
        <text x="86" y="40" font-size="15" font-weight="700" fill="#0F172A">Datos del almacén</text>
        <text x="86" y="61" font-size="13" fill="#475569">Carga · Albarán</text>

        <!-- Entrada B: datos del transporte (posiblemente pendientes de confirmación) -->
        <rect x="0.75" y="116.75" width="242.5" height="70.5" rx="8" fill="#FFFBEB" stroke="#FCD34D" stroke-width="1.5" />
        <rect x="16" y="105" width="150" height="22" rx="11" fill="#FEF3C7" stroke="#FCD34D" />
        <text x="91" y="120" font-size="12" font-weight="600" fill="#92400E" text-anchor="middle">Puede estar pendiente</text>
        <g transform="translate(12 142)" stroke="#92400E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9h14v12H3z" />
          <path d="M17 13h5l3.5 4v4H17" />
          <circle cx="8" cy="22.5" r="2.5" fill="#FFFBEB" />
          <circle cx="21" cy="22.5" r="2.5" fill="#FFFBEB" />
        </g>
        <text x="50" y="152" font-size="15" font-weight="700" fill="#0F172A">Datos del transporte</text>
        <text x="50" y="173" font-size="13" fill="#475569">Vehículo · Matrícula</text>

        <!-- Resplandor radial verde sutil detrás del nodo central -->
        <defs>
          <radialGradient id="hero-node-glow-mobile" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#10B981" stop-opacity="0.22" />
            <stop offset="45%" stop-color="#047857" stop-opacity="0.10" />
            <stop offset="100%" stop-color="#047857" stop-opacity="0" />
          </radialGradient>
        </defs>
        <ellipse cx="140" cy="284" rx="165" ry="58" fill="url(#hero-node-glow-mobile)" />

        <!-- Nodo central: DECA Light -->
        <rect x="0" y="250" width="280" height="68" rx="10" fill="#047857" />
        <text x="140" y="279" font-size="18" font-weight="700" fill="#FFFFFF" text-anchor="middle">DECA Light</text>
        <text x="140" y="301" font-size="13" fill="#FFFFFF" text-anchor="middle">Capa de coordinación documental</text>
        <!-- Punto de convergencia -->
        <circle cx="140" cy="216" r="5.5" fill="#047857" stroke="#FFFFFF" stroke-width="2.5" />

        <!-- Salida: resultado previsto -->
        <rect x="0.75" y="358.75" width="278.5" height="66.5" rx="8" fill="#FFFFFF" stroke="#64748B" stroke-width="1.5" stroke-dasharray="5 4" />
        <g transform="translate(12 378)" stroke="#047857" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3h11l5 5v17H6z" />
          <path d="M17 3v5h5" />
          <path d="M10 14h8M10 18h8M10 22h5" />
        </g>
        <text x="50" y="388" font-size="14.5" font-weight="600" fill="#0F172A">Documentación preparada</text>
        <text x="50" y="407" font-size="14.5" font-weight="600" fill="#0F172A">para revisión</text>
      </svg>

      <figcaption class="flow-note">
        Representación conceptual del flujo objetivo en desarrollo. No implica integraciones técnicas operativas verificadas.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
    background-color: var(--color-bg-canvas);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .hero-container {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10);
  }

  /* ---- Columna de texto ---- */
  .hero-content {
    max-width: 640px;
  }

  .hero-title {
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    overflow-wrap: break-word;
    text-wrap: balance;
    margin-bottom: var(--space-5);
  }

  .hero-description {
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 58ch;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-btn {
    flex: 1 1 100%;
  }

  .hero-note {
    margin-top: var(--space-5);
    max-width: 52ch;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* ---- Diagrama ---- */
  .flow-figure {
    margin: 0;
    min-width: 0;
    padding: var(--space-3);
    background-color: var(--color-bg-surface);
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: var(--radius-lg);
    box-shadow:
      0 1px 3px 0 rgba(15, 23, 42, 0.03),
      0 6px 16px -2px rgba(15, 23, 42, 0.04),
      0 20px 28px -6px rgba(15, 23, 42, 0.05);
    background-image: radial-gradient(rgba(148, 163, 184, 0.22) 1px, transparent 1px);
    background-size: 18px 18px;
    background-position: -9px -9px;
  }

  .flow-svg {
    width: 100%;
    height: auto;
  }

  .flow-svg--mobile {
    max-width: 360px;
    margin-inline: auto;
  }

  .flow-svg--desktop {
    display: none;
  }

  /* Elementos animados del flujo convergente (ocultos por defecto y en móvil) */
  .flow-pulse,
  .flow-node-highlight {
    pointer-events: none;
    opacity: 0;
  }

  .flow-note {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
    max-width: 52ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* Texto solo para lectores de pantalla */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---- Breakpoints ---- */
  @media (min-width: 480px) {
    .hero-title {
      font-size: 2.25rem;
    }

    .flow-figure {
      padding: var(--space-4);
    }
  }

  @media (min-width: 640px) {
    .hero-btn {
      flex: 0 0 auto;
    }

    /* Panel que enmarca el diagrama convergente */
    .flow-figure {
      padding: var(--space-6);
    }

    .flow-svg--mobile {
      display: none;
    }

    .flow-svg--desktop {
      display: block;
      max-width: 560px;
      margin-inline: auto;
    }

    .flow-note {
      margin-inline: auto;
      max-width: 560px;
    }

    /* ---- Animación sutil de flujo convergente (ciclo 5.5s) ---- */
    .flow-pulse--warehouse {
      stroke-dasharray: 40 180;
      stroke-dashoffset: 40;
      animation: pulse-warehouse 5.5s linear infinite;
    }

    .flow-pulse--transport {
      stroke-dasharray: 40 180;
      stroke-dashoffset: 40;
      animation: pulse-transport 5.5s linear infinite;
    }

    .flow-node-highlight {
      animation: highlight-node 5.5s linear infinite;
    }

    .flow-pulse--output {
      stroke-dasharray: 16 50;
      stroke-dashoffset: 16;
      animation: pulse-output 5.5s linear infinite;
    }

    .flow-pulse--arrow {
      animation: pulse-arrow 5.5s linear infinite;
    }
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding-top: var(--space-16);
      padding-bottom: var(--space-20);
    }

    .hero-container {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--space-12);
      align-items: center;
    }

    .hero-title {
      font-size: 2.25rem;
    }

    .flow-figure {
      padding: var(--space-4);
    }
  }

  @media (min-width: 1200px) {
    .hero-container {
      gap: var(--space-16);
    }

    .hero-title {
      font-size: 2.75rem;
    }

    .flow-figure {
      padding: var(--space-6);
    }
  }

  /* ---- Keyframes del ciclo convergente continuo (5.5s) ---- */
  @keyframes pulse-warehouse {
    0% {
      stroke-dashoffset: 40;
      opacity: 0;
      animation-timing-function: ease-out;
    }
    1% {
      stroke-dashoffset: 40;
      opacity: 1;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    21.8% {
      stroke-dashoffset: -174;
      opacity: 1;
      animation-timing-function: ease-in;
    }
    22.5%,
    100% {
      stroke-dashoffset: -174;
      opacity: 0;
    }
  }

  @keyframes pulse-transport {
    0%,
    14% {
      stroke-dashoffset: 40;
      opacity: 0;
      animation-timing-function: ease-out;
    }
    14.5% {
      stroke-dashoffset: 40;
      opacity: 0;
      animation-timing-function: ease-out;
    }
    15.5% {
      stroke-dashoffset: 40;
      opacity: 1;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    36.4% {
      stroke-dashoffset: -174;
      opacity: 1;
      animation-timing-function: ease-in;
    }
    37.2%,
    100% {
      stroke-dashoffset: -174;
      opacity: 0;
    }
  }

  @keyframes highlight-node {
    0%,
    36.3% {
      opacity: 0;
      animation-timing-function: ease-out;
    }
    40% {
      opacity: 0.9;
      animation-timing-function: ease-in;
    }
    43.6%,
    100% {
      opacity: 0;
    }
  }

  @keyframes pulse-output {
    0%,
    43.5% {
      stroke-dashoffset: 16;
      opacity: 0;
      animation-timing-function: ease-out;
    }
    44.5% {
      stroke-dashoffset: 16;
      opacity: 1;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    54.5% {
      stroke-dashoffset: -42;
      opacity: 1;
      animation-timing-function: ease-in;
    }
    55.5%,
    100% {
      stroke-dashoffset: -42;
      opacity: 0;
    }
  }

  @keyframes pulse-arrow {
    0%,
    54.5% {
      opacity: 0;
      animation-timing-function: ease-out;
    }
    56% {
      opacity: 1;
      animation-timing-function: ease-in;
    }
    58.2%,
    100% {
      opacity: 0;
    }
  }

  /* ---- Entrada progresiva del Hero ----
     Solo se activa si el script inline ha añadido .hero-motion a <html>.
     Sin esa clase (sin JS, sin soporte o con movimiento reducido) no hay estado inicial oculto.
     El kicker y el H1 arrancan sin retardo para no retener el titular; el resto se escalona 60 ms.
     Se animan exclusivamente opacity y transform: sin recálculo de layout ni desplazamientos acumulativos. */
  :global(html.hero-motion) .hero-reveal {
    animation: hero-enter var(--duration-long) var(--ease-out) both;
  }

  :global(html.hero-motion) .hero-reveal--step-1 {
    animation-delay: 60ms;
  }

  :global(html.hero-motion) .hero-reveal--step-2 {
    animation-delay: 120ms;
  }

  :global(html.hero-motion) .hero-reveal--step-3 {
    animation-delay: 180ms;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translate3d(0, 8px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Movimiento reducido: desactiva animaciones y preserva el diagrama estático */
  @media (prefers-reduced-motion: reduce) {
    .flow-pulse,
    .flow-node-highlight {
      animation: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
    }

    /* Refuerzo por si la preferencia cambia con la página abierta: contenido siempre visible y quieto */
    .hero-reveal {
      animation: none !important;
    }
  }
</style>
