---
// src/components/Hero.astro - Hero de DECA Light con Animaciones de Alta Fidelidad Stitch
import HeroContenido from './HeroContenido.astro';
import HeroDiagrama from './HeroDiagrama.astro';
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="container hero-container">
    <HeroContenido />

    <HeroDiagrama />
  </div>
</section>

<style>
  .hero-section {
      position: relative;
      min-height: calc(100vh - 76px);
      padding-top: 6.25rem;
      padding-bottom: 6.5rem;
      background-color: var(--palette-white);
      background-image:
        radial-gradient(ellipse 720px 580px at 78% 46%, rgba(209, 250, 229, 0.55) 0%, rgba(240, 253, 244, 0.28) 50%, transparent 80%),
        radial-gradient(circle 450px at 15% 20%, rgba(241, 245, 249, 0.7) 0%, transparent 70%);
      border-bottom: 1px solid var(--border-subtle, var(--palette-slate-200));
      overflow: hidden;
    }
  .hero-container {
      display: grid;
      grid-template-columns: 1fr 1.08fr;
      gap: 3.5rem;
      align-items: center;
      max-width: 1340px;
    }
  @media (max-width: 1024px) {
    .hero-container {
          gap: 2.5rem;
        }
  }
  @media (max-width: 900px) {
    .hero-section {
          padding-top: 3rem;
          padding-bottom: 4rem;
        }
    .hero-container {
          grid-template-columns: 1fr;
          gap: 3.5rem;
        }
  }
  @media (max-width: 580px) {
    .hero-section {
          padding-top: 2.25rem;
          padding-bottom: 3.5rem;
        }
  }
</style>
