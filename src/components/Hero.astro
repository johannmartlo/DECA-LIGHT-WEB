---
// src/components/Hero.astro - Portada centrada ultra premium con escenario fotográfico, ventana de vídeo y modal accesible
import HeroContenido from './HeroContenido.astro';
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="container hero-container">
    <HeroContenido />

    <div class="hero-stage-wrapper hero-stage-enter">
      <!-- Escenario fotográfico -->
      <div class="hero-stage">
        <picture class="hero-stage-picture">
          <img
            src="/img/muelle-amanecer.webp"
            srcset="/img/muelle-amanecer-960.webp 960w, /img/muelle-amanecer.webp 1920w"
            sizes="(max-width: 1240px) 100vw, 1200px"
            alt="Muelle de expedición hortofrutícola al amanecer"
            width="1920"
            height="1080"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="hero-stage-bg"
          />
        </picture>
        <div class="hero-stage-overlay" aria-hidden="true"></div>

        <!-- Etiquetas flotantes (solo en ordenador >= 900px) -->
        <div class="floating-badge floating-badge-left" aria-hidden="true">
          <div class="floating-badge-icon">1</div>
          <div class="floating-badge-content">
            <p class="floating-badge-title">Una matrícula por camión</p>
            <p class="floating-badge-sub">y se aplica a todas sus cargas</p>
          </div>
        </div>

        <div class="floating-badge floating-badge-right" aria-hidden="true">
          <div class="floating-badge-icon">QR</div>
          <div class="floating-badge-content">
            <p class="floating-badge-title">4 DeCA emitidos</p>
            <p class="floating-badge-sub">con un clic por transportista</p>
          </div>
        </div>
      </div>

      <!-- Ventana de la app que sobresale por debajo del escenario -->
      <div class="hero-app-window">
        <video
          id="hero-stage-video"
          class="hero-app-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster="/video/hero-app-poster.jpg"
          width="1280"
          height="800"
          aria-label="Demostración: el día agrupado por transportista, la matrícula una vez y todos los DeCA emitidos con su QR"
        >
          <source src="/video/hero-app.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>

  <!-- Modal accesible con el vídeo de demostración de siempre -->
  <dialog
    id="hero-video-modal"
    class="video-modal"
    aria-labelledby="video-modal-title"
  >
    <div class="video-modal-box">
      <div class="video-modal-header">
        <h2 id="video-modal-title" class="video-modal-title">Cómo funciona DECA Light</h2>
        <button
          type="button"
          id="close-video-modal"
          class="video-modal-close"
          aria-label="Cerrar vídeo"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="video-modal-body">
        <video
          id="hero-modal-video"
          class="modal-video-player"
          controls
          muted
          loop
          playsinline
          preload="none"
          poster="/video/demo-poster.jpg"
        >
          <source src="/video/demo.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </dialog>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const stageVideo = document.getElementById('hero-stage-video') as HTMLVideoElement | null;
    const reducedQuery = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;

    const handleStageMotion = () => {
      if (!stageVideo) return;
      if (reducedQuery && reducedQuery.matches) {
        stageVideo.removeAttribute('autoplay');
        stageVideo.pause();
        stageVideo.currentTime = 0;
        stageVideo.load(); // Muestra solo el póster
      } else {
        stageVideo.play().catch(() => {});
      }
    };

    handleStageMotion();
    reducedQuery?.addEventListener?.('change', handleStageMotion);

    // Control del modal de vídeo («Ver cómo funciona · 1 min»)
    const openBtn = document.getElementById('open-video-modal') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('close-video-modal') as HTMLButtonElement | null;
    const modal = document.getElementById('hero-video-modal') as HTMLDialogElement | null;
    const modalVideo = document.getElementById('hero-modal-video') as HTMLVideoElement | null;

    if (!openBtn || !modal) return;

    const closeModal = () => {
      if (modalVideo && typeof modalVideo.pause === 'function') {
        modalVideo.pause();
      }
      if (modal.open) {
        modal.close();
      }
      openBtn.focus();
    };

    openBtn.addEventListener('click', () => {
      if (typeof modal.showModal === 'function') {
        modal.showModal();
      } else {
        modal.setAttribute('open', '');
      }
      closeBtn?.focus();
      const prefersReduced = reducedQuery && reducedQuery.matches;
      if (modalVideo && !prefersReduced) {
        modalVideo.play().catch(() => {});
      }
    });

    closeBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    modal.addEventListener('close', () => {
      if (modalVideo && typeof modalVideo.pause === 'function') {
        modalVideo.pause();
      }
      openBtn.focus();
    });
  });
</script>

<style>
  .hero-section {
    position: relative;
    padding-top: 96px;
    padding-bottom: 240px; /* 150px que sobresale la ventana + 90px de respiro hasta La Hora Punta */
    background-color: #FFFFFF;
    background-image: radial-gradient(900px 420px at 50% 0%, rgba(209, 250, 229, 0.55), transparent 70%);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Escenario bajo los botones */
  .hero-stage-wrapper {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin-top: 72px;
    margin-inline: auto;
  }

  .hero-stage {
    position: relative;
    width: 100%;
    height: 640px;
    border-radius: 32px;
    overflow: hidden;
    background-color: #064E3B;
  }

  .hero-stage-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-stage-bg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-stage-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(4, 47, 36, 0) 30%, rgba(4, 47, 36, 0.55) 100%);
    pointer-events: none;
  }

  /* Ventana de la app */
  .hero-app-window {
    position: absolute;
    left: 50%;
    bottom: -150px;
    transform: translateX(-50%);
    width: 780px;
    max-width: calc(100% - 40px);
    border-radius: 18px;
    overflow: hidden;
    background-color: #0F172A;
    box-shadow:
      0 50px 100px -20px rgba(2, 44, 34, 0.45),
      0 30px 60px -30px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(15, 23, 42, 0.06);
    z-index: 3;
  }

  .hero-app-video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1280 / 800;
  }

  /* Etiquetas flotantes (solo en ordenador >= 900px) */
  .floating-badge {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background-color: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 16px;
    box-shadow: 0 18px 40px -16px rgba(2, 44, 34, 0.4);
  }

  .floating-badge-left {
    left: 40px;
    top: 44px;
  }

  .floating-badge-right {
    right: 40px;
    top: 150px;
  }

  .floating-badge-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background-color: #ECFDF5;
    color: #047857;
    font-size: 0.9375rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .floating-badge-content {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .floating-badge-title {
    margin: 0;
    font-size: 1rem; /* 16px */
    font-weight: 600;
    line-height: 1.25;
    color: #0F172A;
  }

  .floating-badge-sub {
    margin: 0;
    font-size: 0.9375rem; /* 15px */
    font-weight: 400;
    line-height: 1.3;
    color: #475569;
  }

  @media (max-width: 899px) {
    .floating-badge {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .hero-section {
      padding-top: 56px;
      padding-bottom: 150px; /* 70px que sobresale la ventana + 80px de respiro */
    }

    .hero-stage-wrapper {
      margin-top: 48px;
    }

    .hero-stage {
      height: 340px;
      border-radius: 22px;
    }

    .hero-app-window {
      width: 92%;
      max-width: 92%;
      bottom: -70px;
      border-radius: 12px;
    }
  }

  /* Entrada suave del escenario (24 px de desplazamiento, escalonado tras los botones) */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes stageFadeUp {
      from {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
      }
      to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }

    .hero-stage-enter {
      animation: stageFadeUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) 320ms both;
    }
  }

  /* Modal de vídeo */
  .video-modal {
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-border-subtle, var(--palette-slate-200));
    border-radius: 16px;
    background-color: var(--palette-white);
    color: var(--color-text-primary, var(--palette-slate-900));
    width: min(92vw, 920px);
    max-width: 920px;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.35);
  }

  .video-modal::backdrop {
    background-color: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(4px);
  }

  .video-modal-box {
    display: flex;
    flex-direction: column;
  }

  .video-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle, var(--palette-slate-200));
  }

  .video-modal-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
  }

  .video-modal-close {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md, 6px);
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text-secondary, var(--palette-slate-600));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .video-modal-close:hover {
    background-color: var(--color-bg-surface-subtle, var(--palette-slate-100));
    color: var(--color-text-primary, var(--palette-slate-900));
  }

  .video-modal-body {
    padding: 1rem;
    background-color: var(--palette-slate-900);
  }

  .modal-video-player {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
  }
</style>
