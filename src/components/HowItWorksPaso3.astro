---
// HowItWorksPaso3.astro — extraído de HowItWorks.astro
---

  <!-- --------------------------------------------
       PASO 3: Coordinamos la documentación
       -------------------------------------------- -->
  <article class="step-card group step-3" role="listitem" data-reveal="card" data-reveal-delay="3">
    <!-- Encabezado del Paso -->
    <div class="step-header">
      <div class="step-badge-wrap">
        <span class="step-badge" aria-hidden="true">3</span>
        <div class="step-title-copy">
          <h3 class="step-title">Coordinamos la documentación</h3>
          <p class="step-text">
            Relacionamos la información y preparamos la documentación correspondiente a cada expedición.
          </p>
        </div>
      </div>
    </div>

    <!-- Visual / Mockup del Paso 3: Nodo Central DECA Light -->
    <div class="step-visual visual-step-3">
      <div class="hub-coordination-card">
        <!-- Emblema Central DECA Light con Halo de Respiración -->
        <div class="hub-header">
          <div class="hub-emblem animate-hub-breath" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="3" width="16" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round"></rect>
              <path d="M8 8h8M8 12h5m-5 4h8" stroke-linecap="round"></path>
            </svg>
          </div>
          <h4 class="hub-brand-name">DECA Light</h4>
          <p class="hub-sublabel">Coordinación documental</p>
        </div>

        <!-- Filas de Estados Documentales -->
        <div class="hub-status-rows">
          <div class="hub-row">
            <div class="hub-row-label">
              <span class="hub-row-icon icon-green" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 10h18M3 14h18M5 18h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </span>
              <span>Datos del almacén</span>
            </div>
            <span class="check-icon-circle">✓</span>
          </div>

          <div class="hub-row">
            <div class="hub-row-label">
              <span class="hub-row-icon icon-amber" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  <path d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8h4l3 4v4a1 1 0 01-1 1h-1" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span>Datos del transporte</span>
            </div>
            <span class="pending-icon-circle">!</span>
          </div>

          <div class="hub-row">
            <div class="hub-row-label">
              <span class="hub-row-icon icon-blue" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span>Generación de documentos</span>
            </div>
            <span class="check-icon-circle">✓</span>
          </div>

          <div class="hub-row">
            <div class="hub-row-label">
              <span class="hub-row-icon icon-emerald" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span>Preparado para revisión</span>
            </div>
            <span class="check-icon-circle">✓</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Flecha de Conexión 3 -> 4 (Desktop/Tablet) -->
    <div class="flow-arrow-wrap arrow-3-4" aria-hidden="true">
      <svg class="flow-arrow-svg" viewBox="0 0 24 24" fill="none">
        <path class="flow-dashed-path" d="M14 5l7 7m0 0l-7 7m7-7H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
  </article>

<style>
  .step-card {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 100%;
      cursor: default;
    }
  .step-header {
      margin-bottom: 1.25rem;
    }
  .step-badge-wrap {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
    }
  .step-badge {
      flex-shrink: 0;
      width: 2rem;
      height: 2rem;
      border-radius: 9999px;
      background-color: #e6f4ea;
      color: var(--palette-deca-800);
      font-size: 0.875rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
  .step-card:hover .step-badge {
      background-color: var(--palette-deca-800);
      color: var(--palette-white);
      box-shadow: 0 4px 8px -2px rgba(8, 84, 62, 0.25);
    }
  .step-title-copy {
      flex: 1;
      min-width: 0;
    }
  .step-title {
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--palette-slate-900);
      line-height: 1.3;
      margin: 0;
      transition: color 0.2s ease;
      word-break: break-word;
    }
  @media (min-width: 1280px) {
    .step-title {
          font-size: 1rem;
        }
  }
  .step-card:hover .step-title {
      color: var(--palette-deca-800);
    }
  .step-text {
      font-size: 0.75rem;
      line-height: 1.45;
      color: var(--palette-slate-500);
      margin: 0.25rem 0 0 0;
      word-break: break-word;
    }
  @media (min-width: 640px) {
    .step-text {
          font-size: 0.8125rem;
        }
  }
  .step-visual {
      flex-grow: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
  .flow-arrow-wrap {
      display: none;
      position: absolute;
      top: 55%;
      transform: translateY(-50%);
      z-index: 20;
      pointer-events: none;
      color: var(--palette-emerald-600);
      filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.05));
    }
  @media (min-width: 1024px) {
    .flow-arrow-wrap {
          display: flex;
          align-items: center;
          right: -1rem;
        }
  }
  @media (min-width: 1280px) {
    .flow-arrow-wrap {
          right: -1.25rem;
        }
  }
  .flow-arrow-svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  .flow-dashed-path {
      stroke-dasharray: 4 3;
      animation: dashTravel 1.2s linear infinite;
    }
  .check-icon-circle {
      width: 0.95rem;
      height: 0.95rem;
      border-radius: 9999px;
      background-color: var(--palette-emerald-500);
      color: var(--palette-white);
      font-size: 0.5625rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
      transition: transform 0.2s ease;
    }
  .pending-icon-circle {
      width: 0.95rem;
      height: 0.95rem;
      border-radius: 9999px;
      background-color: var(--palette-amber-400);
      color: var(--palette-white);
      font-size: 0.5625rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
      animation: amberPulseMini 2s infinite;
    }
  .visual-step-3 {
      width: 100%;
    }
  .hub-coordination-card {
      width: 100%;
      background-color: var(--palette-white);
      border: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 1rem;
      padding: 0.875rem;
      box-shadow: 0 10px 25px -5px rgba(8, 84, 62, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
  @media (min-width: 640px) {
    .hub-coordination-card {
          padding: 1rem;
        }
  }
  .step-3:hover .hub-coordination-card {
      box-shadow: 0 20px 30px -10px rgba(8, 84, 62, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
      transform: translateY(-3px);
    }
  .hub-header {
      text-align: center;
      border-bottom: 1px solid var(--palette-slate-100);
      padding-bottom: 0.5rem;
      margin-bottom: 0.625rem;
    }
  .hub-emblem {
      width: 2.25rem;
      height: 2.25rem;
      margin-inline: auto;
      margin-bottom: 0.25rem;
      border-radius: 0.625rem;
      background-color: var(--palette-emerald-50);
      color: var(--palette-deca-800);
      display: flex;
      align-items: center;
      justify-content: center;
      animation: hubBreath 3s ease-in-out infinite;
    }
  .hub-brand-name {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--palette-slate-900);
      margin: 0;
    }
  .hub-sublabel {
      font-size: 0.5625rem;
      font-weight: 500;
      color: var(--palette-slate-400);
      margin: 0.1rem 0 0 0;
    }
  .hub-status-rows {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      font-size: 0.6875rem;
    }
  .hub-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.2rem 0.3rem;
      border-radius: 0.375rem;
      color: var(--palette-slate-700);
      transition: background-color 0.15s ease;
    }
  .hub-row:hover {
      background-color: var(--palette-slate-50);
    }
  .hub-row-label {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
  .hub-row-icon {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  .icon-green { color: var(--palette-emerald-700); }
  .icon-amber { color: var(--palette-amber-500); }
  .icon-blue { color: #3b82f6; }
  .icon-emerald { color: var(--palette-emerald-600); }
  @media (prefers-reduced-motion: reduce) {
    .eyebrow-line,
        .step-badge,
        .format-pill,
        .icon-pdf,
        .icon-csv,
        .icon-manual,
        .doc-ghost,
        .card-cmr,
        .card-porte,
        .card-cmr-4,
        .card-porte-4,
        .albaran-box,
        .validation-card,
        .hub-coordination-card,
        .deca-output-card,
        .flow-dashed-path,
        .ping-circle,
        .pending-icon-circle,
        .pending-callout-box,
        .clock-spin-icon,
        .hub-emblem,
        .animate-shimmer::after,
        .benefit-item,
        .benefit-icon-box {
          animation: none !important;
          transition: none !important;
          transform: none !important;
        }
  }

  @keyframes dashTravel {
      to {
        stroke-dashoffset: -20;
      }
    }

  @keyframes ping {
      75%, 100% {
        transform: scale(2);
        opacity: 0;
      }
    }

  @keyframes amberPulseMini {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.7; transform: scale(1.1); }
    }

  @keyframes hubBreath {
      0%, 100% {
        transform: scale(1);
        filter: drop-shadow(0 0 2px rgba(8, 84, 62, 0.15));
      }
      50% {
        transform: scale(1.05);
        filter: drop-shadow(0 0 6px rgba(16, 185, 129, 0.4));
      }
    }
</style>
