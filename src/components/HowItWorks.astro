    font-size: 0.625rem;
    font-weight: 600;
    user-select: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-cmr {
    top: -0.875rem;
    left: -0.625rem;
    width: 100%;
    color: #94a3b8;
    transform: rotate(-3deg);
  }

  .fanned-step-1:hover .card-cmr {
    transform: translate(-8px, -4px) rotate(-6deg);
  }

  .card-porte {
    top: -0.45rem;
    right: 0.25rem;
    width: 100%;
    color: #64748b;
    transform: rotate(2deg);
  }

  .fanned-step-1:hover .card-porte {
