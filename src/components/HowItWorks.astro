  }

  .albaran-box-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
  }

  .status-ping-wrap {
    position: relative;
    display: flex;
    width: 0.5rem;
    height: 0.5rem;
  }

  .ping-circle {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    background-color: #34d399;
    opacity: 0.75;
    animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .ping-dot {
    position: relative;
    display: inline-flex;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background-color: #10b981;
  }

  .albaran-skeleton-lines {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 0.5rem;
  }

  .skel-line {
    display: block;
    height: 5px;
    background-color: #f1f5f9;
    border-radius: 9999px;
  }

  .w-full { width: 100%; }
  .w-90 { width: 90%; }
  .w-80 { width: 80%; }
  .w-75 { width: 75%; }

  .albaran-data-table {
