---
// HowItWorks.astro - Sección «Cómo funciona»: Flujo objetivo en tres macro-fases con blueprints conceptuales y síntesis de valor
---

<section id="como-funciona" class="how-it-works-section" aria-labelledby="how-it-works-title">
  <!--
    Gestor de revelados al hacer scroll (Scroll Reveals - Fase 2A).
    Idempotente: se ejecuta una sola vez aunque esté presente en varios componentes.
    Anti-FOUC sincrónico: comprueba elementos ya visibles antes de activar la compuerta reveal-ready.
  -->
  <script is:inline>
    (function () {
      if (window.__decaRevealInit) return;
      window.__decaRevealInit = true;

      function initReveal() {
        try {
          var motionOk = window.matchMedia && window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
          var ioOk = 'IntersectionObserver' in window;
          var cssOk = window.CSS && CSS.supports && CSS.supports('transform', 'translate3d(0, 0, 0)');

          if (!motionOk || !ioOk || !cssOk) return;

          var revealElements = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
          if (revealElements.length === 0) return;

          var pendingCount = 0;
          var thresholdHeight = window.innerHeight * 0.92;

          // Fase sincrónica anti-FOUC: revelar inmediatamente elementos en viewport o por encima del pliegue
          for (var i = 0; i < revealElements.length; i++) {
            var el = revealElements[i];
            var rect = el.getBoundingClientRect();
            if (rect.top < thresholdHeight) {
              el.classList.add('is-revealed');
            } else {
              pendingCount++;
            }
          }

          // Activar compuerta global en <html>
          document.documentElement.classList.add('reveal-ready');

          if (pendingCount === 0) return;

          var observer = new IntersectionObserver(function (entries) {
            for (var j = 0; j < entries.length; j++) {
              var entry = entries[j];
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
                pendingCount--;
                if (pendingCount <= 0) {
                  observer.disconnect();
                }
              }
            }
          }, {
            threshold: 0.12,
            rootMargin: '0px 0px -8% 0px'
          });

          for (var k = 0; k < revealElements.length; k++) {
            var item = revealElements[k];
            if (!item.classList.contains('is-revealed')) {
              observer.observe(item);
            }
          }
        } catch (err) {
          document.documentElement.classList.remove('reveal-ready');
          var all = document.querySelectorAll('[data-reveal]');
          for (var n = 0; n < all.length; n++) {
            all[n].classList.add('is-revealed');
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal, { once: true });
      } else {
        initReveal();
      }
    })();
  </script>

  <div class="container">
    <header class="section-intro" data-reveal="editorial">
      <span class="section-kicker">Flujo objetivo de trabajo</span>
      <h2 id="how-it-works-title" class="section-title">
        De la preparación de la carga a la documentación organizada.
      </h2>
      <p class="section-subtitle">
        DECA Light se está desarrollando para coordinar los documentos de expedición y los datos del transporte, aunque lleguen en momentos diferentes.
      </p>

      <div class="disclaimer-inline">
        <span class="badge badge-amber">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>Proyecto en desarrollo</span>
        </span>
        <span class="disclaimer-note">
          Flujo pendiente de validación operativa y técnica.
        </span>
      </div>
    </header>

    <!-- Tres macro-fases del flujo con narrativa editorial y blueprint conceptual -->
    <div class="macro-phases-wrapper">
      
      <!-- FASE 1: ALMACÉN (Pasos 01–03) -->
      <article class="macro-phase" aria-labelledby="phase-1-heading">
        <div class="macro-phase-editorial" data-reveal="editorial">
          <div class="macro-phase-badge">
            <span class="phase-tag">Fase 1</span>
            <span class="phase-category">Almacén</span>
          </div>
          <h3 id="phase-1-heading" class="macro-phase-title">Preparación en origen</h3>
          <p class="macro-phase-lead">
            La documentación de la carga comienza en el almacén con la preparación física y el albarán habitual.
          </p>

          <ol class="phase-steps-list" start="1">
            <li class="phase-step-item">
              <span class="step-num" aria-hidden="true">01</span>
              <div class="step-content">
                <h4 class="step-title">Preparar la documentación</h4>
                <p class="step-text">
                  Preparar el pedido, pesar la mercancía y generar el albarán en el sistema habitual.
                </p>
              </div>
            </li>
            <li class="phase-step-item">
              <span class="step-num" aria-hidden="true">02</span>
              <div class="step-content">
                <h4 class="step-title">Reunir los documentos</h4>
                <p class="step-text">
                  Agrupar albaranes, cartas de porte y documentación asociada a la carga.
                </p>
              </div>
            </li>
            <li class="phase-step-item">
              <span class="step-num" aria-hidden="true">03</span>
              <div class="step-content">
                <h4 class="step-title">Relacionar por albarán</h4>
                <p class="step-text">
                  Vincular los documentos con la expedición correspondiente.
                </p>
              </div>
            </li>
          </ol>
        </div>

        <div class="macro-phase-visual" data-reveal="blueprint" data-reveal-delay="1">
          <figure class="blueprint-card" aria-label="Esquema conceptual: Relación entre expedición EXP-0842 y albarán ALB-0842">
            <div class="blueprint-header">
              <div class="blueprint-title-wrap">
                <span class="blueprint-status-indicator" aria-hidden="true"></span>
                <span class="blueprint-title">Registro documental de almacén</span>
              </div>
              <span class="blueprint-disclaimer">Esquema conceptual · Proyecto en desarrollo</span>
            </div>

            <div class="blueprint-body">
              <!-- Estructura vertical conectada: relación documental en origen -->
              <div class="blueprint-pipeline" role="list">
                
                <!-- 1. Carga física completada -->
                <div class="pipeline-node" role="listitem">
                  <div class="node-track" aria-hidden="true">
                    <span class="node-icon node-icon--complete">✓</span>
                    <span class="node-stem"></span>
                  </div>
                  <div class="node-content">
                    <div class="node-meta">
                      <span class="node-label mono">1. CARGA FÍSICA</span>
                      <span class="node-id mono">EXP-0842 <span class="id-tag">ejemplo</span></span>
                    </div>
                    <div class="node-title">Carga física completada</div>
                    <p class="node-desc">Mercancía preparada y pesada en muelle de salida</p>
                  </div>
                </div>

                <!-- 2. Albarán emitido -->
                <div class="pipeline-node" role="listitem">
                  <div class="node-track" aria-hidden="true">
                    <span class="node-icon node-icon--complete">✓</span>
                    <span class="node-stem"></span>
                  </div>
                  <div class="node-content">
                    <div class="node-meta">
                      <span class="node-label mono">2. ALBARÁN EMITIDO</span>
                      <span class="node-id mono">ALB-0842 <span class="id-tag">ejemplo</span></span>
                    </div>
                    <div class="node-title">Albarán de salida generado</div>
                    <p class="node-desc">Documento emitido en el sistema de gestión habitual</p>
                  </div>
                </div>

                <!-- 3. Documentación asociada -->
                <div class="pipeline-node" role="listitem">
                  <div class="node-track" aria-hidden="true">
                    <span class="node-icon node-icon--complete">✓</span>
                    <span class="node-stem node-stem--dashed"></span>
                  </div>
                  <div class="node-content">
                    <div class="node-meta">
                      <span class="node-label mono">3. DOCUMENTACIÓN ASOCIADA</span>
                      <span class="node-id mono">VÍNCULO <span class="id-tag">documental</span></span>
                    </div>
                    <div class="node-title">Documentación asociada reunida</div>
                    <p class="node-desc">Albaranes, cartas de porte y anexos agrupados por albarán</p>
                  </div>
                </div>

                <!-- 4. Continuación pendiente hacia transporte -->
                <div class="pipeline-node pipeline-node--pending" role="listitem">
                  <div class="node-track" aria-hidden="true">
                    <span class="node-icon node-icon--pending">⋯</span>
                  </div>
                  <div class="node-content node-content--pending">
                    <div class="node-meta">
                      <span class="node-label node-label--pending mono">4. CONTINUACIÓN PENDIENTE</span>
                      <span class="badge-anticipation">Hacia Fase 2</span>
                    </div>
                    <div class="node-title node-title--pending">Pendiente de datos del transporte</div>
                    <p class="node-desc node-desc--pending">Espera de confirmación de vehículo y matrícula para continuar</p>
                  </div>
                </div>

              </div>

              <!-- Metadatos de pie de blueprint -->
              <div class="blueprint-meta-bar">
                <span class="meta-item">
                  <span class="meta-label">Estado de origen:</span>
                  <span class="meta-value">Base documental lista</span>
                </span>
                <span class="meta-item">
                  <span class="meta-label">Paso siguiente:</span>
                  <span class="meta-value meta-value--amber">Datos del camión (Fase 2)</span>
                </span>
              </div>
            </div>
          </figure>
        </div>
      </article>

      <!-- FASE 2: TRANSPORTE (Pasos 04–05) -->
      <article class="macro-phase" aria-labelledby="phase-2-heading">
        <div class="macro-phase-editorial" data-reveal="editorial">
          <div class="macro-phase-badge macro-phase-badge--amber">
            <span class="phase-tag phase-tag--amber">Fase 2</span>
            <span class="phase-category phase-category--amber">Transporte</span>
          </div>
          <h3 id="phase-2-heading" class="macro-phase-title">Desfase temporal del vehículo</h3>
          <p class="macro-phase-lead">
            Los datos del camión suelen confirmarse más tarde, sin que ello deba paralizar la preparación de la carga.
          </p>

          <ol class="phase-steps-list" start="4">
            <li class="phase-step-item">
              <span class="step-num step-num--amber" aria-hidden="true">04</span>
              <div class="step-content">
                <h4 class="step-title">Detectar datos pendientes</h4>
                <p class="step-text">
                  Identificar las cargas que todavía esperan la matrícula u otros datos del vehículo.
                </p>
              </div>
            </li>
            <li class="phase-step-item">
              <span class="step-num step-num--amber" aria-hidden="true">05</span>
              <div class="step-content">
                <h4 class="step-title">Incorporar los datos recibidos</h4>
                <p class="step-text">
                  Añadir la información confirmada del transporte cuando esté disponible.
                </p>
              </div>
            </li>
          </ol>
        </div>

        <div class="macro-phase-visual" data-reveal="blueprint" data-reveal-delay="1">
          <figure class="blueprint-card blueprint-card--amber" aria-label="Esquema conceptual: Detección de matrícula pendiente para la expedición EXP-0842">
            <div class="blueprint-header">
              <div class="blueprint-title-wrap">
                <span class="blueprint-status-indicator blueprint-status-indicator--amber" aria-hidden="true"></span>
                <span class="blueprint-title">Control de asignación de transporte</span>
              </div>
              <span class="blueprint-disclaimer">Esquema conceptual · Proyecto en desarrollo</span>
            </div>

            <div class="blueprint-body">
              <div class="blueprint-slot-group">
                <div class="blueprint-meta-row">
                  <span class="meta-label">Expedición asignada:</span>
                  <span class="meta-value mono">EXP-0842</span>
                </div>

                <!-- Campo con estado pendiente destacado en ámbar -->
                <div class="blueprint-field-pending">
                  <div class="pending-field-header">
                    <span class="pending-field-label">MATRÍCULA DEL VEHÍCULO</span>
                    <span class="badge badge-amber pending-badge">
                      <span class="badge-dot" aria-hidden="true"></span>
                      <span>Pendiente de recibir</span>
                    </span>
                  </div>
                  <div class="pending-field-box">
                    <span class="pending-placeholder mono">— Matrícula pendiente de confirmación —</span>
                    <span class="pending-hint">La carga no se detiene a la espera del vehículo</span>
                  </div>
                </div>

                <!-- Asignación posterior -->
                <div class="blueprint-subsequent-slot">
                  <span class="subsequent-label">Incorporación al confirmar:</span>
                  <span class="subsequent-value">El dato se asocia a la expedición en cuanto se recibe comunicación</span>
                </div>
              </div>

              <div class="blueprint-meta-bar">
                <span class="meta-item">
                  <span class="meta-label">Estado de expedición:</span>
                  <span class="meta-value meta-value--amber">Espera activa de datos</span>
                </span>
                <span class="meta-item">
                  <span class="meta-label">Documentación base:</span>
                  <span class="meta-value">Lista en almacén</span>
                </span>
              </div>
            </div>
          </figure>
        </div>
      </article>

      <!-- FASE 3: COORDINACIÓN (Pasos 06–07) -->
      <article class="macro-phase macro-phase--last" aria-labelledby="phase-3-heading">
        <div class="macro-phase-editorial" data-reveal="editorial">
          <div class="macro-phase-badge macro-phase-badge--green">
            <span class="phase-tag phase-tag--green">Fase 3</span>
            <span class="phase-category phase-category--green">Coordinación</span>
          </div>
          <h3 id="phase-3-heading" class="macro-phase-title">Supervisión humana y registro</h3>
          <p class="macro-phase-lead">
            Cotejo final de la documentación consolidada y conservación del historial para consultas posteriores.
          </p>

          <ol class="phase-steps-list" start="6">
            <li class="phase-step-item">
              <span class="step-num step-num--green" aria-hidden="true">06</span>
              <div class="step-content">
                <h4 class="step-title">Revisar antes de preparar el DECA</h4>
                <p class="step-text">
                  Comprobar que los datos necesarios están completos mediante revisión humana.
                </p>
              </div>
            </li>
            <li class="phase-step-item">
              <span class="step-num step-num--solid" aria-hidden="true">07</span>
              <div class="step-content">
                <h4 class="step-title">Conservar el historial</h4>
                <p class="step-text">
                  Facilitar consultas posteriores con un registro ordenado de la documentación.
                </p>
              </div>
            </li>
          </ol>
        </div>

        <div class="macro-phase-visual" data-reveal="blueprint" data-reveal-delay="1">
          <figure class="blueprint-card blueprint-card--green" aria-label="Esquema conceptual: Cotejo de documentación consolidada y supervisión humana previa">
            <div class="blueprint-header">
              <div class="blueprint-title-wrap">
                <span class="blueprint-status-indicator blueprint-status-indicator--green" aria-hidden="true"></span>
                <span class="blueprint-title">Cotejo y preparación para revisión</span>
              </div>
              <span class="blueprint-disclaimer">Esquema conceptual · Proyecto en desarrollo</span>
            </div>

            <div class="blueprint-body">
              <!-- Checklist de verificación conceptual -->
              <div class="blueprint-check-list">
                <div class="check-item">
                  <span class="check-icon" aria-hidden="true">✓</span>
                  <div class="check-texts">
                    <span class="check-name">Documentación de almacén y albarán</span>
                    <span class="check-detail mono">ALB-0842 vinculada a EXP-0842</span>
                  </div>
                </div>

                <div class="check-item">
                  <span class="check-icon" aria-hidden="true">✓</span>
                  <div class="check-texts">
                    <span class="check-name">Datos del transporte incorporados</span>
                    <span class="check-detail">Información del vehículo recibida</span>
                  </div>
                </div>

                <div class="check-item check-item--human">
                  <span class="check-icon check-icon--human" aria-hidden="true">⊙</span>
                  <div class="check-texts">
                    <span class="check-name">Supervisión humana</span>
                    <span class="check-detail">Validación del responsable previa a la emisión</span>
                  </div>
                  <span class="check-badge">Paso de control</span>
                </div>
              </div>

              <!-- Resultado conceptual -->
              <div class="blueprint-result-banner">
                <span class="result-kicker">Resultado conceptual</span>
                <span class="result-title">Documentación preparada para revisión</span>
              </div>

              <!-- Referencia al historial -->
              <div class="blueprint-history-row">
                <span class="history-label">Referencia de archivo:</span>
                <span class="history-value mono">HIST-2026/0842 · Registro ordenado para consulta</span>
              </div>
            </div>
          </figure>
        </div>
      </article>

    </div>

    <!-- Síntesis editorial refinada (4 bloques con borde izquierdo en verde corporativo) -->
    <section class="synthesis-section" aria-labelledby="synthesis-title">
      <header class="synthesis-header">
        <h3 id="synthesis-title" class="synthesis-title">
          ¿Qué busca simplificar?
        </h3>
      </header>

      <div class="synthesis-grid">
        <article class="synthesis-item">
          <h4 class="synthesis-label">Control de expediciones pendientes</h4>
          <p class="synthesis-text">
            Identificar las cargas que esperan datos del transporte.
          </p>
        </article>

        <article class="synthesis-item">
          <h4 class="synthesis-label">Menor dispersión operativa</h4>
          <p class="synthesis-text">
            Reducir la búsqueda de matrículas y confirmaciones en diferentes canales.
          </p>
        </article>

        <article class="synthesis-item">
          <h4 class="synthesis-label">Anticipación en muelle</h4>
          <p class="synthesis-text">
            Detectar información ausente antes de la carga, cuando sea posible.
          </p>
        </article>

        <article class="synthesis-item">
          <h4 class="synthesis-label">Supervisión humana</h4>
          <p class="synthesis-text">
            Mantener la revisión y el criterio del responsable ante dudas o discrepancias.
          </p>
        </article>
      </div>
    </section>
  </div>
</section>

<style>
  .how-it-works-section {
    padding-block: var(--space-12);
    background-color: var(--color-bg-canvas);
    border-bottom: 1px solid var(--color-border-subtle);
    scroll-margin-top: 5.5rem;
  }

  .section-intro {
    max-width: 760px;
    margin-bottom: var(--space-10);
  }

  .disclaimer-inline {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .disclaimer-note {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  /* ---- Envoltorio de Macro-fases ---- */
  .macro-phases-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }

  .macro-phase {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .macro-phase--last {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* ---- Columna Editorial (Narrativa y pasos) ---- */
  .macro-phase-editorial {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .macro-phase-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .phase-tag {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--space-2);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--color-bg-surface-subtle);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
  }

  .phase-tag--amber {
    background-color: var(--color-accent-amber-subtle);
    color: var(--color-accent-amber-text);
    border-color: #FCD34D;
  }

  .phase-tag--green {
    background-color: rgba(4, 120, 87, 0.08);
    color: var(--color-brand-primary);
    border-color: rgba(4, 120, 87, 0.25);
  }

  .phase-category {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .phase-category--amber {
    color: var(--color-accent-amber-text);
  }

  .phase-category--green {
    color: var(--color-brand-primary);
  }

  .macro-phase-title {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .macro-phase-lead {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: var(--space-6);
  }

  /* Lista de pasos con carril vertical */
  .phase-steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .phase-steps-list::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 18px;
    bottom: 18px;
    width: 2px;
    background-color: var(--color-border-subtle);
    z-index: 0;
  }

  .phase-step-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    z-index: 1;
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-canvas);
    border: 2px solid var(--color-border-strong);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    flex-shrink: 0;
    box-shadow: 0 0 0 4px var(--color-bg-canvas);
  }

  .step-num--amber {
    background-color: var(--color-accent-amber-subtle);
    border-color: #FCD34D;
    color: var(--color-accent-amber-text);
  }

  .step-num--green {
    background-color: var(--color-bg-surface);
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }

  .step-num--solid {
    background-color: var(--color-brand-primary);
    border-color: var(--color-brand-primary);
    color: #FFFFFF;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 2px;
    min-width: 0;
    flex: 1;
  }

  .step-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-primary);
    margin: 0;
  }

  .step-text {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* ---- Microinterfaces Blueprint (Columna Visual) ---- */
  .macro-phase-visual {
    min-width: 0;
  }

  .blueprint-card {
    margin: 0;
    background-color: var(--color-bg-surface);
