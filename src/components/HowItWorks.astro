---
// src/components/HowItWorks.astro - Sección «Cómo funciona» de DECA Light
// Reconstrucción visual de alta fidelidad basada en Google Stitch y la referencia aprobada
import HowItWorksIntro from './HowItWorksIntro.astro';
import HowItWorksPaso1 from './HowItWorksPaso1.astro';
import HowItWorksPaso2 from './HowItWorksPaso2.astro';
import HowItWorksPaso3 from './HowItWorksPaso3.astro';
import HowItWorksPaso4 from './HowItWorksPaso4.astro';
import HowItWorksBeneficios from './HowItWorksBeneficios.astro';
---

<section id="como-funciona" class="how-it-works-section" aria-labelledby="how-it-works-title">
  <div class="how-it-works-container">
    <HowItWorksIntro />

    <!-- ==============================================
         FLUJO DE CUATRO PASOS (DIAGRAMA OPERATIVO)
         ============================================== -->
    <div class="flow-steps-grid" role="list" aria-label="Diagrama del proceso en 4 pasos">
      <HowItWorksPaso1 />

      <HowItWorksPaso2 />

      <HowItWorksPaso3 />

      <HowItWorksPaso4 />
    </div>

    <HowItWorksBeneficios />
  </div>
</section>

<style>
  .how-it-works-section {
      position: relative;
      padding-top: 5rem;
      padding-bottom: 5.5rem;
      background-color: var(--palette-slate-50);
      background-image:
        radial-gradient(circle at 50% 180px, rgba(167, 243, 208, 0.35) 0%, rgba(240, 253, 244, 0.15) 45%, rgba(248, 250, 252, 0) 75%);
      background-attachment: scroll;
      border-bottom: 1px solid var(--border-subtle, var(--palette-slate-200));
      scroll-margin-top: 5rem;
      overflow: hidden;
    }
  .how-it-works-container {
      width: 100%;
      max-width: 1400px;
      margin-inline: auto;
      padding-inline: 1rem;
      box-sizing: border-box;
    }
  @media (min-width: 640px) {
    .how-it-works-container {
          padding-inline: 1.5rem;
        }
  }
  @media (min-width: 1024px) {
    .how-it-works-container {
          padding-inline: 2rem;
        }
  }
  .flow-steps-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-bottom: 4.5rem;
      align-items: stretch;
    }
  @media (min-width: 640px) and (max-width: 1023px) {
    .flow-steps-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 2rem 1.75rem;
        }
  }
  @media (min-width: 1024px) {
    .flow-steps-grid {
          grid-template-columns: repeat(4, 1fr);
          gap: 1.5rem;
        }
  }
  @media (min-width: 1280px) {
    .flow-steps-grid {
          gap: 2rem;
        }
  }
</style>
