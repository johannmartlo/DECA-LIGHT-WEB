---
// src/components/HowItWorks.astro - Sección «Cómo funciona» de DECA Light (3 pasos en filas alternas)
import HowItWorksIntro from './HowItWorksIntro.astro';
import HowItWorksPaso1 from './HowItWorksPaso1.astro';
import HowItWorksPaso2 from './HowItWorksPaso2.astro';
import HowItWorksPaso3 from './HowItWorksPaso3.astro';
import HowItWorksBeneficios from './HowItWorksBeneficios.astro';
---

<section id="como-funciona" class="how-it-works-section" aria-labelledby="how-it-works-title">
  <div class="container how-it-works-container">
    <HowItWorksIntro />

    <div class="flow-steps-stack" role="list" aria-label="Proceso en 3 pasos">
      <HowItWorksPaso1 />
      <HowItWorksPaso2 />
      <HowItWorksPaso3 />
    </div>

    <HowItWorksBeneficios />
  </div>
</section>

<style>
  .how-it-works-section {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 5rem;
    background-color: var(--palette-white);
    border-bottom: 1px solid var(--color-border-subtle, var(--palette-slate-200));
    scroll-margin-top: 5rem;
  }

  .flow-steps-stack {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 900px) {
    .flow-steps-stack {
      gap: 4.5rem;
      margin-bottom: 3.5rem;
    }
  }

  @media (max-width: 900px) {
    .how-it-works-section {
      padding-top: 3.5rem;
      padding-bottom: 3.5rem;
    }
  }
</style>
