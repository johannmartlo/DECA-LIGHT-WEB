---
// src/components/HowItWorks.astro - Sección «Cómo funciona» de DECA Light
// Reconstrucción visual de alta fidelidad basada en Google Stitch y la referencia aprobada
---

<section id="como-funciona" class="how-it-works-section" aria-labelledby="how-it-works-title">
  <div class="how-it-works-container">
    <!-- ==============================================
         ENCABEZADO EDITORIAL CENTRADO
         ============================================== -->
    <header class="section-intro" data-reveal="editorial">
      <div class="eyebrow-wrap">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span class="eyebrow-text">UN PROCESO SIMPLE Y CONTROLADO</span>
      </div>

      <h2 id="how-it-works-title" class="section-title">
        De la información dispersa <br class="br-desktop" />
        a la documentación preparada
      </h2>

      <p class="section-description">
        DECA Light coordina la información del almacén y del transporte, la organiza y te ayuda a preparar la documentación de cada expedición para su revisión.
      </p>
    </header>

    <!-- ==============================================
         FLUJO DE CUATRO PASOS (DIAGRAMA OPERATIVO)
         ============================================== -->
    <div class="flow-steps-grid" role="list" aria-label="Diagrama del proceso en 4 pasos">
      <!-- --------------------------------------------
           PASO 1: Recibimos la información
           -------------------------------------------- -->
      <article class="step-card group step-1 fanned-step-1" role="listitem" data-reveal="card" data-reveal-delay="1">
        <!-- Encabezado del Paso -->
        <div class="step-header">
          <div class="step-badge-wrap">
            <span class="step-badge" aria-hidden="true">1</span>
            <div class="step-title-copy">
              <h3 class="step-title">Recibimos la información</h3>
              <p class="step-text">
                Importa albaranes, cartas de porte, CMR o añade los datos manualmente.
              </p>
            </div>
          </div>
        </div>

        <!-- Visual / Mockup del Paso 1 -->
        <div class="step-visual visual-step-1">
          <!-- Pastillas de Formatos Ilustrativos (No funcionales) -->
          <div class="source-pills-col" aria-label="Formatos ilustrativos admitidos">
            <!-- Píldora PDF -->
            <div class="format-pill pill-pdf" title="Ilustración: Importación PDF">
              <svg class="pill-icon icon-pdf" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M7 3C5.9 3 5 3.9 5 5V19C5 20.1 5.9 21 7 21H17C18.1 21 19 20.1 19 19V8L14 3H7M14 4.5L17.5 8H14V4.5M10.8 11.5C11.3 12.3 11.9 13.5 12.2 14.5C11.6 14.9 10.8 15.6 10.3 16.4C10.2 16.6 10 17.5 9.7 17.8C9.5 18 9.2 18.2 8.9 18.2C8.5 18.2 8.2 17.9 8.2 17.5C8.2 16.8 8.9 15.2 10.2 13.7C10.4 12.9 10.6 12.1 10.8 11.5M15.8 13.9C16.4 13.9 17 14.2 17.2 14.7C17.2 15 17 15.3 16.7 15.4C16.2 15.6 15.4 15.1 14.9 14.6C15.2 14.2 15.5 14 15.8 13.9Z"></path>
              </svg>
              <span class="pill-label">PDF</span>
            </div>

            <!-- Píldora CSV -->
            <div class="format-pill pill-csv" title="Ilustración: Importación CSV">
              <svg class="pill-icon icon-csv" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm1 14.5c0 .8-.7 1.5-1.5 1.5h-5c-.8 0-1.5-.7-1.5-1.5v-3c0-.8.7-1.5 1.5-1.5h5c.8 0 1.5.7 1.5 1.5v3zM14 9V3.5L18.5 8H14v1z"></path>
              </svg>
              <span class="pill-label">CSV</span>
            </div>

            <!-- Píldora Entrada Manual -->
            <div class="format-pill pill-manual" title="Ilustración: Entrada manual">
              <svg class="pill-icon icon-manual" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span class="pill-label-small">Entrada manual</span>
            </div>
          </div>

          <!-- Documentos en Abanico: CMR, Carta de Porte y Albarán -->
          <div class="fanned-docs-wrap" aria-hidden="true">
            <div class="doc-ghost card-cmr">CMR</div>
            <div class="doc-ghost card-porte">Carta de porte</div>

            <!-- Tarjeta Principal: Albarán -->
            <div class="albaran-box">
              <div class="albaran-box-header">
                <h4 class="albaran-box-title">Albarán</h4>
                <span class="status-ping-wrap">
                  <span class="ping-circle"></span>
                  <span class="ping-dot"></span>
                </span>
              </div>

              <div class="albaran-skeleton-lines">
                <span class="skel-line w-full"></span>
                <span class="skel-line w-80"></span>
              </div>

              <div class="albaran-data-table">
                <div class="table-top-row">
                  <span class="exp-code">EXP-2026-1047</span>
                  <span class="status-pill-progress">En curso</span>
                </div>
                <div class="data-pairs">
                  <div class="data-pair">
                    <span class="pair-label">Variedad</span>
                    <span class="pair-val">Tomate Rama</span>
                  </div>
                  <div class="data-pair">
                    <span class="pair-label">Cajas</span>
                    <span class="pair-val">120</span>
                  </div>
                  <div class="data-pair">
                    <span class="pair-label">Destino</span>
                    <span class="pair-val">Madrid</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Flecha de Conexión 1 -> 2 (Desktop/Tablet) -->
        <div class="flow-arrow-wrap arrow-1-2" aria-hidden="true">
          <svg class="flow-arrow-svg" viewBox="0 0 24 24" fill="none">
            <path class="flow-dashed-path" d="M14 5l7 7m0 0l-7 7m7-7H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      </article>

      <!-- --------------------------------------------
           PASO 2: Validamos y organizamos
           -------------------------------------------- -->
      <article class="step-card group step-2" role="listitem" data-reveal="card" data-reveal-delay="2">
        <!-- Encabezado del Paso -->
        <div class="step-header">
          <div class="step-badge-wrap">
            <span class="step-badge" aria-hidden="true">2</span>
            <div class="step-title-copy">
              <h3 class="step-title">Validamos y organizamos</h3>
              <p class="step-text">
                Revisamos los datos, detectamos incompletos y los organizamos por expedición.
              </p>
            </div>
          </div>
        </div>

        <!-- Visual / Mockup del Paso 2: Validación de Datos -->
        <div class="step-visual visual-step-2">
          <div class="validation-card">
            <div class="validation-card-header">
              <h4 class="validation-heading">Validación de datos</h4>
              <span class="count-tag">4/5 listos</span>
            </div>

            <ul class="validation-list">
              <li class="validation-item">
                <span class="check-icon-circle">✓</span>
                <span class="item-label">Albarán correcto</span>
              </li>
              <li class="validation-item">
                <span class="check-icon-circle">✓</span>
                <span class="item-label">Datos de carga</span>
              </li>
              <!-- Estado Pendiente Destacado con Pulso Ámbar -->
              <li class="validation-item item-pending">
                <span class="pending-icon-circle">!</span>
                <span class="item-label text-amber">Matrícula pendiente</span>
              </li>
              <li class="validation-item">
                <span class="check-icon-circle">✓</span>
                <span class="item-label">Transportista identificado</span>
              </li>
              <li class="validation-item">
                <span class="check-icon-circle">✓</span>
                <span class="item-label">Destino correcto</span>
              </li>
            </ul>

            <!-- Cuadro de Aviso Ámbar: Asincronía del Transporte -->
            <div class="pending-callout-box" role="note">
              <svg class="clock-spin-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <p class="pending-callout-text">
                La información del transporte puede llegar en otro momento.
              </p>
            </div>
          </div>
        </div>

        <!-- Flecha de Conexión 2 -> 3 (Desktop/Tablet) -->
        <div class="flow-arrow-wrap arrow-2-3" aria-hidden="true">
          <svg class="flow-arrow-svg" viewBox="0 0 24 24" fill="none">
            <path class="flow-dashed-path" d="M14 5l7 7m0 0l-7 7m7-7H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      </article>

      <!-- --------------------------------------------
           PASO 3: Coordinamos la documentación
           -------------------------------------------- -->
      <article class="step-card group step-3" role="listitem" data-reveal="card" data-reveal-delay="3">
        <!-- Encabezado del Paso -->
        <div class="step-header">
          <div class="step-badge-wrap">
            <span class="step-badge" aria-hidden="true">3</span>
            <div class="step-title-copy">
              <h3 class="step-title">Coordinamos la documentación</h3>
              <p class="step-text">
                Relacionamos la información y preparamos la documentación correspondiente a cada expedición.
              </p>
            </div>
          </div>
        </div>

        <!-- Visual / Mockup del Paso 3: Nodo Central DECA Light -->
        <div class="step-visual visual-step-3">
          <div class="hub-coordination-card">
            <!-- Emblema Central DECA Light con Halo de Respiración -->
            <div class="hub-header">
              <div class="hub-emblem animate-hub-breath" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="4" y="3" width="16" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round"></rect>
                  <path d="M8 8h8M8 12h5m-5 4h8" stroke-linecap="round"></path>
                </svg>
              </div>
              <h4 class="hub-brand-name">DECA Light</h4>
              <p class="hub-sublabel">Coordinación documental</p>
            </div>

            <!-- Filas de Estados Documentales -->
            <div class="hub-status-rows">
              <div class="hub-row">
                <div class="hub-row-label">
                  <span class="hub-row-icon icon-green" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M3 10h18M3 14h18M5 18h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                  </span>
                  <span>Datos del almacén</span>
                </div>
                <span class="check-icon-circle">✓</span>
              </div>

              <div class="hub-row">
                <div class="hub-row-label">
                  <span class="hub-row-icon icon-amber" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"></path>
                      <path d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8h4l3 4v4a1 1 0 01-1 1h-1" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span>Datos del transporte</span>
                </div>
                <span class="pending-icon-circle">!</span>
              </div>

              <div class="hub-row">
                <div class="hub-row-label">
                  <span class="hub-row-icon icon-blue" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span>Generación de documentos</span>
                </div>
                <span class="check-icon-circle">✓</span>
              </div>

              <div class="hub-row">
                <div class="hub-row-label">
                  <span class="hub-row-icon icon-emerald" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span>Preparado para revisión</span>
                </div>
                <span class="check-icon-circle">✓</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Flecha de Conexión 3 -> 4 (Desktop/Tablet) -->
        <div class="flow-arrow-wrap arrow-3-4" aria-hidden="true">
          <svg class="flow-arrow-svg" viewBox="0 0 24 24" fill="none">
            <path class="flow-dashed-path" d="M14 5l7 7m0 0l-7 7m7-7H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      </article>

      <!-- --------------------------------------------
           PASO 4: Documentación lista para revisión
           -------------------------------------------- -->
      <article class="step-card group step-4 fanned-step-4" role="listitem" data-reveal="card" data-reveal-delay="4">
        <!-- Encabezado del Paso -->
        <div class="step-header">
          <div class="step-badge-wrap">
            <span class="step-badge" aria-hidden="true">4</span>
            <div class="step-title-copy">
              <h3 class="step-title">Documentación lista para revisión</h3>
              <p class="step-text">
                Obtén el DECA y la documentación asociada organizada y lista para su revisión.
              </p>
            </div>
          </div>
        </div>

        <!-- Visual / Mockup del Paso 4: DECA y Documentos Generados -->
        <div class="step-visual visual-step-4">
          <!-- Documentos en Abanico Superiores -->
          <div class="fanned-top-docs" aria-hidden="true">
            <div class="doc-ghost card-porte-4">Carta de porte</div>
            <div class="doc-ghost card-cmr-4">CMR</div>
          </div>

          <!-- Tarjeta DECA Generada -->
          <div class="deca-output-card">
            <div class="deca-card-top">
              <span class="deca-brand-title">DECA</span>
              <span class="badge-generated">Generado</span>
            </div>

            <!-- Líneas de Previsualización Documental -->
            <div class="deca-skeleton-lines" aria-hidden="true">
              <span class="skel-line w-full"></span>
              <span class="skel-line w-90"></span>
              <span class="skel-line w-80"></span>
              <span class="skel-line w-75"></span>
            </div>

            <!-- Faja de Estado: Preparado para revisión con Shimmer -->
            <div class="ready-approval-ribbon">
              <div class="ribbon-check-row">
                <span class="ribbon-check-icon">✓</span>
                <span class="ribbon-text">Documentación preparada para revisión</span>
              </div>
              <div class="shimmer-progress-track" aria-hidden="true">
                <div class="shimmer-progress-fill animate-shimmer"></div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- ==============================================
         FRANJA INFERIOR: CUATRO BENEFICIOS OPERATIVOS
         ============================================== -->
    <footer class="benefits-section" aria-label="Beneficios operativos" data-reveal="card">
      <div class="benefits-grid">
        <!-- Beneficio 1: Menos esperas -->
        <div class="benefit-item group">
          <div class="benefit-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="benefit-copy">
            <h4 class="benefit-title">Menos esperas</h4>
            <p class="benefit-text">
              Organiza la información aunque llegue en momentos diferentes.
            </p>
          </div>
        </div>

        <!-- Beneficio 2: Menos errores -->
        <div class="benefit-item group">
          <div class="benefit-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div class="benefit-copy">
            <h4 class="benefit-title">Menos errores</h4>
            <p class="benefit-text">
              Detecta datos incompletos y dobles comprobaciones.
            </p>
          </div>
        </div>

        <!-- Beneficio 3: Más control -->
        <div class="benefit-item group">
          <div class="benefit-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <div class="benefit-copy">
            <h4 class="benefit-title">Más control</h4>
            <p class="benefit-text">
              Toda la documentación de cada expedición en un único lugar.
            </p>
          </div>
        </div>

        <!-- Beneficio 4: Proceso claro y trazable -->
        <div class="benefit-item group">
          <div class="benefit-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <div class="benefit-copy">
            <h4 class="benefit-title">Proceso claro y trazable</h4>
            <p class="benefit-text">
              Listo para su revisión y consulta cuando lo necesites.
            </p>
          </div>
        </div>
      </div>
    </footer>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN «CÓMO FUNCIONA» - ESTILOS NATIVOS SCOPED DE ALTA FIDELIDAD
     ========================================================================== */

  .how-it-works-section {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 5.5rem;
    background-color: #f8fafc;
    background-image:
      radial-gradient(circle at 50% 180px, rgba(167, 243, 208, 0.35) 0%, rgba(240, 253, 244, 0.15) 45%, rgba(248, 250, 252, 0) 75%);
    background-attachment: scroll;
    border-bottom: 1px solid var(--border-subtle, #e2e8f0);
    scroll-margin-top: 5rem;
    overflow: hidden;
  }

  .how-it-works-container {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: 1rem;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .how-it-works-container {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .how-it-works-container {
      padding-inline: 2rem;
    }
  }

  /* ==========================================================================
     ENCABEZADO EDITORIAL CENTRADO
     ========================================================================== */

  .section-intro {
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 1024px) {
    .section-intro {
      margin-bottom: 4.5rem;
    }
  }

  .eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.875rem;
    cursor: default;
  }

  .eyebrow-line {
    width: 1.5rem;
    height: 2.5px;
    background-color: #08543E;
    border-radius: 9999px;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eyebrow-wrap:hover .eyebrow-line {
    width: 2.25rem;
  }

  .eyebrow-text {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #08543E;
  }

  @media (min-width: 640px) {
    .eyebrow-text {
      font-size: 0.8125rem;
    }
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #0f172a;
    margin: 0 0 1rem 0;
    word-break: break-word;
  }

  @media (min-width: 640px) {
    .section-title {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .section-title {
      font-size: 3rem;
      line-height: 1.18;
    }
  }

  .br-desktop {
    display: none;
  }
  @media (min-width: 640px) {
    .br-desktop {
      display: inline;
    }
  }

  .section-description {
    font-size: 1rem;
    line-height: 1.65;
    color: #475569;
    max-width: 42rem;
    margin-inline: auto;
    margin-block: 0;
    word-break: break-word;
  }

  @media (min-width: 640px) {
    .section-description {
      font-size: 1.125rem;
    }
  }

  /* ==========================================================================
     GRID DE 4 PASOS
     ========================================================================== */

  .flow-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 4.5rem;
    align-items: stretch;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .flow-steps-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .flow-steps-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
