  :global(html.reveal-ready) .problem-intro.is-revealed .problem-subtitle {
    animation: problem-subtitle-in 500ms var(--ease-out) both;
    animation-delay: 220ms;
  }

  /* 2. Columna Derecha: Estados en espera */
  :global(html.reveal-ready) .problem-frictions:not(.is-revealed) .friction-item {
    opacity: 0;
    transform: translateY(14px);
    will-change: opacity, transform;
  }
  :global(html.reveal-ready) .problem-frictions:not(.is-revealed) .friction-item::before {
    opacity: 0;
    transform: scaleX(0);
    will-change: opacity, transform;
  }

  /* 2. Columna Derecha: Entrada coordinada */
  :global(html.reveal-ready) .problem-frictions.is-revealed .friction-item {
