  :global(html.reveal-ready) .problem-intro:not(.is-revealed) .problem-title,
  :global(html.reveal-ready) .problem-intro:not(.is-revealed) .problem-subtitle {
    opacity: 0;
    will-change: opacity, transform;
  }
  :global(html.reveal-ready) .problem-intro:not(.is-revealed) .section-kicker {
    transform: translateY(10px);
  }
  :global(html.reveal-ready) .problem-intro:not(.is-revealed) .problem-title {
    transform: translateY(20px);
  }
  :global(html.reveal-ready) .problem-intro:not(.is-revealed) .problem-subtitle {
    transform: translateY(16px);
  }

  /* 1. Columna Izquierda: Entrada coordinada */
  :global(html.reveal-ready) .problem-intro.is-revealed .section-kicker {
    animation: problem-kicker-in 420ms var(--ease-out) both;
    animation-delay: 0ms;
  }
  :global(html.reveal-ready) .problem-intro.is-revealed .problem-title {
