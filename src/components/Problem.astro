---
// src/components/Problem.astro - Sección «La hora punta» de DECA Light
import ProblemEditorial from './ProblemEditorial.astro';
import ProblemFricciones from './ProblemFricciones.astro';
---

<section id="el-problema" class="problem-section" aria-labelledby="problem-title">
  <div class="container problem-container">
    <div class="problem-layout">
      <ProblemEditorial />
      <ProblemFricciones />
    </div>
  </div>
</section>

<style>
  .problem-section {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 5rem;
    background-color: var(--color-bg-canvas, var(--palette-slate-50));
    border-bottom: 1px solid var(--color-border-subtle, var(--palette-slate-200));
    scroll-margin-top: 5rem;
  }

  .problem-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .problem-layout {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
    }
  }

  @media (max-width: 900px) {
    .problem-section {
      padding-top: 3.5rem;
      padding-bottom: 3.5rem;
    }
  }
</style>
