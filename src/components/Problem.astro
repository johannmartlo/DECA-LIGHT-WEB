---
// src/components/Problem.astro - Sección «El problema» de DECA Light
// Reconstrucción visual de alta fidelidad basada en Google Stitch y la referencia oficial aprobada
import ProblemEditorial from './ProblemEditorial.astro';
import ProblemFricciones from './ProblemFricciones.astro';
import ProblemBanner from './ProblemBanner.astro';
---

<section id="el-problema" class="problem-section" aria-labelledby="problem-title">
  <div class="problem-container">
    <!-- Grid Principal: Columna Editorial + Tres Momentos de Fricción -->
    <div class="problem-layout">
      <ProblemEditorial />

      <ProblemFricciones />
    </div>

    <ProblemBanner />
  </div>
</section>

<style>
  .problem-section {
      position: relative;
      padding-top: 4.5rem;
      padding-bottom: 5rem;
      background-color: var(--palette-slate-50);
      background-image:
        radial-gradient(at 0% 0%, rgba(220, 245, 233, 0.45) 0px, transparent 50%),
        radial-gradient(at 100% 20%, rgba(224, 242, 254, 0.35) 0px, transparent 45%),
        radial-gradient(at 85% 70%, rgba(254, 243, 199, 0.25) 0px, transparent 50%),
        radial-gradient(at 20% 90%, rgba(236, 253, 245, 0.4) 0px, transparent 60%);
      background-attachment: scroll;
      border-bottom: 1px solid var(--border-subtle, var(--palette-slate-200));
      scroll-margin-top: 5rem;
      overflow: hidden;
    }
  .problem-container {
      width: 100%;
      max-width: 1340px;
      margin-inline: auto;
      padding-inline: 1rem;
      box-sizing: border-box;
    }
  @media (min-width: 640px) {
    .problem-container {
          padding-inline: 1.5rem;
        }
  }
  @media (min-width: 1024px) {
    .problem-container {
          padding-inline: 2.5rem;
        }
  }
  .problem-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      align-items: start;
    }
  @media (min-width: 1024px) {
    .problem-layout {
          grid-template-columns: 4.2fr 7.8fr;
          gap: 3rem;
        }
  }
  @media (min-width: 1280px) {
    .problem-layout {
          grid-template-columns: 5fr 7fr;
          gap: 3.5rem;
        }
  }
</style>
