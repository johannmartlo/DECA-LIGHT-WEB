---
// Problem.astro - Sección «El problema»: El desfase entre preparación y transporte
// Dirección de arte: Split-Flow Editorial asimétrico (Desktop) / Cascada vertical limpia (Mobile)
// Enfoque: Transición editorial reflexiva entre el Hero (diagrama) y Cómo funciona (timeline).
---

<section id="el-problema" class="problem-section" aria-labelledby="problem-title">
  <!--
    Gestor de revelados al hacer scroll (Scroll Reveals - Fase 2A).
    Idempotente: se ejecuta una sola vez aunque esté presente en varios componentes.
    Anti-FOUC sincrónico: comprueba elementos ya visibles antes de activar la compuerta reveal-ready.
  -->
  <script is:inline>
    (function () {
      if (window.__decaRevealInit) return;
      window.__decaRevealInit = true;

      function initReveal() {
        try {
          var motionOk = window.matchMedia && window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
          var ioOk = 'IntersectionObserver' in window;
          var cssOk = window.CSS && CSS.supports && CSS.supports('transform', 'translate3d(0, 0, 0)');

          if (!motionOk || !ioOk || !cssOk) return;

          var revealElements = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
          if (revealElements.length === 0) return;

          var pendingCount = 0;
          var thresholdHeight = window.innerHeight * 0.92;

          // Fase sincrónica anti-FOUC: revelar inmediatamente elementos en viewport o por encima del pliegue
          for (var i = 0; i < revealElements.length; i++) {
            var el = revealElements[i];
            var rect = el.getBoundingClientRect();
            if (rect.top < thresholdHeight) {
              el.classList.add('is-revealed');
            } else {
              pendingCount++;
            }
          }

          // Activar compuerta global en <html>
          document.documentElement.classList.add('reveal-ready');

          if (pendingCount === 0) return;

          var observer = new IntersectionObserver(function (entries) {
            for (var j = 0; j < entries.length; j++) {
              var entry = entries[j];
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
                pendingCount--;
                if (pendingCount <= 0) {
                  observer.disconnect();
                }
              }
            }
          }, {
            threshold: 0.12,
            rootMargin: '0px 0px -8% 0px'
          });

          for (var k = 0; k < revealElements.length; k++) {
            var item = revealElements[k];
            if (!item.classList.contains('is-revealed')) {
              observer.observe(item);
            }
          }
        } catch (err) {
          document.documentElement.classList.remove('reveal-ready');
          var all = document.querySelectorAll('[data-reveal]');
          for (var n = 0; n < all.length; n++) {
            all[n].classList.add('is-revealed');
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal, { once: true });
      } else {
        initReveal();
      }
    })();
  </script>

  <div class="container">
    <div class="problem-layout">
      <!-- Columna izquierda: Tesis y contexto (Sticky en desktop) -->
      <header class="problem-intro" data-reveal="problem-intro">
        <span class="section-kicker">EL RETO OPERATIVO EN MUELLE</span>
        <h2 id="problem-title" class="problem-title">
          La carga puede estar lista antes que los datos del transporte.
        </h2>
        <p class="problem-subtitle">
          La preparación de la mercancía y la recepción de la información del vehículo no siempre avanzan al mismo ritmo. Cuando los datos llegan después, el equipo administrativo debe reunirlos y relacionarlos con la expedición correspondiente.
        </p>
      </header>

      <!-- Columna derecha: Tres momentos de fricción operativa (Editorial abierto) -->
      <div class="problem-frictions" role="list" data-reveal="problem-frictions">
        <!-- Fricción 01 -->
        <article class="friction-item" role="listitem">
          <div class="friction-meta">
            <span class="friction-index">01 — DESFASE TEMPORAL</span>
          </div>
          <h3 class="friction-title">La mercancía está preparada, pero falta información</h3>
          <p class="friction-description">
            Los palés pueden estar pesados y listos para cargar mientras se espera la matrícula o la confirmación del transportista.
          </p>
        </article>

        <!-- Fricción 02 -->
        <article class="friction-item" role="listitem">
          <div class="friction-meta">
            <span class="friction-index">02 — CANALES DISPERSOS</span>
          </div>
          <h3 class="friction-title">Los datos llegan por distintas vías</h3>
          <p class="friction-description">
            Matrículas y confirmaciones pueden recibirse por teléfono, correo o mensajería, lo que obliga a reunir la información.
          </p>
        </article>

        <!-- Fricción 03 -->
        <article class="friction-item" role="listitem">
          <div class="friction-meta">
            <span class="friction-index">03 — PRESIÓN ADMINISTRATIVA</span>
          </div>
          <h3 class="friction-title">La información debe cuadrar antes de la salida</h3>
          <p class="friction-description">
            El equipo necesita relacionar los datos del vehículo con la documentación de la carga y revisar que todo corresponda a la expedición correcta.
          </p>
        </article>
      </div>
    </div>

    <!-- Cierre editorial: Pull-Quote destacada -->
    <aside class="problem-quote-wrap" aria-label="Reflexión sobre el reto operativo" data-reveal="problem-quote">
      <blockquote class="problem-quote">
        <p class="quote-text">
          El reto no es únicamente generar un documento. Es coordinar la información de la expedición con los datos del transporte que llegan después.
        </p>
        <footer class="quote-clarification">
          El enfoque de DECA Light: abordar el punto de encuentro operativo entre el almacén y el transporte.
        </footer>
      </blockquote>
    </aside>
  </div>
</section>

<style>
