---
// src/components/TodoElMuelle.astro — Sección «Todo el muelle, resuelto» (Tramo 4 v2, v3-premium)
---

<section class="sec" id="que-incluye" aria-labelledby="todo-el-muelle-title">
  <div class="w">
    <div class="eb">TODO EL MUELLE, RESUELTO</div>
    <h2 id="todo-el-muelle-title">
      Los imprevistos del muelle <span>ya tienen su botón.</span>
    </h2>

    <div class="bento">
      <!-- 1. Foto (8 col) -->
      <article class="c s8 photo muelle-card" style="--card-idx: 0">
        <div class="bg">
          <picture class="bg-picture">
            <img
              src="/img/camion-muelle.webp"
              alt="Camión refrigerado cargando en el muelle al amanecer"
              width="1600"
              height="900"
              loading="lazy"
              decoding="async"
              class="bg-img"
            />
          </picture>
        </div>

        <div class="glass" aria-hidden="true">
          <div class="r">
            <span>DeCA · versión 2</span>
            <span class="chip ch-e">Emitido</span>
          </div>
          <div class="pl"><s>4821 DEA</s>→ 7390 KLM</div>
          <div class="q">
            <div class="qr">
              <i></i><i></i><i></i><i class="o"></i><i></i>
              <i></i><i class="o"></i><i></i><i></i><i class="o"></i>
              <i></i><i></i><i class="o"></i><i></i><i></i>
              <i class="o"></i><i></i><i></i><i></i><i class="o"></i>
              <i></i><i class="o"></i><i></i><i></i><i></i>
            </div>
            Mismo QR. El conductor no hace nada.
          </div>
        </div>

        <h3>¿Cambia la tractora a última hora?</h3>
        <p>Lo modificas con el motivo y el QR que ya lleva el conductor sigue valiendo.</p>
      </article>

      <!-- 2. Cero duplicados (4 col) -->
      <article class="c s4 mint muelle-card" style="--card-idx: 1">
        <h3>Importas el mismo informe dos veces.</h3>
        <p>Ni cargas, ni matrículas, ni DeCA repetidos.</p>
        <div class="huge" aria-hidden="true">0<small>duplicados</small></div>
      </article>

      <!-- 3. Mañana y tarde (4 col) -->
      <article class="c s4 soft muelle-card" style="--card-idx: 2">
        <h3>Un camión por la mañana y otro por la tarde.</h3>
        <p>Cada uno con su matrícula.</p>
        <div class="tl" aria-hidden="true">
          <div class="tr">
            <span><span class="h">MAÑANA</span>Frío Demo · 4 cargas</span>
            <span class="pl2">4821 DEA</span>
          </div>
          <div class="tr">
            <span><span class="h">TARDE</span>Frío Demo · 2 cargas</span>
            <span class="chip ch-m">Falta matrícula</span>
          </div>
        </div>
      </article>

      <!-- 4. Aprende (4 col) -->
      <article class="c s4 soft muelle-card" style="--card-idx: 3">
        <h3>Tu ERP escribe raro al transportista.</h3>
        <p>Lo asignas una vez y lo aprende.</p>
        <div class="alias" aria-hidden="true">
          <div class="a">TTES. EJEMPLO S.L.</div>
          <div class="b">Transportes Ejemplo <span class="chip ch-l">Aprendido</span></div>
        </div>
      </article>

      <!-- 5. Estados (4 col) -->
      <article class="c s4 dark muelle-card" style="--card-idx: 4">
        <h3>Otro transportista, un viaje que no sale o recoge el cliente.</h3>
        <p>Sustituir, anular o «Sin DeCA». Todo queda registrado.</p>
        <div class="stack" aria-hidden="true">
          <span class="chip ch-g">Sustituido por DeCA-2026-000418</span>
          <span class="chip ch-r">Anulado · enlace cerrado</span>
          <span class="chip ch-l">Sin DeCA · transporte del cliente</span>
        </div>
      </article>

      <!-- 6. Normativa (12 col) -->
      <div class="spec muelle-card" id="normativa" style="--card-idx: 5">
        <div>
          <h3>Lo que pide el DeCA electrónico, de serie.</h3>
          <p>Orden FOM/2861/2012 y Resolución de 5 de junio de 2026. Y tus datos, donde tienen que estar.</p>
          <a href="/guia-deca">Lee la guía del DeCA →</a>
        </div>
        <div class="facts">
          <div class="f">
            <b>PDF + QR</b>
            <span>Nativo, con descarga directa y sin contraseña</span>
          </div>
          <div class="f">
            <b>7 días</b>
            <span>De enlace activo después de terminar el transporte</span>
          </div>
          <div class="f">
            <b>UE</b>
            <span>Servidores en la Unión Europea</span>
          </div>
          <div class="f">
            <b>Diarias</b>
            <span>Copias de seguridad cifradas</span>
          </div>
        </div>
      </div>
    </div>

    <div class="no">
      <h4>Lo que ya no tienes que hacer</h4>
      <div aria-hidden="true">
        <span>cambiar de ERP</span>
        <span>instalar nada</span>
        <span>teclear la matrícula en cada albarán</span>
        <span>un formulario por DeCA</span>
        <span>registrar a los conductores</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const prefersNoPreference =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    if (!prefersNoPreference || !('IntersectionObserver' in window)) {
      return;
    }

    const section = document.getElementById('que-incluye');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#que-incluye .muelle-card'));
    if (!section || cards.length === 0) return;

    section.classList.add('muelle-reveal-ready');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            cards.forEach((card) => card.classList.add('is-visible'));
            observer.disconnect();
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );

    observer.observe(section);
  });
</script>

<style>
  .sec {
    padding: 140px 24px;
    background: var(--palette-white, #FFFFFF);
    color: var(--palette-slate-900, #0F172A);
    font-family: var(--font-sans);
  }

  .w {
    max-width: 1200px;
    margin: 0 auto;
  }

  .eb {
    font-size: 13px;
    letter-spacing: 0.14em;
    font-weight: 600;
    color: var(--palette-emerald-700, #047857);
    text-align: center;
  }

  h2 {
    margin: 18px auto 0;
    font-size: 64px;
    line-height: 1.02;
    letter-spacing: -0.05em;
    font-weight: 700;
    max-width: 900px;
    text-align: center;
    color: var(--palette-slate-900, #0F172A);
  }

  h2 span {
    background: linear-gradient(0deg, var(--palette-slate-400, #94A3B8), var(--palette-slate-400, #94A3B8));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bento {
    margin-top: 72px;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(0, auto);
    gap: 20px;
  }

  .c {
    position: relative;
    overflow: hidden;
    border-radius: 32px;
    padding: 40px;
    min-height: 380px;
    display: flex;
    flex-direction: column;
  }

  .c h3 {
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 700;
    max-width: 460px;
    color: inherit;
  }

  .c p {
    margin-top: 12px;
    font-size: 17px;
    line-height: 1.5;
    max-width: 420px;
  }

  .s8 { grid-column: span 8; }
  .s4 { grid-column: span 4; }
  .s6 { grid-column: span 6; }
  .s12 { grid-column: span 12; }

  /* 1. Foto */
  .photo {
    color: var(--palette-white, #FFFFFF);
    min-height: 560px;
    justify-content: flex-end;
    background: #022019;
  }

  .photo .bg {
    position: absolute;
    inset: 0;
  }

  .photo .bg-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo .bg-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  .photo .bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(2, 32, 25, 0.05) 0%,
      rgba(2, 32, 25, 0.25) 45%,
      rgba(2, 32, 25, 0.88) 100%
    );
  }

  .photo > * {
    position: relative;
  }

  .photo h3 {
    color: var(--palette-white, #FFFFFF);
  }

  .photo p {
    color: rgba(255, 255, 255, 0.78);
  }

  .photo .glass {
    position: absolute;
    top: 36px;
    right: 36px;
    width: 300px;
    padding: 20px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: var(--palette-slate-900, #0F172A);
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.5);
  }

  .glass .r {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--palette-slate-500, #64748B);
  }

  .glass .pl {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 22px;
  }

  .glass .pl s {
    font-size: 15px;
    color: var(--palette-slate-400, #94A3B8);
    font-weight: 500;
  }

  .glass .q {
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--palette-emerald-700, #047857);
  }

  .qr {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2px;
  }

  .qr i {
    background: var(--palette-slate-900, #0F172A);
    display: block;
  }

  .qr i.o {
    background: transparent;
  }

  .chip {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.25;
  }

  .chip::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: currentColor;
    flex-shrink: 0;
  }

  .ch-l { background: var(--palette-emerald-50, #ECFDF5); color: var(--palette-emerald-700, #047857); }
  .ch-m { background: var(--palette-amber-100, #FEF3C7); color: var(--palette-amber-800, #92400E); }
  .ch-e { background: var(--color-status-issued-bg, #DBEAFE); color: var(--color-status-issued-text, #1D4ED8); }
  .ch-r { background: var(--color-status-review-bg, #FEE2E2); color: var(--color-status-review-text, #B91C1C); }
  .ch-g { background: var(--palette-slate-100, #F1F5F9); color: var(--palette-slate-600, #475569); }

  /* 2. Cero duplicados */
  .mint {
    background: linear-gradient(160deg, var(--palette-emerald-50, #ECFDF5) 0%, var(--palette-emerald-100, #D1FAE5) 100%);
  }

  .mint p {
    color: var(--palette-emerald-800, #065F46);
  }

  .huge {
    margin-top: auto;
    font-size: 200px;
    line-height: 0.8;
    font-weight: 700;
    letter-spacing: -0.08em;
    color: var(--palette-emerald-700, #047857);
  }

  .huge small {
    display: block;
    font-size: 20px;
    letter-spacing: 0;
    font-weight: 600;
    color: var(--palette-emerald-800, #065F46);
    margin-top: 14px;
    line-height: 1.2;
  }

  /* 3. Mañana y tarde */
  .soft {
    background: var(--palette-slate-50, #F8FAFC);
    box-shadow: inset 0 0 0 1px var(--palette-slate-200, #E2E8F0);
  }

  .soft p {
    color: var(--palette-slate-600, #475569);
  }

  .tl {
    margin-top: auto;
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 16px 18px;
    background: var(--palette-white, #FFFFFF);
    border-radius: 16px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05), 0 8px 24px -12px rgba(15, 23, 42, 0.15);
    font-size: 15px;
    line-height: 1.35;
  }

  .tr .h {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--palette-slate-400, #94A3B8);
    font-weight: 600;
    display: block;
  }

  .pl2 {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 14px;
    border: 1.5px solid var(--palette-slate-900, #0F172A);
    border-radius: 7px;
    padding: 4px 9px 4px 16px;
    position: relative;
    line-height: 1.3;
  }

  .pl2::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 8px;
    background: var(--palette-emerald-700, #047857);
    border-radius: 5px 0 0 5px;
  }

  /* 4. Aprende */
  .alias {
    margin-top: auto;
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
  }

  .alias .a {
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--palette-white, #FFFFFF);
    box-shadow: 0 8px 24px -12px rgba(15, 23, 42, 0.18);
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--palette-slate-500, #64748B);
  }

  .alias .b {
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--palette-slate-900, #0F172A);
    color: var(--palette-white, #FFFFFF);
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  /* 5. Estados */
  .dark {
    background: #04342A;
    color: var(--palette-white, #FFFFFF);
  }

  .dark h3 {
    color: var(--palette-white, #FFFFFF);
  }

  .dark p {
    color: rgba(255, 255, 255, 0.72);
  }

  .stack {
    margin-top: auto;
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .stack .chip {
    font-size: 15px;
    padding: 9px 16px;
  }

  /* 6. Normativa */
  .spec {
    grid-column: span 12;
    border-radius: 32px;
    padding: 48px;
    background: var(--palette-white, #FFFFFF);
    box-shadow: inset 0 0 0 1px var(--palette-slate-200, #E2E8F0);
    display: grid;
    grid-template-columns: 1.1fr 2fr;
    gap: 48px;
    align-items: center;
  }

  .spec h3 {
    font-size: 30px;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--palette-slate-900, #0F172A);
  }

  .spec p {
    margin-top: 12px;
    color: var(--palette-slate-600, #475569);
    font-size: 16px;
    line-height: 1.5;
  }

  .spec a {
    display: inline-block;
    margin-top: 18px;
    color: var(--palette-emerald-700, #047857);
    font-weight: 600;
    text-decoration: none;
  }

  .spec a:hover {
    text-decoration: underline;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .f b {
    display: block;
    font-size: 34px;
    letter-spacing: -0.04em;
    color: var(--palette-emerald-700, #047857);
    line-height: 1;
  }

  .f span {
    display: block;
    margin-top: 10px;
    font-size: 14.5px;
    color: var(--palette-slate-600, #475569);
    line-height: 1.4;
  }

  .no {
    margin-top: 56px;
    text-align: center;
  }

  .no div {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .no span {
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--palette-slate-50, #F8FAFC);
    font-size: 15px;
    color: var(--palette-slate-500, #64748B);
    text-decoration: line-through;
  }

  .no h4 {
    font-size: 15px;
    color: var(--palette-slate-600, #475569);
    font-weight: 600;
    letter-spacing: 0;
  }

  /* Entrada escalonada suave al hacer scroll (opacidad + 16 px hacia arriba, 60 ms entre tarjetas) */
  @media (prefers-reduced-motion: no-preference) {
    .sec.muelle-reveal-ready .muelle-card:not(.is-visible) {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
    }

    .sec.muelle-reveal-ready .muelle-card.is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      transition:
        opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(var(--card-idx, 0) * 60ms);
    }
  }

  /* Entre 901 px y 1120 px (p. ej. 1024 px): ajustes sutiles de padding y tamaño de chips para que nada se corte ni desborde */
  @media (max-width: 1120px) and (min-width: 901px) {
    .c {
      padding: 28px;
    }

    .c h3 {
      font-size: 25px;
    }

    .stack .chip {
      font-size: 13px;
      padding: 8px 12px;
    }

    .tr {
      padding: 14px;
      font-size: 14px;
    }

    .alias .b {
      padding: 12px 14px;
      font-size: 14px;
    }

    .huge {
      font-size: 160px;
    }
  }

  @media (max-width: 900px) {
    .sec {
      padding: 88px 16px;
    }

    h2 {
      font-size: 38px;
    }

    .s8, .s4, .s6 {
      grid-column: span 12;
    }

    .c {
      padding: 28px;
      min-height: 300px;
      border-radius: 24px;
    }

    .photo {
      min-height: 460px;
    }

    .photo .glass {
      position: relative;
      top: auto;
      right: auto;
      width: 100%;
      margin-bottom: 24px;
    }

    .huge {
      font-size: 140px;
    }

    .spec {
      grid-template-columns: 1fr;
      padding: 28px;
      gap: 28px;
      border-radius: 24px;
    }

    .facts {
      grid-template-columns: 1fr 1fr;
    }

    .stack .chip {
      font-size: 14px;
      padding: 8px 14px;
    }
  }
</style>
