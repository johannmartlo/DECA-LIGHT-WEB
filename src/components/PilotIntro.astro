---
// PilotIntro.astro — Rejilla de 2 columnas de la sección «Primer mes gratis» (Tramo 5, v3-premium)
import PilotIntroEditorial from './PilotIntroEditorial.astro';
import PilotIntroVisual from './PilotIntroVisual.astro';
---

<div class="mg">
  <PilotIntroEditorial />
  <PilotIntroVisual />
</div>

<style>
  .mg {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 72px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .mg {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
