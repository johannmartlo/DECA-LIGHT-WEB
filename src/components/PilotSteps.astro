---
// PilotSteps.astro — Tres pasos del primer mes gratis (bajo el texto izquierdo)
---

<ol class="steps-list" aria-label="Pasos de puesta en marcha">
  <li class="step-row">
    <span class="step-num" aria-hidden="true">1</span>
    <p class="step-title">Demostración de 30 minutos con tu operativa.</p>
  </li>

  <li class="step-row">
    <span class="step-num" aria-hidden="true">2</span>
    <p class="step-title">Configuramos tu cuenta.</p>
  </li>

  <li class="step-row">
    <span class="step-num" aria-hidden="true">3</span>
    <p class="step-title">Un mes gratis con tus cargas reales.</p>
  </li>
</ol>

<style>
  .steps-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border-subtle, var(--palette-slate-200));
  }

  .step-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.9375rem 0;
    border-bottom: 1px solid var(--color-border-subtle, var(--palette-slate-200));
  }

  .step-num {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-brand-primary, var(--palette-emerald-700));
    background-color: var(--palette-emerald-50);
    border: 1px solid var(--palette-emerald-200);
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-text-primary, var(--palette-slate-900));
  }
</style>
