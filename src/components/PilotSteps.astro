---
// PilotSteps.astro — Tres pasos del primer mes gratis
---

<div class="steps-grid" role="list" aria-label="Pasos de puesta en marcha">
  <article class="step-card" role="listitem" data-reveal="card" data-reveal-delay="1">
    <span class="step-num font-mono" aria-hidden="true">01</span>
    <p class="step-title">Demostración de 30 minutos con tu operativa.</p>
  </article>

  <article class="step-card" role="listitem" data-reveal="card" data-reveal-delay="2">
    <span class="step-num font-mono" aria-hidden="true">02</span>
    <p class="step-title">Configuramos tu cuenta.</p>
  </article>

  <article class="step-card" role="listitem" data-reveal="card" data-reveal-delay="3">
    <span class="step-num font-mono" aria-hidden="true">03</span>
    <p class="step-title">Un mes gratis con tus cargas reales.</p>
  </article>
</div>

<style>
  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .steps-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .step-card {
    background-color: var(--color-bg-canvas, var(--palette-slate-50));
    border: 1px solid var(--color-border-subtle, var(--palette-slate-200));
    border-radius: var(--radius-lg, 10px);
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-brand-primary, var(--palette-emerald-700));
    flex-shrink: 0;
  }

  .step-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-text-primary, var(--palette-slate-900));
  }
</style>
