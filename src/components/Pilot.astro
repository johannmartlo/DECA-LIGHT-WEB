---
// src/components/Pilot.astro - Sección 04 «Programa piloto» de DECA Light
// Reconstrucción visual de alta fidelidad basada en Google Stitch y la referencia aprobada
---

<section id="piloto" class="pilot-section" aria-labelledby="pilot-heading">
  <!-- Ancla secundaria de compatibilidad -->
  <div id="programa-piloto" class="anchor-target" aria-hidden="true"></div>

  <!-- Luces ambientales sutiles de fondo -->
  <div class="ambient-glow glow-top" aria-hidden="true"></div>
  <div class="ambient-glow glow-mid" aria-hidden="true"></div>
  <div class="ambient-glow glow-bottom" aria-hidden="true"></div>

  <div class="pilot-container">
    <!-- ==============================================
         BLOQUE 1: INTRODUCCIÓN Y CANVAS DE EXPEDICIÓN
         ============================================== -->
    <div class="pilot-hero-grid">
      <!-- Columna Izquierda: Editorial y Propuesta de Valor -->
      <div class="editorial-col" data-reveal="editorial">
        <!-- Eyebrow Kicker -->
        <div class="eyebrow-wrap">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span class="eyebrow-text">PROGRAMA PILOTO</span>
        </div>

        <!-- Titular Principal -->
        <h2 id="pilot-heading" class="pilot-heading">
          Llevemos DECA Light a la operativa real de tu almacén.
        </h2>

        <!-- Párrafo Descriptivo -->
        <p class="pilot-description">
          Queremos conocer cómo se coordina la documentación en tu empresa y explorar cómo DECA Light puede ayudarte a organizar la información de cada expedición.
        </p>

        <!-- Cuadrícula de 4 Puntos de Confianza -->
        <div class="trust-grid" role="list" aria-label="Principios del programa piloto">
          <!-- Item 1: Entorno real -->
          <article class="trust-card group" role="listitem">
            <div class="trust-icon-box" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3L22 4"></path>
                <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">Entorno real</h3>
              <p class="trust-text">Pruebas con expediciones de almacén reales.</p>
            </div>
          </article>

          <!-- Item 2: Escucha activa -->
          <article class="trust-card group" role="listitem">
            <div class="trust-icon-box" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                <path d="M8 9h8"></path>
                <path d="M8 13h5"></path>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">Escucha activa</h3>
              <p class="trust-text">Feedback directo con los jefes de tráfico.</p>
            </div>
          </article>

          <!-- Item 3: Mejora continua -->
          <article class="trust-card group" role="listitem">
            <div class="trust-icon-box" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">Mejora continua</h3>
              <p class="trust-text">Ajustes según las incidencias del día a día.</p>
            </div>
          </article>

          <!-- Item 4: Sector hortofrutícola -->
          <article class="trust-card group" role="listitem">
            <div class="trust-icon-box" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="M9 12l2 2 4-4"></path>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">Sector hortofrutícola</h3>
              <p class="trust-text">Diseñado por y para empresas agrícolas.</p>
            </div>
          </article>
        </div>

        <!-- Micro-barra informativa de estado sobria -->
        <div class="status-microbar" role="status">
          <span class="ping-indicator" aria-hidden="true">
            <span class="ping-circle"></span>
            <span class="ping-core"></span>
          </span>
          <span class="microbar-text">Fase actual: Contacto con almacenes y operadores del sector hortofrutícola</span>
        </div>
      </div>

      <!-- Columna Derecha: Canvas Visual de Expedición y Formulario -->
      <div class="visual-col" data-reveal="card">
        <div class="canvas-container group-docs">
          <!-- Silueta decorativa sutil de almacén en segundo plano -->
          <div class="warehouse-silhouette" aria-hidden="true">
            <svg viewBox="0 0 400 240" fill="none" xmlns="http://www.w3.org/2000/svg" class="silhouette-svg">
              <path d="M0 180h400v60H0v-60z" fill="#08543E" fill-opacity="0.03" />
              <rect x="40" y="80" width="120" height="100" rx="4" fill="#08543E" fill-opacity="0.04" />
              <rect x="55" y="95" width="90" height="85" fill="#08543E" fill-opacity="0.03" />
              <line x1="55" y1="110" x2="145" y2="110" stroke="#08543E" stroke-opacity="0.08" stroke-width="2" stroke-dasharray="4 4" />
              <line x1="55" y1="130" x2="145" y2="130" stroke="#08543E" stroke-opacity="0.08" stroke-width="2" stroke-dasharray="4 4" />
              <line x1="55" y1="150" x2="145" y2="150" stroke="#08543E" stroke-opacity="0.08" stroke-width="2" stroke-dasharray="4 4" />
              <rect x="200" y="90" width="160" height="90" rx="6" fill="#08543E" fill-opacity="0.04" />
              <rect x="330" y="120" width="40" height="60" rx="4" fill="#08543E" fill-opacity="0.05" />
              <circle cx="240" cy="180" r="14" fill="#08543E" fill-opacity="0.09" />
              <circle cx="310" cy="180" r="14" fill="#08543E" fill-opacity="0.09" />
              <circle cx="355" cy="180" r="12" fill="#08543E" fill-opacity="0.09" />
            </svg>
          </div>

          <!-- Nodos Superiores: Expedición & Tarjetas de Datos -->
          <div class="nodes-top-row">
            <!-- Nodo A: Tarjeta Principal Expedición -->
            <div class="expedition-card">
              <div class="expedition-header">
                <div class="expedition-id-wrap">
                  <div class="expedition-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M16.5 9.4 7.55 4.24a1.78 1.78 0 0 0-2.5 1.55v12.42a1.78 1.78 0 0 0 2.5 1.55L16.5 14.6a1.78 1.78 0 0 0 0-3.2z"></path>
                      <polyline points="3.29 7 12 12 20.71 7"></polyline>
                      <line x1="12" y1="22" x2="12" y2="12"></line>
                    </svg>
                  </div>
                  <div>
                    <span class="node-label">EXPEDICIÓN</span>
                    <p class="node-code">EXP-2026-1047</p>
                  </div>
                </div>
                <span class="status-pill status-amber">En preparación</span>
              </div>

              <div class="expedition-details">
                <div class="detail-row">
                  <span class="detail-label">Cajas</span>
                  <span class="detail-value">120 uds</span>
                </div>
                <div class="detail-row">
                  <span class="detail-label">Variedad</span>
                  <span class="detail-value">Tomate Rama</span>
                </div>
                <div class="detail-row">
                  <span class="detail-label">Destino</span>
                  <span class="detail-value">Madrid (Merca)</span>
                </div>
              </div>
            </div>

            <!-- Nodo B: Stack de Micro-Tarjetas de Almacén y Transporte -->
            <div class="micro-nodes-col">
              <!-- Micro Card: Datos del Almacén -->
              <div class="micro-node-card">
                <div class="micro-node-left">
                  <div class="micro-icon-box bg-emerald" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 21h18"></path>
                      <path d="M5 21V7l8-4v18"></path>
                      <path d="M19 21V11l-6-3"></path>
                      <path d="M9 9h1"></path>
                      <path d="M9 13h1"></path>
                      <path d="M9 17h1"></path>
                    </svg>
                  </div>
                  <div class="micro-node-info">
                    <h4 class="micro-node-title">Datos del almacén</h4>
                    <p class="micro-node-sub">Albaranes importados y cotejados</p>
                  </div>
                </div>
                <div class="check-pill" aria-label="Completado">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
              </div>

              <!-- Micro Card: Datos del Transporte -->
              <div class="micro-node-card micro-node-transport">
                <div class="transport-top">
                  <div class="micro-node-left">
                    <div class="micro-icon-box bg-amber" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                      </svg>
                    </div>
                    <div class="micro-node-info">
                      <h4 class="micro-node-title">Datos del transporte</h4>
                      <p class="micro-node-sub">Tráiler frigorífico</p>
                    </div>
                  </div>
                  <span class="badge-amber-pulse">Pendiente</span>
                </div>
                <div class="transport-bottom">
                  <span class="transport-label">Matrícula tractora:</span>
                  <span class="transport-val">--- Pendiente de chofer ---</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Nivel Medio: Abanico Documental Físico y Digital -->
          <div class="fanned-stack-area">
            <!-- Trazo Conector SVG Continuo Animado -->
            <svg class="flow-connector-svg" fill="none" viewBox="0 0 600 60" preserveAspectRatio="none" aria-hidden="true">
              <path class="flow-dash-anim" d="M 80 15 Q 300 -10, 520 20" stroke="#10B981" stroke-width="2.5" stroke-linecap="round"></path>
            </svg>

            <!-- Contenedor del Abanico Documental Con Protrusión Fiel a la Referencia -->
            <div class="doc-stack-wrapper">
              <!-- Hoja Trasera: CMR Internacional -->
              <div class="doc-stack-item doc-sheet-back">
                <div class="sheet-head">
                  <span class="sheet-title">CMR INTERNACIONAL</span>
                  <span class="sheet-num">#CMR-982</span>
                </div>
                <div class="sheet-lines" aria-hidden="true">
                  <div class="sheet-line line-75"></div>
                  <div class="sheet-line line-50"></div>
                </div>
                <span class="sheet-foot">Copia transportista</span>
              </div>

              <!-- Hoja Intermedia: Carta de Porte -->
              <div class="doc-stack-item doc-sheet-mid">
                <div class="sheet-head">
                  <span class="sheet-title">CARTA DE PORTE</span>
                  <span class="sheet-num">ES-ES-771</span>
                </div>
                <div class="sheet-lines" aria-hidden="true">
                  <div class="sheet-line line-80"></div>
                  <div class="sheet-line line-65"></div>
                </div>
                <span class="sheet-foot">Validado en muelle</span>
              </div>

              <!-- Hoja Frontal: DECA Light Expediente Centralizado -->
              <div class="doc-stack-item doc-sheet-front">
                <div class="sheet-head">
                  <div class="brand-inline">
                    <span class="brand-bold">DECA</span>
                    <span class="brand-light">Light</span>
                  </div>
                  <span class="sheet-tag">ALBARÁN 4081</span>
                </div>

                <div class="sheet-body">
                  <div class="sheet-lead">Expediente Centralizado</div>
                  <div class="sheet-status">
                    <span class="pulse-dot-green" aria-hidden="true"></span>
                    <span>Documentación digital lista</span>
                  </div>
                </div>

                <div class="progress-track" aria-hidden="true">
                  <div class="shimmer-active progress-fill"></div>
                </div>
              </div>
            </div>

            <!-- Badge Flotante de Validación con Shimmer -->
            <div class="badge-shimmer validation-pill">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="pill-icon-green" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>Documentación lista para revisión y salida</span>
            </div>
          </div>

          <!-- Parte Inferior: Formulario de Interés Ilustrativo -->
          <div id="form-piloto" class="interest-form-card">
            <div class="form-card-header">
              <div class="mail-icon-box" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div>
                <h4 class="form-card-title">¿Quieres conocer DECA Light en tu almacén?</h4>
                <p class="form-card-sub">Recogemos el interés de profesionales para coordinar el próximo despliegue.</p>
              </div>
            </div>

            <form class="demo-form" id="pilot-interest-form" novalidate action="/api/pilot" data-endpoint="/api/pilot" method="POST">
              <!-- Campo Honeypot invisible para protección pasiva anti-bot -->
              <input
                type="text"
                name="_gotcha"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                style="position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none;"
              />

              <!-- Clave de idempotencia única por sesión de formulario -->
              <input type="hidden" name="idempotency_key" id="pilot-idempotency-key" value="" />

              <div class="inputs-row">
                <div class="input-field-wrap">
                  <label for="company-name" class="input-label">Nombre de la empresa</label>
                  <input
                    type="text"
                    id="company-name"
                    name="company"
                    class="form-text-input"
                    placeholder="Ej. Frutas del Sureste S.L."
                    required
                  />
                </div>

                <div class="input-field-wrap">
                  <label for="company-email" class="input-label">Correo electrónico</label>
                  <input
                    type="email"
                    id="company-email"
                    name="email"
                    class="form-text-input"
                    placeholder="responsable@almacen.com"
                    required
                  />
                </div>
              </div>

              <!-- Cláusula informativa de primera capa (RGPD art. 13 / LOPDGDD art. 11) -->
              <div class="form-privacy-box">
                <p class="privacy-box-text">
                  <strong>Información de protección de datos:</strong> Responsable: titular promotor de DECA Light. Finalidad: tramitar la solicitud de información y valorar la participación en el programa piloto. Legitimación: medidas precontractuales a petición del interesado (art. 6.1.b RGPD) e interés legítimo en contactos profesionales (art. 19 LOPDGDD). Detalles completos y derechos en nuestra <a href="/politica-privacidad" class="privacy-link">Política de Privacidad</a>.
                </p>
              </div>

              <div class="form-btn-wrap">
                <button type="submit" class="cta-button btn-submit-pilot" id="btn-submit-pilot">
                  <span id="btn-pilot-text">Solicitar participación en el piloto</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow-icon" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
              </div>
            </form>

            <div id="feedback-note" class="feedback-notification hidden" role="status"></div>

            <p class="form-disclaimer">
              Sin compromiso. Evaluaremos contigo el encaje operativo en tus instalaciones.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- ==============================================
         BLOQUE 2: METODOLOGÍA PRÁCTICA EN 3 PASOS
         ============================================== -->
    <div class="pilot-methodology-section" data-reveal="editorial">
      <div class="methodology-header">
        <div class="eyebrow-wrap">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span class="eyebrow-text">METODOLOGÍA PRÁCTICA</span>
        </div>
        <h3 class="methodology-title">
          Cómo planteamos el piloto con tu equipo
        </h3>
        <p class="methodology-sub">
          Un proceso estructurado, discreto y sin fricción para no interrumpir la operativa habitual de tus muelles de carga.
        </p>
      </div>

      <div class="steps-grid" role="list" aria-label="Fases del piloto operativo">
        <!-- Paso 01 -->
        <article class="step-card group" role="listitem" data-reveal="card" data-reveal-delay="1">
          <div class="step-top-content">
            <div class="step-card-header">
              <span class="step-num">01</span>
              <div class="step-icon-box" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                  <line x1="12" y1="18" x2="12.01" y2="18"></line>
                  <path d="M12 6v6l3-3"></path>
                </svg>
              </div>
            </div>
            <h4 class="step-title">Conocemos tu operativa</h4>
            <p class="step-desc">
              Entendemos cómo gestionáis los albaranes, las cartas de porte, los datos del transporte y la documentación de las expediciones de cada salida.
            </p>
          </div>
          <div class="step-footer">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-icon-green" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>Sesión de 30 min sin compromiso</span>
          </div>
        </article>

        <!-- Paso 02 -->
        <article class="step-card group" role="listitem" data-reveal="card" data-reveal-delay="2">
          <div class="step-top-content">
            <div class="step-card-header">
              <span class="step-num">02</span>
              <div class="step-icon-box" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="20" x2="18" y2="10"></line>
                  <line x1="12" y1="20" x2="12" y2="4"></line>
                  <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
              </div>
            </div>
            <h4 class="step-title">Analizamos el encaje</h4>
            <p class="step-desc">
              Identificamos los puntos en los que DECA Light podría aportar valor y qué aspectos específicos sería necesario comprobar durante el piloto.
            </p>
          </div>
          <div class="step-footer">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-icon-green" aria-hidden="true">
              <line x1="4" y1="21" x2="4" y2="14"></line>
              <line x1="4" y1="10" x2="4" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12" y2="3"></line>
              <line x1="20" y1="21" x2="20" y2="16"></line>
              <line x1="20" y1="12" x2="20" y2="3"></line>
              <line x1="1" y1="14" x2="7" y2="14"></line>
              <line x1="9" y1="8" x2="15" y2="8"></line>
              <line x1="17" y1="16" x2="23" y2="16"></line>
            </svg>
            <span>Detección de cuellos de botella</span>
          </div>
        </article>

        <!-- Paso 03 -->
        <article class="step-card group" role="listitem" data-reveal="card" data-reveal-delay="3">
          <div class="step-top-content">
            <div class="step-card-header">
              <span class="step-num">03</span>
              <div class="step-icon-box" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
                  <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
                  <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
                  <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
                </svg>
              </div>
            </div>
            <h4 class="step-title">Exploramos los siguientes pasos</h4>
            <p class="step-desc">
              Concretamos una posible colaboración y las necesidades de la empresa antes de acordar cómo avanzar con el grupo piloto.
            </p>
          </div>
          <div class="step-footer">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-icon-green" aria-hidden="true">
              <path d="m11 17 2 2a1 1 0 0 0 1.42 0l4.58-4.58a1 1 0 0 0 0-1.42l-2-2"></path>
              <path d="m3 11 4.58-4.58a1 1 0 0 1 1.42 0l2 2a1 1 0 0 1 0 1.42L6.42 14.42a1 1 0 0 1-1.42 0l-2-2a1 1 0 0 1 0-1.42z"></path>
            </svg>
            <span>Alineación técnica y operativa</span>
          </div>
        </article>
      </div>
    </div>

    <!-- ==============================================
         BLOQUE 3: PERFIL DE EMPRESA (QUIÉN ENCAJA)
         ============================================== -->
    <div class="pilot-profile-section" data-reveal="card">
      <div class="profile-card-container">
        <div class="profile-intro">
