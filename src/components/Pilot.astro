<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('pilot-interest-form') as HTMLFormElement | null;
    const feedback = document.getElementById('feedback-note');
    const submitBtn = document.getElementById('btn-submit-pilot') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-pilot-text');
    const idempotencyInput = document.getElementById('pilot-idempotency-key') as HTMLInputElement | null;

    // Generar o refrescar la clave de idempotencia única para esta sesión de formulario
    const refreshIdempotencyKey = () => {
      if (idempotencyInput) {
        idempotencyInput.value = typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : 'idemp-' + Date.now() + '-' + Math.random().toString(36).slice(2);
      }
    };
    refreshIdempotencyKey();

    if (form && feedback) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // 1. Validación básica HTML5 en el navegador
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const endpoint = form.getAttribute('data-endpoint') || form.getAttribute('action') || '/api/pilot';

        // 2. Comprobar que existe un endpoint definido
        if (!endpoint || endpoint === '#' || endpoint.trim() === '') {
          feedback.className = 'feedback-notification is-unconfigured';
          feedback.textContent = 'Canal en preparación técnica: La recepción telemática directa se encuentra en fase de configuración técnica para el lanzamiento. Tus datos se han conservado en el formulario. Para enviar tu solicitud de inmediato, por favor contacta directamente con el equipo promotor.';
          feedback.classList.remove('hidden');
          feedback.setAttribute('tabindex', '-1');
          feedback.focus();
          return;
        }

        // 3. Activar estado de carga y deshabilitar botón para evitar pulsaciones duplicadas
        const originalBtnText = btnText ? btnText.textContent : 'Solicitar participación en el piloto';
        if (submitBtn) {
          submitBtn.disabled = true;
          if (btnText) btnText.textContent = 'Enviando solicitud...';
        }

        try {
          const formData = new FormData(form);
          const response = await fetch(endpoint, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          let responseData: { message?: string; error?: string } = {};
          try {
            responseData = await response.json();
          } catch {
            // Respuesta no-JSON
          }

          if (response.ok) {
            feedback.className = 'feedback-notification is-success';
            feedback.textContent = responseData.message || '¡Solicitud recibida con éxito! Nos pondremos en contacto contigo para evaluar el encaje operativo de DECA Light en tu almacén.';
            feedback.classList.remove('hidden');
            feedback.setAttribute('tabindex', '-1');
            feedback.focus();
            form.reset();
            refreshIdempotencyKey(); // Clave nueva para solicitudes legítimas posteriores
          } else {
            feedback.className = 'feedback-notification is-error';
            feedback.textContent = responseData.message || 'No se ha podido procesar el envío (respuesta del servidor no satisfactoria). Por favor, inténtalo de nuevo o contacta a través de nuestro correo oficial. Los datos no se han borrado.';
            feedback.classList.remove('hidden');
            feedback.setAttribute('tabindex', '-1');
            feedback.focus();
          }
        } catch (err) {
          feedback.className = 'feedback-notification is-error';
          feedback.textContent = 'Error de conexión al enviar la solicitud. Revisa tu conexión a internet o contacta con el equipo. Los datos permanecen en el formulario.';
          feedback.classList.remove('hidden');
          feedback.setAttribute('tabindex', '-1');
          feedback.focus();
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            if (btnText && originalBtnText) btnText.textContent = originalBtnText;
          }
        }
      });
    }

    // Efecto sutil de elevación en foco de inputs
    const inputs = document.querySelectorAll<HTMLInputElement>('.form-text-input');
    inputs.forEach((input) => {
      input.addEventListener('focus', () => {
        input.parentElement?.classList.add('input-focused');
      });
      input.addEventListener('blur', () => {
        input.parentElement?.classList.remove('input-focused');
      });
    });
  });
</script>

