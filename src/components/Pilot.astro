---
// src/components/Pilot.astro - Sección 04 «Programa piloto» de DECA Light
// Reconstrucción visual de alta fidelidad basada en Google Stitch y la referencia aprobada
import PilotIntro from './PilotIntro.astro';
import PilotSteps from './PilotSteps.astro';
import PilotProfile from './PilotProfile.astro';
import PilotCta from './PilotCta.astro';
---

<section id="piloto" class="pilot-section" aria-labelledby="pilot-heading">
  <!-- Ancla secundaria de compatibilidad -->
  <div id="programa-piloto" class="anchor-target" aria-hidden="true"></div>

  <!-- Luces ambientales sutiles de fondo -->
  <div class="ambient-glow glow-top" aria-hidden="true"></div>
  <div class="ambient-glow glow-mid" aria-hidden="true"></div>
  <div class="ambient-glow glow-bottom" aria-hidden="true"></div>

  <div class="pilot-container">
    <PilotIntro />
    <PilotSteps />
    <PilotProfile />
    <PilotCta />
  </div>
</section>

<!-- ==============================================
     INTERACCIÓN Y FEEDBACK ILUSTRATIVO
     ============================================== -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('pilot-interest-form') as HTMLFormElement | null;
    const feedback = document.getElementById('feedback-note');
    const submitBtn = document.getElementById('btn-submit-pilot') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-pilot-text');
    const idempotencyInput = document.getElementById('pilot-idempotency-key') as HTMLInputElement | null;

    // Generar o refrescar la clave de idempotencia única para esta sesión de formulario
    const refreshIdempotencyKey = () => {
      if (idempotencyInput) {
        idempotencyInput.value = typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : 'idemp-' + Date.now() + '-' + Math.random().toString(36).slice(2);
      }
    };
    refreshIdempotencyKey();

    if (form && feedback) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // 1. Validación básica HTML5 en el navegador
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const endpoint = form.getAttribute('data-endpoint') || form.getAttribute('action') || '/api/pilot';

        // 2. Comprobar que existe un endpoint definido
        if (!endpoint || endpoint === '#' || endpoint.trim() === '') {
          feedback.className = 'feedback-notification is-unconfigured';
          feedback.textContent = 'No hemos podido enviar tu solicitud desde el formulario. Tus datos se han conservado. Escríbenos a contacto@decalight.es y te responderemos enseguida.';
          feedback.classList.remove('hidden');
          feedback.setAttribute('tabindex', '-1');
          feedback.focus();
          return;
        }

        // 3. Activar estado de carga y deshabilitar botón para evitar pulsaciones duplicadas
        const originalBtnText = btnText ? btnText.textContent : 'Solicitar demostración';
        if (submitBtn) {
          submitBtn.disabled = true;
          if (btnText) btnText.textContent = 'Enviando solicitud...';
        }

        try {
          const formData = new FormData(form);
          const response = await fetch(endpoint, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          let responseData: { message?: string; error?: string } = {};
          try {
            responseData = await response.json();
          } catch {
            // Respuesta no-JSON
          }

          if (response.ok) {
            feedback.className = 'feedback-notification is-success';
            feedback.textContent = responseData.message || '¡Solicitud recibida! Te contactaremos para organizar la demostración de DECA Light.';
            feedback.classList.remove('hidden');
            feedback.setAttribute('tabindex', '-1');
            feedback.focus();
            form.reset();
            refreshIdempotencyKey(); // Clave nueva para solicitudes legítimas posteriores
          } else {
            feedback.className = 'feedback-notification is-error';
            feedback.textContent = responseData.message || 'No se ha podido procesar el envío (respuesta del servidor no satisfactoria). Por favor, inténtalo de nuevo o contacta a través de nuestro correo oficial. Los datos no se han borrado.';
            feedback.classList.remove('hidden');
            feedback.setAttribute('tabindex', '-1');
            feedback.focus();
          }
        } catch (err) {
          feedback.className = 'feedback-notification is-error';
          feedback.textContent = 'Error de conexión al enviar la solicitud. Revisa tu conexión a internet o contacta con el equipo. Los datos permanecen en el formulario.';
          feedback.classList.remove('hidden');
          feedback.setAttribute('tabindex', '-1');
          feedback.focus();
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            if (btnText && originalBtnText) btnText.textContent = originalBtnText;
          }
        }
      });
    }

    // Efecto sutil de elevación en foco de inputs
    const inputs = document.querySelectorAll<HTMLInputElement>('.form-text-input');
    inputs.forEach((input) => {
      input.addEventListener('focus', () => {
        input.parentElement?.classList.add('input-focused');
      });
      input.addEventListener('blur', () => {
        input.parentElement?.classList.remove('input-focused');
      });
    });
  });
</script>

<style>
  .pilot-section {
      position: relative;
      width: 100%;
      max-width: 100vw;
      padding: 3.5rem 1.5rem 5rem;
      background-color: transparent;
      overflow: hidden;
    }
  .anchor-target {
      position: absolute;
      top: -80px;
      left: 0;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }
  .ambient-glow {
      position: absolute;
      border-radius: 9999px;
      filter: blur(80px);
      pointer-events: none;
      z-index: 0;
      max-width: 100%;
    }
  .glow-top {
      top: -6rem;
      left: 15%;
      width: 24rem;
      height: 24rem;
      background: rgba(167, 243, 208, 0.22);
    }
  .glow-mid {
      top: 45%;
      right: 0;
      width: 24rem;
      height: 24rem;
      background: rgba(254, 243, 199, 0.22);
    }
  .glow-bottom {
      bottom: -6rem;
      left: 2.5rem;
      width: 20rem;
      height: 20rem;
      background: rgba(204, 251, 241, 0.22);
    }
  .pilot-container {
      position: relative;
      z-index: 1;
      max-width: 80rem; 
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 4.5rem;
    }
  @media (prefers-reduced-motion: reduce) {
    *, ::before, ::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
          scroll-behavior: auto !important;
        }
  }
</style>
