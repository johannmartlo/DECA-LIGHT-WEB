    margin-top: 0.125rem;
  }

  .check-pill {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    background-color: #08543E;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 2px rgba(8, 84, 62, 0.2);
  }

  .micro-node-transport {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: stretch;
  }

  .transport-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .transport-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.6875rem;
    color: #475569;
    padding-top: 0.25rem;
    border-top: 1px dashed #F1F5F9;
  }

  .transport-val {
    font-family: var(--font-mono, monospace);
    color: #94A3B8;
  }

  /* Pulso Ámbar */
  @keyframes amberPulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(217, 119, 6, 0.25);
    }
    50% {
      opacity: 0.85;
      transform: scale(0.97);
      box-shadow: 0 0 0 4px rgba(217, 119, 6, 0);
    }
  }

  .badge-amber-pulse {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.625rem;
    font-weight: 700;
    background-color: #FEF3C7;
    color: #92400E;
    border: 1px solid #FCD34D;
    animation: amberPulse 2.8s ease-in-out infinite;
  }

  /* --------------------------------------------------------------------------
     NIVEL MEDIO: ABANICO DOCUMENTAL FÍSICO
     -------------------------------------------------------------------------- */
  .fanned-stack-area {
    position: relative;
    margin: 1.5rem 0;
    padding: 1.5rem 0 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* Conector Animado */
  .flow-connector-svg {
    position: absolute;
    inset-inline: 0;
    top: 0.25rem;
    width: 100%;
    height: 3.5rem;
    overflow: visible;
    pointer-events: none;
    display: none;
  }

  @media (min-width: 640px) {
    .flow-connector-svg {
      display: block;
    }
  }

  @keyframes flowDash {
    to {
      stroke-dashoffset: -20;
    }
  }

  .flow-dash-anim {
    stroke-dasharray: 6 6;
    animation: flowDash 1.2s linear infinite;
    opacity: 0.6;
  }

  /* Document Stack Centerpiece con abanico protuberante */
  .doc-stack-wrapper {
    position: relative;
    width: 100%;
    max-width: 26rem;
    height: 9.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .doc-stack-item {
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
    will-change: transform;
  }

  /* Hoja Trasera (CMR) */
  .doc-sheet-back {
    position: absolute;
    width: 14rem;
    height: 6.75rem;
    background-color: rgba(255, 255, 255, 0.94);
    border: 1px solid #E2E8F0;
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.07);
    transform: rotate(-8deg) translate(-3.25rem, -0.625rem);
    padding: 0.625rem 0.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
    font-size: 0.5625rem;
    color: #94A3B8;
  }

  /* Hoja Media (Carta de Porte) */
  .doc-sheet-mid {
    position: absolute;
    width: 14rem;
    height: 6.75rem;
    background-color: rgba(255, 255, 255, 0.96);
    border: 1px solid #E2E8F0;
    border-radius: 0.75rem;
    box-shadow: 0 8px 12px -2px rgba(15, 23, 42, 0.07);
    transform: rotate(6deg) translate(3.25rem, 0.375rem);
    padding: 0.625rem 0.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
    font-size: 0.5625rem;
    color: #94A3B8;
  }

  /* Hoja Frontal (DECA Light) */
  .doc-sheet-front {
    position: relative;
    z-index: 10;
    width: 15rem;
    height: 7.75rem;
    background-color: #FFFFFF;
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 0.75rem;
    box-shadow: 0 16px 28px -4px rgba(8, 84, 62, 0.12), 0 4px 8px -2px rgba(15, 23, 42, 0.04);
    padding: 0.75rem 0.875rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Hover Abanico Dinámico */
  .group-docs:hover .doc-sheet-back {
    transform: rotate(-11deg) translate(-4rem, -0.875rem);
  }
  .group-docs:hover .doc-sheet-mid {
    transform: rotate(8.5deg) translate(4rem, 0.5rem);
  }
  .group-docs:hover .doc-sheet-front {
    transform: translateY(-3px) scale(1.02);
  }

  @media (max-width: 480px) {
    .doc-sheet-back {
      width: 11.5rem;
      transform: rotate(-6deg) translate(-2rem, -0.5rem);
    }
    .doc-sheet-mid {
      width: 11.5rem;
      transform: rotate(5deg) translate(2rem, 0.25rem);
    }
    .doc-sheet-front {
      width: 13rem;
    }
    .group-docs:hover .doc-sheet-back {
      transform: rotate(-8deg) translate(-2.5rem, -0.625rem);
    }
    .group-docs:hover .doc-sheet-mid {
      transform: rotate(6.5deg) translate(2.5rem, 0.375rem);
    }
  }

  .sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .sheet-title {
    font-weight: 700;
    color: #475569;
  }

  .sheet-num {
    color: #94A3B8;
  }

  .sheet-lines {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sheet-line {
    height: 0.375rem;
    background-color: #E2E8F0;
    border-radius: 9999px;
  }

  .line-75 { width: 75%; }
  .line-50 { width: 50%; }
  .line-80 { width: 80%; }
  .line-65 { width: 65%; }

  .sheet-foot {
    font-size: 0.5625rem;
    color: #94A3B8;
  }

  .brand-inline {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8125rem;
  }

  .brand-bold {
    font-weight: 800;
    color: #0F172A;
  }

  .brand-light {
    font-weight: 600;
    color: #08543E;
  }

  .sheet-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    background-color: #ECFDF5;
    color: #08543E;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .sheet-lead {
    font-size: 0.6875rem;
    font-weight: 600;
    color: #334155;
  }

  .sheet-status {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.25rem;
    font-size: 0.625rem;
    color: #64748B;
  }

  .pulse-dot-green {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background-color: #10B981;
    animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .progress-track {
    width: 100%;
    height: 0.375rem;
    background-color: #F1F5F9;
    border-radius: 9999px;
    overflow: hidden;
  }

  @keyframes shimmerBar {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .progress-fill {
    height: 100%;
    width: 82%;
    border-radius: 9999px;
  }

  .shimmer-active {
    background: linear-gradient(90deg, #08543E 0%, #10B981 50%, #08543E 100%);
    background-size: 200% 100%;
    animation: shimmerBar 3.2s infinite linear;
  }

  /* Badge de Validación con Brillo (Badge Gleam) */
  .validation-pill {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #ECFDF5;
    border: 1px solid rgba(16, 185, 129, 0.35);
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    box-shadow: 0 1px 3px rgba(8, 84, 62, 0.08);
    font-size: 0.75rem;
    font-weight: 600;
    color: #064E3B;
  }

  .pill-icon-green {
    color: #08543E;
  }

  .badge-shimmer {
    position: relative;
    overflow: hidden;
  }

  .badge-shimmer::after {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
    transform: skewX(-20deg);
    animation: badgeGleam 4s infinite ease-in-out;
  }

  @keyframes badgeGleam {
    0%, 60% { left: -120%; }
    100% { left: 160%; }
  }

  /* --------------------------------------------------------------------------
     PARTE INFERIOR: FORMULARIO DEMO DE INTERÉS
     -------------------------------------------------------------------------- */
  .interest-form-card {
    position: relative;
    z-index: 10;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border: 1px solid #E2E8F0;
    border-radius: 1.25rem;
    padding: 1.25rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .form-card-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .mail-icon-box {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.75rem;
    background-color: #ECFDF5;
    color: #08543E;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .form-card-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: #0F172A;
    line-height: 1.25;
  }

  .form-card-sub {
    font-size: 0.75rem;
    color: #64748B;
    margin-top: 0.125rem;
  }

  .demo-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .inputs-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .inputs-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .input-field-wrap {
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease;
  }

  .input-field-wrap.input-focused {
    transform: scale(1.01);
  }

  .input-label {
    font-size: 0.6875rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 0.25rem;
  }

  .form-text-input {
    width: 100%;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    border-radius: 0.75rem;
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
    color: #0F172A;
    transition: all 0.2s ease;
  }

  .form-text-input:focus {
    background-color: #FFFFFF;
    outline: none;
    border-color: #08543E;
    box-shadow: 0 0 0 3px rgba(8, 84, 62, 0.12);
  }

  .form-btn-wrap {
    padding-top: 0.25rem;
  }

  /* Botón CTA con Sheen */
  .cta-button {
    position: relative;
    overflow: hidden;
  }

  .cta-button::after {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 50%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
    transform: skewX(-20deg);
    transition: left 0.65s ease;
    pointer-events: none;
  }

  .cta-button:hover::after {
    left: 170%;
  }

  .btn-submit-pilot {
    width: 100%;
    padding: 0.625rem 1rem;
    border-radius: 0.75rem;
    background-color: #08543E;
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    box-shadow: 0 1px 2px rgba(8, 84, 62, 0.2);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-submit-pilot:hover {
    background-color: #064231;
    box-shadow: 0 6px 12px -2px rgba(8, 84, 62, 0.25);
    transform: translateY(-1px);
  }

  .btn-submit-pilot:active {
    transform: scale(0.99);
  }

  .btn-arrow-icon {
    transition: transform 0.2s ease;
  }

  .btn-submit-pilot:hover .btn-arrow-icon {
    transform: translateX(3px);
  }

  .form-privacy-box {
    margin-top: 0.75rem;
    padding: 0.625rem 0.75rem;
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 0.5rem;
    text-align: left;
  }

  .privacy-box-text {
    font-size: 0.6875rem;
    color: #64748B;
    line-height: 1.45;
    margin: 0;
  }

  .privacy-box-text strong {
    color: #334155;
  }

  .privacy-link {
    color: #047857;
    text-decoration: underline;
    font-weight: 600;
  }

  .privacy-link:hover {
    color: #065F46;
  }

  .feedback-notification {
    margin-top: 0.75rem;
    padding: 0.75rem 0.875rem;
    background-color: #ECFDF5;
    border: 1px solid #A7F3D0;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #064E3B;
    text-align: left;
    line-height: 1.45;
    animation: fadeIn 0.3s ease;
  }

  .feedback-notification.is-unconfigured {
    background-color: #FEF3C7;
    border-color: #FCD34D;
    color: #92400E;
  }

  .feedback-notification.is-error {
    background-color: #FEE2E2;
    border-color: #FCA5A5;
    color: #991B1B;
  }

  .feedback-notification.is-success {
    background-color: #ECFDF5;
    border-color: #A7F3D0;
    color: #064E3B;
  }

  .hidden {
    display: none;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .form-disclaimer {
    font-size: 0.625rem;
    color: #94A3B8;
    text-align: center;
    margin-top: 0.625rem;
    line-height: 1.4;
