  /* Luces oscuras decorativas */
  .dark-glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(80px);
    pointer-events: none;
  }

  .glow-emerald {
    right: -4rem;
    bottom: -4rem;
    width: 24rem;
    height: 24rem;
    background: rgba(5, 150, 105, 0.22);
  }

  .glow-teal {
    left: -4rem;
