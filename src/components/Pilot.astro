---
// src/components/Pilot.astro - Sección de oferta y formulario (id="demo")
import PilotIntro from './PilotIntro.astro';
import PilotSteps from './PilotSteps.astro';
---

<section id="demo" class="pilot-section" aria-labelledby="pilot-heading">
  <div id="piloto" class="anchor-target" aria-hidden="true"></div>
  <div id="programa-piloto" class="anchor-target" aria-hidden="true"></div>

  <div class="pilot-container">
    <PilotIntro />
    <PilotSteps />
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('pilot-interest-form') as HTMLFormElement | null;
    const feedback = document.getElementById('feedback-note');
    const submitBtn = document.getElementById('btn-submit-pilot') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-pilot-text');
    const idempotencyInput = document.getElementById('pilot-idempotency-key') as HTMLInputElement | null;

    const refreshIdempotencyKey = () => {
      if (idempotencyInput) {
        idempotencyInput.value =
          typeof crypto !== 'undefined' && crypto.randomUUID
            ? crypto.randomUUID()
            : 'idemp-' + Date.now() + '-' + Math.random().toString(36).slice(2);
      }
    };
    refreshIdempotencyKey();

    if (form && feedback) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const endpoint = form.getAttribute('data-endpoint') || form.getAttribute('action') || '/api/pilot';

        if (!endpoint || endpoint === '#' || endpoint.trim() === '') {
          feedback.className = 'feedback-notification is-unconfigured';
          feedback.textContent =
            'No hemos podido enviar tu solicitud desde el formulario. Tus datos se han conservado. Escríbenos a contacto@decalight.es y te responderemos enseguida.';
          feedback.classList.remove('hidden');
          feedback.setAttribute('tabindex', '-1');
          feedback.focus();
          return;
        }

        const originalBtnText = btnText ? btnText.textContent : 'Pedir demostración';
        if (submitBtn) {
          submitBtn.disabled = true;
          if (btnText) btnText.textContent = 'Enviando solicitud...';
        }

        try {
          const formData = new FormData(form);
          const response = await fetch(endpoint, {
            method: 'POST',
            body: formData,
            headers: {
              Accept: 'application/json'
            }
          });

          let responseData: { message?: string; error?: string } = {};
          try {
            responseData = await response.json();
          } catch {
            // Respuesta no-JSON
          }

          if (response.ok) {
            feedback.className = 'feedback-notification is-success';
            feedback.textContent =
              responseData.message ||
              '¡Solicitud recibida! Te contactaremos para organizar la demostración de DECA Light.';
            feedback.classList.remove('hidden');
            feedback.setAttribute('tabindex', '-1');
            feedback.focus();
            form.reset();
            refreshIdempotencyKey();
          } else {
            feedback.className = 'feedback-notification is-error';
            feedback.textContent =
              responseData.message ||
              'No se ha podido procesar el envío. Por favor, inténtalo de nuevo o escríbenos a contacto@decalight.es.';
            feedback.classList.remove('hidden');
            feedback.setAttribute('tabindex', '-1');
            feedback.focus();
          }
        } catch {
          feedback.className = 'feedback-notification is-error';
          feedback.textContent =
            'Error de conexión al enviar la solicitud. Revisa tu conexión a internet o escríbenos a contacto@decalight.es.';
          feedback.classList.remove('hidden');
          feedback.setAttribute('tabindex', '-1');
          feedback.focus();
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            if (btnText && originalBtnText) btnText.textContent = originalBtnText;
          }
        }
      });
    }
  });
</script>

<style>
  .pilot-section {
    position: relative;
    width: 100%;
    padding-top: 5rem;
    padding-bottom: 5rem;
    background-color: var(--palette-white);
    border-bottom: 1px solid var(--color-border-subtle, var(--palette-slate-200));
    scroll-margin-top: 5rem;
  }

  .anchor-target {
    position: absolute;
    top: -80px;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .pilot-container {
    width: 100%;
    max-width: var(--container-max, 1340px);
    margin-inline: auto;
    padding-inline: var(--space-5, 1.25rem);
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .pilot-container {
      padding-inline: var(--space-8, 2rem);
    }
  }

  @media (min-width: 1024px) {
    .pilot-container {
      padding-inline: var(--space-10, 2.5rem);
    }
  }
</style>
