---
// src/components/Footer.astro - Footer Corporativo de DECA Light
---

<footer class="site-footer" aria-label="Pie de página corporativo">
  <div class="container footer-container">
    <div class="footer-top">
      <!-- Columna 1: Marca y lema -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-brand-link" aria-label="DECA Light - Inicio">
          <img
            src="/deca-light-logo-oscuro.svg"
            alt="DECA Light"
            class="footer-brand-logo"
            width="160"
            height="34"
          />
        </a>
        <p class="footer-desc">
          DECA Light · El DeCA de cada camión, en segundos.
        </p>
      </div>

      <!-- Columna 2: Producto -->
      <div class="footer-col">
        <h3 class="footer-col-title">Producto</h3>
        <ul class="footer-links">
          <li><a href="/#como-funciona" class="footer-link">Cómo funciona</a></li>
          <li><a href="/#que-incluye" class="footer-link">Qué incluye</a></li>
          <li><a href="/#normativa" class="footer-link">Normativa</a></li>
          <li><a href="/#preguntas" class="footer-link">Preguntas</a></li>
          <li><a href="/#demo" class="footer-link">Pedir demostración</a></li>
          <li><a href="/guia-deca" class="footer-link">Guía del DeCA</a></li>
        </ul>
      </div>

      <!-- Columna 3: Información Legal -->
      <div class="footer-col">
        <h3 class="footer-col-title">Legal</h3>
        <ul class="footer-links">
          <li><a href="/aviso-legal" class="footer-link">Aviso legal</a></li>
          <li><a href="/politica-privacidad" class="footer-link">Política de privacidad</a></li>
          <li><a href="/politica-cookies" class="footer-link">Política de cookies</a></li>
        </ul>
      </div>

      <!-- Columna 4: Contacto -->
      <div class="footer-col">
        <h3 class="footer-col-title">Contacto</h3>
        <div class="footer-contact-block">
          <a href="mailto:contacto@decalight.es" class="footer-contact-link">
            <span class="contact-icon-box" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </span>
            <span>contacto@decalight.es · Almería</span>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © 2026 DECA Light. Todos los derechos reservados.
      </p>
      <p class="footer-sector-tagline">
        contacto@decalight.es · Almería
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    background-color: #003B2A;
    color: var(--palette-white);
    padding-top: clamp(3.5rem, 6vw, 4.75rem);
    padding-bottom: clamp(2rem, 3.5vw, 2.75rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-container {
    max-width: var(--container-max, 1340px);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    margin-bottom: clamp(2.5rem, 4.5vw, 3.5rem);
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer-brand-link {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer-brand-logo {
    display: block;
    height: 34px;
    width: auto;
  }

  .footer-desc {
    font-size: 0.9375rem;
    color: var(--palette-deca-300);
    line-height: 1.6;
    max-width: 34ch;
    margin: 0;
  }

  .footer-col-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--palette-white);
    letter-spacing: 0.01em;
    margin-bottom: 1.125rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 0.875rem;
    color: var(--palette-deca-300);
    text-decoration: none;
    transition: color 150ms ease, transform 150ms ease;
  }

  .footer-link:hover {
    color: var(--palette-emerald-200);
    transform: translateX(2px);
    text-decoration: none;
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--palette-sky-400);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .footer-contact-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-contact-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--palette-deca-300);
    text-decoration: none;
    transition: color 150ms ease, transform 150ms ease;
  }

  .contact-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 8px;
    background-color: var(--palette-deca-950);
    color: var(--palette-emerald-400);
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .footer-contact-link:hover {
    color: var(--palette-white);
    transform: translateX(2px);
    text-decoration: none;
  }

  .footer-contact-link:hover .contact-icon-box {
    background-color: var(--palette-deca-850);
    transform: scale(1.05);
  }

  .footer-contact-link:focus-visible {
    outline: 2px solid var(--palette-sky-400);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8125rem;
    color: var(--palette-deca-300);
  }

  .copyright {
    margin: 0;
    font-weight: 600;
    color: var(--palette-slate-300);
  }

  .footer-sector-tagline {
    margin: 0;
    color: rgba(167, 243, 208, 0.9);
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .footer-top {
      grid-template-columns: 1.4fr 1fr;
      gap: 2.5rem 2rem;
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .footer-top {
      grid-template-columns: 2fr 1.1fr 1.1fr 1.3fr;
      gap: 3.5rem;
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link,
    .footer-contact-link,
    .contact-icon-box {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
