---
// src/components/FinalCta.astro - Bloque de Cierre Comercial de DECA Light
// Adaptación del diseño de Stitch a Astro nativo sin Tailwind CDN
---

<section class="final-cta-section" aria-labelledby="final-cta-heading">
  <!-- Resplandor ambiental suave -->
  <div class="ambient-glow" aria-hidden="true"></div>

  <div class="container final-cta-container">
    <div class="final-cta-card" data-reveal="card">
      <h2 id="final-cta-heading" class="final-cta-title">
        Tu próxima hora punta, con todos los DeCA listos.
      </h2>

      <p class="final-cta-subtitle">
        Primer mes gratis, con tus cargas reales y sin dejar lo que usas hoy.
      </p>

      <div class="final-cta-actions">
        <a href="#demo" class="btn-final-cta">
          <span>Pedir demostración</span>
          <svg class="btn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    width: 100%;
    padding-top: clamp(4rem, 7vw, 6.5rem);
    padding-bottom: clamp(4rem, 7vw, 6.5rem);
    background-color: var(--color-ink, #0a0f0d);
    background-image: radial-gradient(ellipse 680px 360px at 50% 45%, rgba(4, 120, 87, 0.22) 0%, rgba(17, 25, 21, 0.35) 55%, transparent 80%);
    color: var(--palette-white);
    border-bottom: 1px solid var(--color-ink-border, #1f2a25);
    overflow: hidden;
  }

  .ambient-glow {
    position: absolute;
    top: 35%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(640px, 90vw);
    height: 320px;
    background: radial-gradient(ellipse at center, rgba(52, 211, 153, 0.14) 0%, rgba(4, 120, 87, 0.06) 50%, transparent 70%);
    border-radius: 9999px;
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }

  .final-cta-container {
    position: relative;
    z-index: 10;
    max-width: 900px;
  }

  .final-cta-card {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Titular */
  .final-cta-title {
    font-size: clamp(1.875rem, 3.8vw, 2.75rem);
    font-weight: 700;
    color: var(--palette-white);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    max-width: 22ch;
  }

  /* Subtítulo */
  .final-cta-subtitle {
    font-size: clamp(1rem, 1.35vw, 1.125rem);
    color: var(--palette-slate-300);
    font-weight: 400;
    line-height: 1.65;
    max-width: 48ch;
    margin-bottom: 2.25rem;
  }

  /* Acciones */
  .final-cta-actions {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-final-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 320px;
    padding: 1rem 2rem;
    min-height: 52px;
    border-radius: 0.75rem;
    background-color: var(--color-brand-primary, #047857);
    color: var(--palette-white);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px -2px rgba(4, 120, 87, 0.4), 0 2px 4px rgba(0, 0, 0, 0.25);
    transition: background-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .btn-final-cta {
      width: auto;
      max-width: none;
    }
  }

  .btn-arrow {
    flex-shrink: 0;
    transition: transform 150ms ease;
  }

  .btn-final-cta:hover {
    background-color: var(--color-brand-hover, #065f46);
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px -4px rgba(4, 120, 87, 0.5);
  }

  .btn-final-cta:hover .btn-arrow {
    transform: translateX(4px);
  }

  .btn-final-cta:focus-visible {
    outline: 2px solid var(--palette-sky-600);
    outline-offset: 3px;
  }

  .btn-final-cta:active {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-final-cta,
    .btn-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
