---
// src/pages/guia/[slug].astro — Página de artículo de la Guía del DeCA (sin barra final)
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  return articulos.map((articulo) => ({
    params: { slug: articulo.data.slug },
    props: { articulo }
  }));
}

const { articulo } = Astro.props;
const { Content } = await render(articulo);

const formatDateES = (d: Date): string =>
  d.toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC'
  });

const datePublishedISO = articulo.data.date.toISOString().slice(0, 10);
const dateModifiedISO = articulo.data.updated.toISOString().slice(0, 10);
const canonicalURL = `https://www.decalight.es/guia/${articulo.data.slug}`;

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articulo.data.title,
  description: articulo.data.description,
  datePublished: datePublishedISO,
  dateModified: dateModifiedISO,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL
  },
  author: {
    '@type': 'Organization',
    name: 'DECA Light',
    url: 'https://www.decalight.es/'
  },
  publisher: {
    '@type': 'Organization',
    name: 'DECA Light',
    url: 'https://www.decalight.es/'
  }
};
---

<Layout
  title={articulo.data.seo_title}
  description={articulo.data.description}
  canonicalURL={canonicalURL}
  extraStructuredData={articleStructuredData}
>
  <article class="legal-page">
    <div class="container legal-container">
      <!-- Ruta de navegación: Inicio › Guía › artículo -->
      <nav class="legal-breadcrumb" aria-label="Ruta de navegación">
        <ol class="breadcrumb-list">
          <li><a href="/" class="breadcrumb-link">Inicio</a></li>
          <li aria-hidden="true" class="breadcrumb-sep">›</li>
          <li><a href="/guia" class="breadcrumb-link">Guía</a></li>
          <li aria-hidden="true" class="breadcrumb-sep">›</li>
          <li class="breadcrumb-current" aria-current="page">{articulo.data.title}</li>
        </ol>
      </nav>

      <header class="legal-header">
        <span class="section-kicker">GUÍA DEL DECA</span>
        <h1 class="legal-title">{articulo.data.title}</h1>
        <p class="legal-date">
          Actualizado el <time datetime={dateModifiedISO}>{formatDateES(articulo.data.updated)}</time>
        </p>
      </header>

      <div class="article-body">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .legal-page {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(4rem, 6vw, 6rem);
    background-color: var(--color-bg-canvas, var(--palette-slate-50));
  }

  .legal-container {
    max-width: 820px;
    margin-inline: auto;
  }

  .legal-breadcrumb {
    margin-bottom: var(--space-6, 1.5rem);
  }

  .breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary, var(--palette-slate-600));
  }

  .breadcrumb-link {
    color: var(--color-text-secondary, var(--palette-slate-600));
    text-decoration: none;
    font-weight: 500;
    transition: color 150ms ease;
  }

  .breadcrumb-link:hover {
    color: var(--color-brand-primary, var(--palette-emerald-700));
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: var(--palette-slate-400, #94A3B8);
  }

  .breadcrumb-current {
    color: var(--color-text-primary, var(--palette-slate-900));
    font-weight: 600;
  }

  .legal-header {
    margin-bottom: var(--space-8, 2rem);
    padding-bottom: var(--space-6, 1.5rem);
    border-bottom: 1px solid var(--color-border-subtle, var(--palette-slate-200));
  }

  .legal-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary, var(--palette-slate-900));
    line-height: 1.15;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .legal-date {
    font-size: 0.875rem;
    color: var(--color-text-muted, var(--palette-slate-500));
    margin: 0;
  }

  /* Estilos de lectura para el contenido Markdown */
  .article-body :global(h1) {
    display: none; /* Ya se muestra en el header de la página */
  }

  .article-body :global(h2) {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text-primary, var(--palette-slate-900));
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .article-body :global(p) {
    font-size: 1rem;
    color: var(--color-text-secondary, var(--palette-slate-600));
    line-height: 1.7;
    margin-bottom: 1.1rem;
  }

  .article-body :global(strong) {
    color: var(--color-text-primary, var(--palette-slate-900));
    font-weight: 600;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .article-body :global(li) {
    font-size: 1rem;
    color: var(--color-text-secondary, var(--palette-slate-600));
    line-height: 1.65;
  }

  .article-body :global(a) {
    color: var(--color-brand-primary, var(--palette-emerald-700));
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 500;
    transition: color 150ms ease;
  }

  .article-body :global(a:hover) {
    color: var(--color-brand-hover, var(--palette-emerald-800));
  }

  /* Tabla con estilo propio */
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0 1.75rem;
    background-color: var(--palette-white, #FFFFFF);
    border: 1px solid var(--color-border-subtle, var(--palette-slate-200));
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
    font-size: 0.9375rem;
  }

  .article-body :global(thead th) {
    background-color: var(--palette-emerald-50, #ECFDF5);
    color: var(--palette-emerald-900, #064E3B);
    font-weight: 700;
    text-align: left;
    padding: 0.875rem 1.1rem;
    border-bottom: 1px solid var(--palette-emerald-200, #A7F3D0);
  }

  .article-body :global(tbody td) {
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--palette-slate-100, #F1F5F9);
    color: var(--color-text-secondary, var(--palette-slate-600));
    line-height: 1.5;
    vertical-align: top;
  }

  .article-body :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  /* Botón de llamada a la acción «Pruébalo gratis un mes» */
  .article-body :global(a[href="/#demo"]) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    background-color: #047857;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 10px 24px -10px rgba(4, 120, 87, 0.6);
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .article-body :global(a[href="/#demo"]:hover) {
    background-color: #065F46;
    color: #FFFFFF;
    transform: translateY(-1px);
    text-decoration: none;
  }

  /* Separador y aviso final */
  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border-subtle, var(--palette-slate-200));
    margin: 2.25rem 0 1.5rem;
  }

  .article-body :global(hr + p) {
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background-color: var(--palette-white, #FFFFFF);
    border: 1px solid var(--color-border-subtle, var(--palette-slate-200));
    font-size: 0.875rem;
    color: var(--color-text-muted, var(--palette-slate-500));
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .article-body :global(table) {
      display: block;
      overflow-x: auto;
      font-size: 0.875rem;
    }

    .article-body :global(a[href="/#demo"]) {
      width: 100%;
    }
  }
</style>
