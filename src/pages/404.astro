---
// src/pages/404.astro - Página 404 personalizada de DECA Light
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada · DECA Light"
  description="Esta página no existe en DECA Light."
>
  <section class="not-found-section">
    <div class="container not-found-container">
      <div class="eyebrow-wrap">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span class="eyebrow-text">ERROR 404</span>
      </div>

      <h1 class="not-found-title">Esta página no existe.</h1>

      <div class="not-found-actions">
        <a href="/" class="btn-primary">Volver al inicio</a>
        <a href="/#demo" class="btn-secondary">Pedir demostración</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found-section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    background-color: var(--palette-white);
    border-bottom: 1px solid var(--color-border-subtle, var(--palette-slate-200));
  }

  .not-found-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .eyebrow-line {
    width: 1.5rem;
    height: 2px;
    background-color: var(--palette-deca-800);
    border-radius: 9999px;
  }

  .eyebrow-text {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--palette-deca-800);
  }

  .not-found-title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-primary, var(--palette-slate-900));
    margin: 0 0 2rem 0;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.375rem;
    border-radius: var(--radius-md, 6px);
    background-color: var(--color-brand-primary, var(--palette-emerald-700));
    color: var(--palette-white);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .btn-primary:hover {
    background-color: var(--color-brand-hover, var(--palette-emerald-800));
    color: var(--palette-white);
    text-decoration: none;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.375rem;
    border-radius: var(--radius-md, 6px);
    background-color: var(--palette-white);
    color: var(--color-text-primary, var(--palette-slate-900));
    border: 1px solid var(--color-border-strong, var(--palette-slate-300));
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .btn-secondary:hover {
    background-color: var(--color-bg-surface-subtle, var(--palette-slate-100));
    border-color: var(--palette-slate-400);
    text-decoration: none;
  }
</style>
