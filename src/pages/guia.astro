---
// src/pages/guia.astro — Índice de artículos de la Guía del DeCA (/guia)
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const articulos = (await getCollection('articulos')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const formatDateES = (d: Date): string =>
  d.toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC'
  });
---

<Layout
  title="Artículos sobre el DeCA electrónico · DECA Light"
  description="Guías prácticas sobre el documento de control administrativo electrónico (DeCA) para almacenes hortofrutícolas, cooperativas y transportistas."
  canonicalURL="https://www.decalight.es/guia"
>
  <div class="legal-page">
    <div class="container legal-container">
      <nav class="legal-breadcrumb" aria-label="Ruta de navegación">
        <a href="/" class="breadcrumb-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Volver al inicio</span>
        </a>
      </nav>

      <header class="legal-header">
        <span class="section-kicker">ARTÍCULOS Y GUÍAS</span>
        <h1 class="legal-title">Guía práctica del DeCA</h1>
        <p class="legal-subtitle">
          Normativa, responsabilidades y operativa diaria del documento de control electrónico en almacenes hortofrutícolas.
        </p>
      </header>

      <div class="articles-list">
        {articulos.map((art) => (
          <article class="article-card">
            <p class="article-date">
              <time datetime={art.data.date.toISOString().slice(0, 10)}>
                {formatDateES(art.data.date)}
              </time>
            </p>
            <h2 class="article-card-title">
              <a href={`/guia/${art.data.slug}`} class="article-card-link">
                {art.data.title}
              </a>
            </h2>
            <p class="article-card-desc">{art.data.description}</p>
            <a href={`/guia/${art.data.slug}`} class="article-read-more">
              Leer artículo →
            </a>
          </article>
        ))}
      </div>

      <div class="guide-banner">
        <div>
          <h2 class="guide-banner-title">¿Buscas el resumen completo de la normativa?</h2>
          <p class="guide-banner-desc">
            Consulta la Guía del DeCA con las fechas clave, el contenido obligatorio del PDF y los requisitos del QR.
          </p>
        </div>
        <a href="/guia-deca" class="guide-banner-link">Ver Guía del DeCA →</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .legal-page {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(4rem, 6vw, 6rem);
    background-color: var(--color-bg-canvas, var(--palette-slate-50));
  }

  .legal-container {
    max-width: 820px;
    margin-inline: auto;
  }

  .legal-breadcrumb {
    margin-bottom: var(--space-6, 1.5rem);
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary, var(--palette-slate-600));
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    color: var(--color-brand-primary, var(--palette-emerald-700));
    text-decoration: underline;
  }

  .legal-header {
    margin-bottom: var(--space-8, 2rem);
    padding-bottom: var(--space-6, 1.5rem);
    border-bottom: 1px solid var(--color-border-subtle, var(--palette-slate-200));
  }

  .legal-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary, var(--palette-slate-900));
    line-height: 1.18;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .legal-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary, var(--palette-slate-600));
    line-height: 1.6;
    margin: 0;
  }

  .articles-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .article-card {
    background-color: var(--palette-white, #FFFFFF);
    border: 1px solid var(--color-border-subtle, var(--palette-slate-200));
    border-radius: 20px;
    padding: 1.75rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .article-card:hover {
    border-color: var(--palette-emerald-300, #6EE7B7);
    box-shadow: 0 10px 24px -12px rgba(4, 120, 87, 0.16);
  }

  .article-date {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted, var(--palette-slate-500));
    margin: 0 0 0.5rem 0;
  }

  .article-card-title {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0 0 0.65rem 0;
  }

  .article-card-link {
    color: var(--color-text-primary, var(--palette-slate-900));
    text-decoration: none;
  }

  .article-card-link:hover {
    color: var(--color-brand-primary, var(--palette-emerald-700));
    text-decoration: none;
  }

  .article-card-desc {
    font-size: 0.96875rem;
    line-height: 1.6;
    color: var(--color-text-secondary, var(--palette-slate-600));
    margin: 0 0 1rem 0;
  }

  .article-read-more {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-brand-primary, var(--palette-emerald-700));
    text-decoration: none;
  }

  .article-read-more:hover {
    text-decoration: underline;
  }

  .guide-banner {
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: 18px;
    background-color: var(--palette-emerald-50, #ECFDF5);
    border: 1px solid var(--palette-emerald-200, #A7F3D0);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .guide-banner-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--palette-emerald-900, #064E3B);
    margin: 0 0 0.25rem 0;
  }

  .guide-banner-desc {
    font-size: 0.9rem;
    color: var(--palette-emerald-800, #065F46);
    margin: 0;
  }

  .guide-banner-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--palette-emerald-700, #047857);
    text-decoration: none;
    white-space: nowrap;
  }

  .guide-banner-link:hover {
    text-decoration: underline;
  }
</style>
